<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Vidocq :: Maven Plugin</name>
    <description>Build-time bean indexing and application packaging for Vidocq</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!-- Shared APT/build helper: Requirement model + descriptor parser + module-info
             satisfaction check, reused by the check-module-info / complete-module-info goals. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-codegen-commons</artifactId>
        </dependency>
        <!-- Dev-mode service SPI: the dev goal loads DevService providers (from the app's
             <plugin><dependencies>) via ServiceLoader on this plugin classpath. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devservices-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-maven-plugin</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- Maven Plugin API (provided by Maven at runtime) -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 4 must live in the plugin realm at RUNTIME: Testcontainers-based DevService
             providers reference org.junit.rules.TestRule (GenericContainer implements it), and the JVM
             resolves that interface when the container class loads. Declared on the plugin itself
             (not only on the providers) because a transitive of a <plugin><dependency> does not reliably
             reach the realm — Testcontainers marks junit optional, so the mediation drops it. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <!-- Explicit compile: a parent dependencyManagement pins junit:junit to test scope,
                 which would keep it out of the plugin realm. We need it at runtime. -->
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- Use @ delimiters so ${...} runtime expressions in plugin.xml are untouched;
                     only @project.version@ etc. are expanded at build time. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Skip maven-plugin-plugin descriptor generation (JDK 25 incompatible)
                 Hand-written plugin.xml is in src/main/resources/META-INF/maven/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.1</version>
                <configuration>
                    <skipErrorNoDescriptorsFound>true</skipErrorNoDescriptorsFound>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Integration tests of the goals on real Maven builds (src/it, one directory per build), run by
            maven-invoker-plugin against the packaged plugin and its hand-written descriptor.

            A profile, so that `mvn -o ... verify` keeps working on a machine whose local repository lacks
            the invoker plugin and its Groovy runtime. Active on any CI runner (Forgejo sets CI=true for
            every step) and on demand with -Pit. invoker:install stages the plugin and its dependencies in
            target/it-repo, never in the user's local repository; the inner builds copy anything else from
            the outer local repository (src/it/settings.xml).

            -DskipTests skips these builds as well as the unit tests; so does -Dinvoker.skip=true. The CI builds
            that pass -DskipTests, such as the nightly TCK job (`install -DskipTests`) and every lifecycle build
            of the Vidocq/ci release action, therefore run none of them. They still resolve maven-invoker-plugin
            and its Groovy runtime, which a CI runner downloads on first use.

            No fixture may be named *.run.xml: IntelliJ loads such files anywhere in the project content, so
            they would appear as run configurations of this repository. Seeds and expected contents are .txt
            files, copied into .run/ by prebuild.groovy.
        -->
        <profile>
            <id>it</id>
            <activation>
                <property>
                    <name>env.CI</name>
                </property>
            </activation>
            <properties>
                <!-- maven-invoker-plugin reads invoker.skip only (skipInstallation, skipInvocation); a
                     -Dinvoker.skip on the command line still wins over this default. -->
                <invoker.skip>${skipTests}</invoker.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <version>3.10.1</version>
                        <configuration>
                            <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                            <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                            <settingsFile>src/it/settings.xml</settingsFile>
                            <preBuildHookScript>prebuild</preBuildHookScript>
                            <postBuildHookScript>verify</postBuildHookScript>
                            <showErrors>true</showErrors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <goal>install</goal>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
