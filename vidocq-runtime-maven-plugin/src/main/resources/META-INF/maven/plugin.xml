<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <name>Vidocq :: Maven Plugin</name>
    <description>Build-time bean indexing and application packaging for Vidocq</description>
    <groupId>io.vidocq.runtime</groupId>
    <artifactId>vidocq-runtime-maven-plugin</artifactId>
    <version>@project.version@</version>
    <goalPrefix>vidocq</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>

    <mojos>
        <!-- vidocq:dev — M1 of DEBUGMODE.md (Approach A, fast process-restart).
             Blocking goal: watches src/, recompiles, respawns the child JVM. -->
        <mojo>
            <goal>dev</goal>
            <description>Vidocq dev mode: watch sources, recompile, restart child JVM (Approach A / M1)</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresDirectInvocation>true</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <implementation>io.vidocq.runtime.maven.dev.VidocqDevMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The Maven project</description></parameter>
                <parameter><name>mainModule</name><type>java.lang.String</type><required>true</required><editable>true</editable><description>Java module containing the main class (required — Vidocq runs on the module path)</description></parameter>
                <parameter><name>mainClass</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Fully-qualified main class. Optional if the module declares ModuleMainClass.</description></parameter>
                <parameter><name>watchDirs</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Comma-separated directories to watch, relative to the project base dir.</description></parameter>
                <parameter><name>debounceMillis</name><type>long</type><required>false</required><editable>true</editable><description>Debounce window in milliseconds; collapses bursts of editor saves into a single reload.</description></parameter>
                <parameter><name>gracePeriodMillis</name><type>long</type><required>false</required><editable>true</editable><description>Grace period given to the child JVM after SIGTERM before forceful kill.</description></parameter>
                <parameter><name>extraJvmArgs</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Extra JVM args passed verbatim to the child, split on whitespace.</description></parameter>
                <parameter><name>extraSystemProperties</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Comma-separated key=value system properties forwarded to the child as -Dkey=value.</description></parameter>
                <parameter><name>profile</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Profile string injected as -Dvidocq.profile in the child JVM.</description></parameter>
                <parameter><name>debug</name><type>boolean</type><required>false</required><editable>true</editable><description>Open a JDWP debug agent on the child JVM (default true in dev).</description></parameter>
                <parameter><name>debugPort</name><type>int</type><required>false</required><editable>true</editable><description>JDWP listen port for the debug agent (default 5005).</description></parameter>
                <parameter><name>debugSuspend</name><type>boolean</type><required>false</required><editable>true</editable><description>Suspend the child JVM until a debugger attaches (jdwp suspend=y).</description></parameter>
                <parameter><name>devServices</name><type>boolean</type><required>false</required><editable>true</editable><description>Provision dev-mode services (Postgres, Keycloak, …) discovered via the DevService SPI.</description></parameter>
                <parameter><name>classesDir</name><type>java.io.File</type><required>false</required><editable>false</editable><description>Compiled classes directory of the project.</description></parameter>
                <parameter><name>baseDir</name><type>java.io.File</type><required>false</required><editable>false</editable><description>Project base directory.</description></parameter>
                <parameter><name>buildDir</name><type>java.io.File</type><required>false</required><editable>false</editable><description>Build directory (hosts vidocq-patches/ for cross-module generated classes).</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <mainModule implementation="java.lang.String">${vidocq.mainModule}</mainModule>
                <mainClass implementation="java.lang.String">${vidocq.mainClass}</mainClass>
                <watchDirs implementation="java.lang.String" default-value="src/main/java,src/main/resources">${vidocq.dev.watchDirs}</watchDirs>
                <debounceMillis implementation="long" default-value="250">${vidocq.dev.debounceMillis}</debounceMillis>
                <gracePeriodMillis implementation="long" default-value="5000">${vidocq.dev.gracePeriodMillis}</gracePeriodMillis>
                <extraJvmArgs implementation="java.lang.String" default-value="">${vidocq.dev.jvmArgs}</extraJvmArgs>
                <extraSystemProperties implementation="java.lang.String" default-value="">${vidocq.dev.systemProperties}</extraSystemProperties>
                <profile implementation="java.lang.String" default-value="dev">${vidocq.profile}</profile>
                <debug implementation="boolean" default-value="true">${vidocq.dev.debug}</debug>
                <debugPort implementation="int" default-value="5005">${vidocq.dev.debugPort}</debugPort>
                <debugSuspend implementation="boolean" default-value="false">${vidocq.dev.debugSuspend}</debugSuspend>
                <devServices implementation="boolean" default-value="true">${vidocq.dev.devServices}</devServices>
                <classesDir implementation="java.io.File" default-value="${project.build.outputDirectory}"/>
                <baseDir implementation="java.io.File" default-value="${project.basedir}"/>
                <buildDir implementation="java.io.File" default-value="${project.build.directory}"/>
            </configuration>
        </mojo>

        <!-- vidocq:generate -->
        <mojo>
            <goal>generate</goal>
            <description>Generate CDI bean index for Vidocq application</description>
            <requiresDependencyResolution>compile</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>process-classes</phase>
            <implementation>io.vidocq.runtime.maven.VidocqGenerateMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>outputDirectory</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Project build output directory</description>
                </parameter>
                <parameter>
                    <name>scanDependencies</name>
                    <type>java.util.List</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Liste de patterns groupId:artifactId à scanner (wildcard final * supporté)</description>
                </parameter>
                <parameter>
                    <name>buildDirectory</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Project build directory (hosts vidocq-patches/ for cross-module generated classes)</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <outputDirectory implementation="java.io.File"
                                 default-value="${project.build.outputDirectory}"/>
                <scanDependencies implementation="java.util.List"/>
                <buildDirectory implementation="java.io.File"
                                default-value="${project.build.directory}"/>
            </configuration>
        </mojo>

        <!-- vidocq:package -->
        <mojo>
            <goal>package</goal>
            <description>Package Vidocq application as standalone distribution ZIP</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>package</phase>
            <implementation>io.vidocq.runtime.maven.VidocqPackageMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>mainClass</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Main class to launch</description>
                </parameter>
                <parameter>
                    <name>scriptName</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Launch script base name</description>
                </parameter>
                <parameter>
                    <name>jvmArgs</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Additional JVM arguments</description>
                </parameter>
                <parameter>
                    <name>distName</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Distribution directory name</description>
                </parameter>
                <parameter>
                    <name>buildDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Build output directory</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <mainClass implementation="java.lang.String"
                           default-value="io.vidocq.runtime.core.Vidocq">${vidocq.mainClass}</mainClass>
                <scriptName implementation="java.lang.String"
                            default-value="${project.artifactId}">${vidocq.scriptName}</scriptName>
                <jvmArgs implementation="java.lang.String"
                         default-value="">${vidocq.jvmArgs}</jvmArgs>
                <distName implementation="java.lang.String"
                          default-value="${project.artifactId}-${project.version}">${vidocq.distName}</distName>
                <buildDir implementation="java.io.File"
                          default-value="${project.build.directory}"/>
            </configuration>
        </mojo>

        <!-- vidocq:jlink -->
        <mojo>
            <goal>jlink</goal>
            <description>Package application as a self-contained jlink runtime image</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>package</phase>
            <implementation>io.vidocq.runtime.maven.VidocqJlinkMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>mainModule</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Java module containing the main class</description>
                </parameter>
                <parameter>
                    <name>mainClass</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Fully qualified main class</description>
                </parameter>
                <parameter>
                    <name>launcher</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Launcher script base name</description>
                </parameter>
                <parameter>
                    <name>distDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>jlink output directory</description>
                </parameter>
                <parameter>
                    <name>modsDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Module staging directory</description>
                </parameter>
                <parameter>
                    <name>buildDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Build output directory</description>
                </parameter>
                <parameter>
                    <name>classesDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Compiled classes directory</description>
                </parameter>
                <parameter>
                    <name>stripDebug</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Strip debug info from modules</description>
                </parameter>
                <parameter>
                    <name>compress</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>jlink compress level (zip-0 to zip-9)</description>
                </parameter>
                <parameter>
                    <name>includeResources</name>
                    <type>java.util.List</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Non-modular resources to copy under dist/conf/</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip jlink execution entirely (useful in CI to bypass automatic-modules issues)</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <mainModule implementation="java.lang.String">${vidocq.mainModule}</mainModule>
                <mainClass implementation="java.lang.String">${vidocq.mainClass}</mainClass>
                <launcher implementation="java.lang.String"
                          default-value="${project.artifactId}">${vidocq.launcher}</launcher>
                <distDir implementation="java.io.File"
                         default-value="${project.build.directory}/dist">${vidocq.distDir}</distDir>
                <modsDir implementation="java.io.File"
                         default-value="${project.build.directory}/jlink-mods"/>
                <buildDir implementation="java.io.File"
                          default-value="${project.build.directory}"/>
                <classesDir implementation="java.io.File"
                            default-value="${project.build.outputDirectory}"/>
                <stripDebug implementation="boolean"
                            default-value="true">${vidocq.stripDebug}</stripDebug>
                <compress implementation="java.lang.String"
                          default-value="zip-6">${vidocq.compress}</compress>
                <includeResources implementation="java.util.List"/>
                <skip implementation="boolean"
                      default-value="false">${vidocq.jlink.skip}</skip>
            </configuration>
        </mojo>

        <!-- vidocq:jpackage -->
        <mojo>
            <goal>jpackage</goal>
            <description>Package a jlink runtime image as a native installer (.dmg/.deb/.msi/...) or app-image</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>package</phase>
            <implementation>io.vidocq.runtime.maven.VidocqJpackageMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required><editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter><name>mainModule</name><type>java.lang.String</type><required>true</required><editable>true</editable><description>Java module containing the main class</description></parameter>
                <parameter><name>mainClass</name><type>java.lang.String</type><required>true</required><editable>true</editable><description>Fully qualified main class</description></parameter>
                <parameter><name>appName</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Application name</description></parameter>
                <parameter><name>appVersion</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Application version</description></parameter>
                <parameter><name>type</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>jpackage type: app-image, dmg, pkg, deb, rpm, msi, exe</description></parameter>
                <parameter><name>runtimeImage</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Existing jlink runtime image</description></parameter>
                <parameter><name>installerDir</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Output directory</description></parameter>
                <parameter><name>icon</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Optional icon (.icns/.ico/.png)</description></parameter>
                <parameter><name>vendor</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Vendor metadata</description></parameter>
                <parameter><name>description</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Short description</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <mainModule implementation="java.lang.String">${vidocq.mainModule}</mainModule>
                <mainClass implementation="java.lang.String">${vidocq.mainClass}</mainClass>
                <appName implementation="java.lang.String" default-value="${project.artifactId}">${vidocq.appName}</appName>
                <appVersion implementation="java.lang.String" default-value="${project.version}">${vidocq.appVersion}</appVersion>
                <type implementation="java.lang.String" default-value="app-image">${vidocq.jpackageType}</type>
                <runtimeImage implementation="java.io.File" default-value="${project.build.directory}/dist">${vidocq.runtimeImage}</runtimeImage>
                <installerDir implementation="java.io.File" default-value="${project.build.directory}/installer">${vidocq.installerDir}</installerDir>
                <icon implementation="java.io.File">${vidocq.icon}</icon>
                <vendor implementation="java.lang.String" default-value="${project.groupId}">${vidocq.vendor}</vendor>
                <description implementation="java.lang.String" default-value="${project.description}">${vidocq.appDescription}</description>
            </configuration>
        </mojo>

        <!-- vidocq:docker -->
        <mojo>
            <goal>docker</goal>
            <description>Generate a Dockerfile that wraps the jlink runtime image into a minimal container</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>package</phase>
            <implementation>io.vidocq.runtime.maven.VidocqDockerMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required><editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter><name>runtimeImage</name><type>java.io.File</type><required>false</required><editable>true</editable><description>Existing jlink runtime image</description></parameter>
                <parameter><name>baseImage</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Docker base image</description></parameter>
                <parameter><name>imageTag</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Generated image tag</description></parameter>
                <parameter><name>exposedPort</name><type>int</type><required>false</required><editable>true</editable><description>Exposed HTTP port</description></parameter>
                <parameter><name>launcher</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>Launcher script name in dist/bin/</description></parameter>
                <parameter><name>build</name><type>boolean</type><required>false</required><editable>true</editable><description>Run docker build after generating Dockerfile</description></parameter>
                <parameter><name>buildDir</name><type>java.io.File</type><required>false</required><editable>false</editable><description>Build output directory</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <runtimeImage implementation="java.io.File" default-value="${project.build.directory}/dist">${vidocq.runtimeImage}</runtimeImage>
                <baseImage implementation="java.lang.String" default-value="gcr.io/distroless/base-debian12:nonroot">${vidocq.docker.baseImage}</baseImage>
                <imageTag implementation="java.lang.String" default-value="${project.artifactId}:${project.version}">${vidocq.docker.imageTag}</imageTag>
                <exposedPort implementation="int" default-value="8080">${vidocq.docker.exposedPort}</exposedPort>
                <launcher implementation="java.lang.String" default-value="${project.artifactId}">${vidocq.launcher}</launcher>
                <build implementation="boolean" default-value="false">${vidocq.docker.build}</build>
                <buildDir implementation="java.io.File" default-value="${project.build.directory}"/>
            </configuration>
        </mojo>

        <!-- vidocq:checkpom -->
        <mojo>
            <goal>checkpom</goal>
            <description>Verify that every vidocq-runtime-*-extension declared as a dependency is paired with its companion *-extension-codegen bundle in maven-compiler-plugin/annotationProcessorPaths (and vice versa), and that their versions match.</description>
            <requiresDependencyResolution>none</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>validate</phase>
            <implementation>io.vidocq.runtime.maven.VidocqCheckPomMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The Maven project</description></parameter>
                <parameter><name>skip</name><type>boolean</type><required>false</required><editable>true</editable><description>Skip the check entirely</description></parameter>
                <parameter><name>failOnMissing</name><type>boolean</type><required>false</required><editable>true</editable><description>Fail the build (true) or just warn (false) when an issue is detected</description></parameter>
                <parameter><name>repoSession</name><type>org.eclipse.aether.RepositorySystemSession</type><required>true</required><editable>false</editable><description>Aether repository session</description></parameter>
                <parameter><name>remoteRepos</name><type>java.util.List</type><required>false</required><editable>false</editable><description>Remote project repositories</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <skip implementation="boolean" default-value="false">${vidocq.checkpom.skip}</skip>
                <failOnMissing implementation="boolean" default-value="true">${vidocq.checkpom.failOnMissing}</failOnMissing>
                <repoSession implementation="org.eclipse.aether.RepositorySystemSession" default-value="${repositorySystemSession}"/>
                <remoteRepos implementation="java.util.List" default-value="${project.remoteProjectRepositories}"/>
            </configuration>
            <requirements>
                <requirement>
                    <role>org.eclipse.aether.RepositorySystem</role>
                    <field-name>repoSystem</field-name>
                </requirement>
            </requirements>
        </mojo>

        <!-- vidocq:check-module-info -->
        <mojo>
            <goal>check-module-info</goal>
            <description>Verify the application module-info.java declares the JPMS directives (requires/opens) its Vidocq extensions need at runtime, unioned from each extension's META-INF/vidocq/module-requirements.properties descriptor and checked against the compiled module-info.class. Fails with the exact, copy-pasteable fix when one is missing.</description>
            <requiresDependencyResolution>compile</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <phase>process-classes</phase>
            <implementation>io.vidocq.runtime.maven.VidocqCheckModuleInfoMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The Maven project</description></parameter>
                <parameter><name>outputDirectory</name><type>java.io.File</type><required>false</required><editable>false</editable><description>The compiled-classes output directory (holds module-info.class)</description></parameter>
                <parameter><name>skip</name><type>boolean</type><required>false</required><editable>true</editable><description>Skip the check entirely</description></parameter>
                <parameter><name>failOnMissing</name><type>boolean</type><required>false</required><editable>true</editable><description>Fail the build (true) or just warn (false) when a directive is missing</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <outputDirectory implementation="java.io.File" default-value="${project.build.outputDirectory}"/>
                <skip implementation="boolean" default-value="false">${vidocq.moduleinfo.skip}</skip>
                <failOnMissing implementation="boolean" default-value="true">${vidocq.moduleinfo.failOnMissing}</failOnMissing>
            </configuration>
        </mojo>

        <!-- vidocq:complete-module-info -->
        <mojo>
            <goal>complete-module-info</goal>
            <description>Opt-in companion to check-module-info: rewrite src/main/java/module-info.java to add the opens directives the application's Vidocq extensions require (from their META-INF/vidocq/module-requirements.properties descriptors). Idempotent zero-dependency text insertion; no default phase, invoke explicitly.</description>
            <requiresDependencyResolution>compile</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresOnline>false</requiresOnline>
            <aggregator>false</aggregator>
            <implementation>io.vidocq.runtime.maven.VidocqCompleteModuleInfoMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The Maven project</description></parameter>
                <parameter><name>outputDirectory</name><type>java.io.File</type><required>false</required><editable>false</editable><description>The compiled-classes output directory (holds module-info.class)</description></parameter>
                <parameter><name>skip</name><type>boolean</type><required>false</required><editable>true</editable><description>Skip entirely</description></parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <outputDirectory implementation="java.io.File" default-value="${project.build.outputDirectory}"/>
                <skip implementation="boolean" default-value="false">${vidocq.moduleinfo.skip}</skip>
            </configuration>
        </mojo>
    </mojos>
</plugin>
