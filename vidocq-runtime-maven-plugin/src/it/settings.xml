<?xml version="1.0" encoding="UTF-8"?>
<!--
    Settings of the integration-test builds (maven-invoker-plugin "fast use" pattern): anything they need that
    invoker:install did not stage in target/it-repo is copied from the outer build's local repository instead
    of being downloaded.
-->
<settings>
    <profiles>
        <profile>
            <id>it-repo</id>
            <repositories>
                <repository>
                    <id>local.central</id>
                    <url>@localRepositoryUrl@</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>local.central</id>
                    <url>@localRepositoryUrl@</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>it-repo</activeProfile>
    </activeProfiles>
</settings>
