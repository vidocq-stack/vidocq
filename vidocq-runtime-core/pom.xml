<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
    </parent>

    <artifactId>vidocq-runtime-core</artifactId>
    <name>Vidocq :: Core</name>
    <description>Vidocq server engine and bootstrap</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
        </dependency>

        <!-- Ravel — fournit @ConfigProperty + ConfigProvider (MicroProfile Config 3.1)
             à toutes les applications Vidocq via auto-découverte BCE Vauban. -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-cdi-vauban</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Ouvre le package de test au container CDI Vauban pour la réflexion
                         sur les beans de test (@ConfigProperty, injection). -->
                    <argLine>--add-opens io.vidocq.runtime.core/io.vidocq.runtime.core.config=io.vidocq.vauban.core</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
