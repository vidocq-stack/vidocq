<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <!-- Self-contained CLI distribution: the full transitive module closure plus
         launchers. Downloaded by https://vidocq.dev/install.sh — keep the layout
         (bin/ + modules/) stable. -->
    <id>cli</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <!-- cmd.exe requires CRLF line endings: with LF-only batch files its line
             parser mangles the java invocation and the CLI receives no arguments
             at all (BUG-20260712-02, reported as issue #23). Keep the launchers in
             two filesets so each ships with its native line endings. -->
        <fileSet>
            <directory>src/assembly/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
            <excludes>
                <exclude>*.cmd</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>src/assembly/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>crlf</lineEnding>
            <includes>
                <include>*.cmd</include>
            </includes>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>modules</outputDirectory>
            <scope>runtime</scope>
            <useProjectArtifact>true</useProjectArtifact>
        </dependencySet>
    </dependencySets>
</assembly>
