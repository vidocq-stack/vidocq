    <build>
        <plugins>
            <!--
              One batch at the end of the reactor instead of one upload per module: nothing reaches
              central-snapshots unless every module built (a failure used to leave the modules built
              before it published), and the resolver uploads the batch in parallel (about 10 s per
              module one by one, 63 modules). vidocq-parent pins deployAtEnd to false, so the BOM and
              this reactor's parent set it too; all three must agree, or those poms deploy at once.
              Checked with maven-deploy-plugin 3.1.4 on Maven 3.9.16: same files as one by one, and
              none at all when a late module fails, even with a skipped last module.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <deployAtEnd>true</deployAtEnd>
                </configuration>
            </plugin>
            <!-- A build tool, not part of what ships (AGENTS.md, zero external dependency): it writes the pom the
                 release publishes, with no parent and no profile, named in reference.adoc. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
