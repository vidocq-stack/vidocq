    <artifactId>vidocq-runtime-coverage</artifactId>
    <packaging>pom</packaging>

    <name>Vidocq :: Coverage</name>
    <description>Aggregated JaCoCo report of the reactor, read by SonarQube (quality profile only)</description>

    <properties>
        <!-- Quality-only module, listed by the quality profile of vidocq-runtime-build: never
             released, installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        report-aggregate reads these dependencies: in compile scope, their classes, sources and
        execution data make up the report; in test scope, only their execution data counts.
        vidocq-runtime-it-cassini-rest, -it-humboldt-cassini, -it-cervantes-jwt and
        -it-grimm-openapi only hold tests of the other modules, and -it-cyrano-jpms,
        -it-foy-servlet, -it-ibarra-pages, -it-naming, -it-ravel-config and -it-langchain4j-cdi-mcp
        only add the small application their tests run (SonarQube skips it): without this report, these
        tests would not count for the code they exercise (Vidocq/vidocq#284).

        Left out: vidocq-runtime-core-codegen, the *-extension-codegen bundles and
        vidocq-runtime-heisenberg-fault-tolerance-extension only hold a module-info.java;
        vidocq-runtime-h2-module-repackaged only repackages H2's bytecode; the examples are
        analysed but kept out of coverage (sonar.coverage.exclusions of the parent). The modules
        of the it profile (CI runners only) drive Maven in child processes, which JaCoCo does not
        instrument, and those of the docker and tck profiles are not in the default reactor.
    -->
