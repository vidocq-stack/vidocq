<?xml version="1.0" encoding="UTF-8"?>
<!--
    champollion-tck — official Jakarta JSON-P 2.1 and JSON-B 3.0 TCK runner.

    In-reactor module gated by the `tck` Maven profile of champollion-parent
    (TCK harmonisation — same pattern as the vidocq-runtime-tck-* runners and
    the dirac pilot): a plain `mvn install` neither downloads nor runs
    anything TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration.

    Invocation: ./run-official-tck-jsonp-2.1.sh or ./run-official-tck-jsonb-3.0.sh
    (thin wrappers), or directly:
        ./mvnw -Ptck,jsonp-tck -pl champollion-tck test
        ./mvnw -Ptck,jsonb-tck -pl champollion-tck test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.champollion</groupId>
        <artifactId>champollion-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>champollion-tck</artifactId>
    <packaging>jar</packaging>

    <name>Champollion :: TCK Runner</name>
    <description>Official Jakarta JSON-P 2.1 and JSON-B 3.0 TCK runner — in-reactor, tck Maven profile</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <jakarta.json.version>2.1.3</jakarta.json.version>
        <jakarta.json.bind.version>3.0.1</jakarta.json.bind.version>

        <!--
            The Vauban of this release line, as champollion-jsonb-cdi pins it: the container of the
            two CDI tests of the JSON-B TCK (jsonb-tck profile).
        -->
        <vauban.version>0.5.0-SNAPSHOT</vauban.version>

        <!--
            Versions of the official Eclipse Foundation TCKs. Not published on
            the public Maven Central — see TCK.md for the manual installation.
        -->
        <jakarta.json.tck.version>2.1.1</jakarta.json.tck.version>
        <jakarta.json.bind.tck.version>3.0.0</jakarta.json.bind.tck.version>

        <!--
            The module's own tests compile only in the script-tests profile, which brings JUnit
            Jupiter: the official runs compile and scan the TCK alone (the JSON-B TCK runs on TestNG).
        -->
        <script.tests.exclude>**/OfficialTckScriptTest.java</script.tests.exclude>
    </properties>

    <dependencies>
        <!--
            Champollion, the implementation under test: the reactor's own modules, at the version
            champollion-parent manages (`${project.version}`), like every other module of the
            reactor. No version is written here: a pinned `0.3.0-SNAPSHOT` made every run from
            2026-08-30 to 2026-11-17 test the last 0.3.0 snapshot, not the code of the pull request
            (BUG-20261117-03).
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
        </dependency>

        <!-- API specs -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>${jakarta.json.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <version>${jakarta.json.bind.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            The module's own tests (OfficialTckScriptTest: the run scripts, with a fake Maven), run by a
            plain `-Ptck` build. Active by default, so it drops out as soon as jsonp-tck,
            jsonp-tck-pluggability or jsonb-tck is named: JUnit Jupiter stays off the TestNG run of the
            JSON-B TCK, and the official runs scan the TCK jars only.
        -->
        <profile>
            <id>script-tests</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- A pattern no file matches: OfficialTckScriptTest compiles here. -->
                <script.tests.exclude>none</script.tests.exclude>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <!--
            JSON-P 2.1 TCK profile. Activated by run-official-tck-jsonp-2.1.sh.
            The official TCK must be installed in the local M2 (see TCK.md).
        -->
        <!--
            API profile: api/* tests with Champollion as the JsonProvider.
            The -tck-tests-pluggability jar is deliberately excluded (it provides
            a competing MyJsonProvider through META-INF/services that pollutes
            JsonProvider.provider() at run time and breaks the api tests).
        -->
        <profile>
            <id>jsonp-tck</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.json</groupId>
                    <artifactId>jakarta.json-tck-tests</artifactId>
                    <version>${jakarta.json.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.json</groupId>
                    <artifactId>jakarta.json-tck-common</artifactId>
                    <version>${jakarta.json.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>sigtest-maven-plugin</artifactId>
                    <version>2.5</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <version>5.11.4</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.5</version>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>jakarta.json:jakarta.json-tck-tests</dependency>
                            </dependenciesToScan>
                            <reportsDirectory>${project.build.directory}/tck-reports/jsonp</reportsDirectory>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage</jimage.dir>
                                <signature.sigTestClasspath>${project.build.directory}/signature-api/jakarta.json-api.jar${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.xml</signature.sigTestClasspath>
                                <sigTestClasspath>${project.build.directory}/signature-api/jakarta.json-api.jar${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.xml</sigTestClasspath>
                            </systemPropertyVariables>
                            <!--
                                The TCK holds JsonProviderTest.systemProperty(), which
                                calls System.setProperty("jakarta.json.provider", DummyJsonProvider)
                                without cleanup. Fork per class to isolate each test
                                in a fresh JVM, otherwise DummyJsonProvider pollutes every
                                following test.
                            -->
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Pluggability profile: run separately, with only pluggability + tck-common on
            the classpath (Champollion not loaded). MyJsonProvider from the pluggability jar
            serves as the oracle for the tests that check the default behaviour of
            JsonProvider.provider() against third-party providers.
        -->
        <profile>
            <id>jsonp-tck-pluggability</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.json</groupId>
                    <artifactId>jakarta.json-tck-tests-pluggability</artifactId>
                    <version>${jakarta.json.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.json</groupId>
                    <artifactId>jakarta.json-tck-common</artifactId>
                    <version>${jakarta.json.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <version>5.11.4</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.5</version>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>jakarta.json:jakarta.json-tck-tests-pluggability</dependency>
                            </dependenciesToScan>
                            <reportsDirectory>${project.build.directory}/tck-reports/jsonp-pluggability</reportsDirectory>
                            <!--
                                Pluggability profile: MyJsonProvider (from the TCK pluggability
                                jar) must win JsonProvider.provider() / ServiceLoader. Champollion
                                is declared at the project root for the api profile, so we have to
                                explicitly remove it from this profile's surefire classpath, otherwise
                                the ServiceLoader picks ChampollionJsonProvider first and the 17
                                jsonProviderTest* tests fail with "Current provider is not my provider".
                            -->
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.vidocq.champollion:champollion-jsonp</classpathDependencyExclude>
                                <classpathDependencyExclude>io.vidocq.champollion:champollion-jsonb</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            JSON-B 3.0 TCK profile. Activated by run-official-tck-jsonb-3.0.sh.
            Uses TestNG + Arquillian (following the official Eclipse format).
        -->
        <profile>
            <id>jsonb-tck</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.json.bind</groupId>
                    <artifactId>jakarta.json.bind-tck</artifactId>
                    <version>${jakarta.json.bind.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Vauban — Vidocq's own CDI 4.1 (policy "zero external
                    dependency in the Vidocq stack": no Weld). Provides
                    SeContainerInitializer + CDIProvider. Starts the container
                    for the 2 tests Adapters/SerializersCustomizationCDITest,
                    which resolve their adapters/serializers as CDI beans
                    (see JSON-B spec §5).
                -->
                <dependency>
                    <groupId>io.vidocq.vauban</groupId>
                    <artifactId>vauban-core</artifactId>
                    <version>${vauban.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.5</version>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>jakarta.json.bind:jakarta.json.bind-tck</dependency>
                            </dependenciesToScan>
                            <reportsDirectory>${project.build.directory}/tck-reports/jsonb</reportsDirectory>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage</jimage.dir>
                                <signature.sigTestClasspath>${project.build.directory}/signature-api/jakarta.json.bind-api.jar${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.xml</signature.sigTestClasspath>
                                <sigTestClasspath>${project.build.directory}/signature-api/jakarta.json.bind-api.jar${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.xml</sigTestClasspath>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <testExcludes>
                        <testExclude>${script.tests.exclude}</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <!-- The signature tests read the API jars from target/: the run scripts use a private
                 local repository above ~/.m2/repository (BUG-20261123-57), so the jar Maven
                 resolved may sit in either, never at a path known in advance. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-spec-apis-for-signature-tests</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>jakarta.json</groupId>
                                    <artifactId>jakarta.json-api</artifactId>
                                    <version>${jakarta.json.version}</version>
                                    <destFileName>jakarta.json-api.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>jakarta.json.bind</groupId>
                                    <artifactId>jakarta.json.bind-api</artifactId>
                                    <version>${jakarta.json.bind.version}</version>
                                    <destFileName>jakarta.json.bind-api.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/signature-api</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
