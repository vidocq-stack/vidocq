<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.vauban</groupId>
        <artifactId>vauban-examples</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>
    <artifactId>example-cdi1015-lib</artifactId>
    <name>Vauban :: Examples :: cdi#1015 :: Third-party library</name>
    <description>A CDI-agnostic Java module: exports its types, declares NO opens, has no Vauban dependency — the "library A" of jakartaee/cdi#1015.</description>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>
    <build><plugins>
        <!-- A SNAPSHOT, never a release: example-cdi1015-app and example-enhanced-app depend on it, and a pull
             request build that rebuilds them and not this module resolves it from maven.vidocq.dev.
             maven.deploy.skip stays true, so release.sh leaves it out of a release. -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <configuration><skip>false</skip></configuration>
        </plugin>
        <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <configuration><skipPublishing>true</skipPublishing></configuration>
        </plugin>
    </plugins></build>
</project>
