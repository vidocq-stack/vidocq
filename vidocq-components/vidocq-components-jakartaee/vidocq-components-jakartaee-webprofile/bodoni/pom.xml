<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC2</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.bodoni</groupId>
    <artifactId>bodoni-parent</artifactId>
    <version>0.4.0-RC2</version>
    <packaging>pom</packaging>

    <name>Bodoni</name>
    <description>Jakarta Standard Tag Library 3.0 implementation — zero third-party dependency, strict Java Modules, portable tag handlers with optional build-time inlining by Ibarra</description>
    <url>https://codefloe.com/Vidocq/bodoni</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/bodoni</url>
        <connection>scm:git:https://codefloe.com/Vidocq/bodoni.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/bodoni.git</developerConnection>
    </scm>

    <properties>
        
        <jakarta.jstl.version>3.0.2</jakarta.jstl.version>

        
        <jakarta.pages.version>4.0.0</jakarta.pages.version>
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jakarta.el.version>6.0.1</jakarta.el.version>

        
        <peano.version>0.4.0-RC2</peano.version>

        
        <h2.version>2.3.232</h2.version>

        
        <ibarra.version>0.4.0-SNAPSHOT</ibarra.version>
    </properties>

    
    <modules>
        <module>bodoni-core</module>
        <module>bodoni-peano</module>
        <module>bodoni-it-other-containers</module>
        
        <module>bodoni-architecture-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>jakarta.servlet.jsp.jstl</groupId>
                <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
                <version>${jakarta.jstl.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>jakarta.servlet</groupId>
                        <artifactId>jakarta.servlet-api</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>jakarta.el</groupId>
                        <artifactId>jakarta.el-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            
            <dependency>
                <groupId>jakarta.servlet.jsp</groupId>
                <artifactId>jakarta.servlet.jsp-api</artifactId>
                <version>${jakarta.pages.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>${jakarta.el.version}</version>
                <scope>provided</scope>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-api</artifactId>
                <version>${peano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-core</artifactId>
                <version>${peano.version}</version>
            </dependency>

            
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.bodoni</groupId>
                <artifactId>bodoni-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.bodoni</groupId>
                <artifactId>bodoni-peano</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    
    <profiles>
        
        <profile>
            <id>it-ibarra</id>
            <properties>
                <foy.version>0.4.0-SNAPSHOT</foy.version>
                <chappe.version>0.4.0-SNAPSHOT</chappe.version>
            </properties>
            <modules>
                <module>bodoni-it-ibarra</module>
            </modules>
        </profile>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>bodoni-tck</module>
            </modules>
        </profile>
    </profiles>
</project>