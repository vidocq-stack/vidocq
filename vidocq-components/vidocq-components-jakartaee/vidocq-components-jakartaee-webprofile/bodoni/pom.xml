    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/bodoni</url>
        <connection>scm:git:https://codefloe.com/Vidocq/bodoni.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/bodoni.git</developerConnection>
    </scm>

    <properties>
        <!-- Jakarta Standard Tag Library 3.0 spec API — already modular upstream
             (module jakarta.servlet.jsp.jstl, verified on the 3.0.2 jar: requires
             transitive jakarta.servlet.jsp, jakarta.servlet, jakarta.el, java.sql
             and java.desktop), no Vidocq fork needed. Bodoni ships it at compile
             scope: it is the spec this brick implements. -->
        <jakarta.jstl.version>3.0.2</jakarta.jstl.version>

        <!-- Platform APIs Bodoni runs on — `provided`: the Pages container
             (Ibarra under Vidocq, Jasper or Open Liberty elsewhere) brings them.
             Levels of Jakarta EE 11 / Web Profile 11. -->
        <jakarta.pages.version>4.0.0</jakarta.pages.version>
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jakarta.el.version>6.0.1</jakarta.el.version>

        <!-- Peano: only the bodoni-peano engine adapter (and the it-ibarra profile) depend on it. -->
        <peano.version>0.4.0-SNAPSHOT</peano.version>
    </properties>

    <!--
        Main reactor modules. Planned modules (PLAN.md, milestones B5-B7):
        bodoni-tck joins the reactor only under the `tck` Maven profile, like
        every other Vidocq sub-project; bodoni-ibarra (optional build-time
        inliner) and bodoni-it-other-containers/bodoni-it-openliberty follow.
    -->
    <modules>
        <module>bodoni-core</module>
        <module>bodoni-peano</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta Standard Tag Library 3.0 — the implemented spec.
                 The upstream POM declares jakarta.servlet-api 6.0.0 and
                 jakarta.el-api 5.0.0 at compile scope: excluded here so they
                 never reach applications transitively; the container brings
                 the EE 11 levels below. -->
            <dependency>
                <groupId>jakarta.servlet.jsp.jstl</groupId>
                <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
                <version>${jakarta.jstl.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>jakarta.servlet</groupId>
                        <artifactId>jakarta.servlet-api</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>jakarta.el</groupId>
                        <artifactId>jakarta.el-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Platform APIs (provided by the Pages container) -->
            <dependency>
                <groupId>jakarta.servlet.jsp</groupId>
                <artifactId>jakarta.servlet.jsp-api</artifactId>
                <version>${jakarta.pages.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>${jakarta.el.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Peano — only for bodoni-peano, the engine adapter (never bodoni-core). -->
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-api</artifactId>
                <version>${peano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-core</artifactId>
                <version>${peano.version}</version>
            </dependency>

            <!-- Internal Bodoni modules -->
            <dependency>
                <groupId>io.vidocq.bodoni</groupId>
                <artifactId>bodoni-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.bodoni</groupId>
                <artifactId>bodoni-peano</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Planned profiles (not wired until the module exists, PLAN.md "TCK plan"):

            tck        adds bodoni-tck            ./mvnw -Ptck -pl bodoni-tck test
            quality    adds bodoni-coverage       aggregated JaCoCo report for SonarQube
    -->
    <profiles>
        <!--
            it-ibarra adds bodoni-it-ibarra, an unpublished integration test that
            precompiles real pages with Ibarra and renders them on Foy over Chappe:
                ./mvnw -ntp -Pit-ibarra -pl bodoni-it-ibarra -am verify
            The default build neither builds the module nor resolves Ibarra, Peano,
            Foy or Chappe.
        -->
        <profile>
            <id>it-ibarra</id>
            <properties>
                <ibarra.version>0.4.0-SNAPSHOT</ibarra.version>
                <foy.version>0.4.0-SNAPSHOT</foy.version>
                <chappe.version>0.4.0-SNAPSHOT</chappe.version>
            </properties>
            <modules>
                <module>bodoni-it-ibarra</module>
            </modules>
        </profile>
    </profiles>
</project>
