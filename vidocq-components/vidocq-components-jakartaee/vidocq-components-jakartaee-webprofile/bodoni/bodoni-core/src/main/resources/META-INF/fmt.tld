<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
  <description>Jakarta Standard Tag Library 3.0 - internationalization and formatting library</description>
  <display-name>JSTL fmt</display-name>
  <tlib-version>3.0</tlib-version>
  <short-name>fmt</short-name>
  <uri>jakarta.tags.fmt</uri>

  <tag>
    <description>Sets the request character encoding.</description>
    <name>requestEncoding</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.RequestEncodingTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>Name of the character encoding (charset) to be applied when decoding request parameters.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Stores the specified locale in the locale configuration variable.</description>
    <name>setLocale</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.SetLocaleTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>A String or a java.util.Locale. A String is the printable representation of a locale.</description>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Vendor- or browser-specific variant.</description>
      <name>variant</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of the locale configuration variable.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Specifies the time zone in which time information is formatted or parsed in its body content.</description>
    <name>timeZone</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.TimeZoneTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>The time zone: a String time zone ID or a java.util.TimeZone.</description>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
  </tag>

  <tag>
    <description>Stores the specified time zone in a scoped variable or the time zone configuration variable.</description>
    <name>setTimeZone</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.SetTimeZoneTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>The time zone: a String time zone ID or a java.util.TimeZone.</description>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the time zone.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var or the time zone configuration variable.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Creates an i18n localization context to be used by its body content.</description>
    <name>bundle</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.BundleTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Resource bundle base name.</description>
      <name>basename</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Prefix to be prepended to the value of the message key of any nested message action.</description>
      <name>prefix</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Creates an i18n localization context and stores it in a scoped variable or the localization context configuration variable.</description>
    <name>setBundle</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.SetBundleTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>Resource bundle base name.</description>
      <name>basename</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the localization context.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var or the localization context configuration variable.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Looks up a localized message in a resource bundle.</description>
    <name>message</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.MessageTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Message key to be looked up.</description>
      <name>key</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Localization context in whose resource bundle the message key is looked up.</description>
      <name>bundle</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>jakarta.servlet.jsp.jstl.fmt.LocalizationContext</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the localized message.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Supplies a single parameter for parametric replacement to a containing message action.</description>
    <name>param</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.ParamTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Argument used for parametric replacement.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
  </tag>

  <tag>
    <description>Formats a numeric value as a number, currency or percentage.</description>
    <name>formatNumber</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.FormatNumberTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Numeric value to be formatted: a String or a Number.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Whether the value is formatted as number, currency or percent.</description>
      <name>type</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Custom formatting pattern.</description>
      <name>pattern</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>ISO 4217 currency code, applied when formatting currencies.</description>
      <name>currencyCode</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Currency symbol, applied when formatting currencies.</description>
      <name>currencySymbol</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Whether the formatted output contains any grouping separators.</description>
      <name>groupingUsed</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>boolean</type>
    </attribute>
    <attribute>
      <description>Maximum number of digits in the integer portion of the output.</description>
      <name>maxIntegerDigits</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Minimum number of digits in the integer portion of the output.</description>
      <name>minIntegerDigits</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Maximum number of digits in the fractional portion of the output.</description>
      <name>maxFractionDigits</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Minimum number of digits in the fractional portion of the output.</description>
      <name>minFractionDigits</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the formatted result.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Parses the string representation of a number, currency or percentage.</description>
    <name>parseNumber</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.ParseNumberTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>String to be parsed.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Whether the string is to be parsed as number, currency or percent.</description>
      <name>type</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Custom parsing pattern.</description>
      <name>pattern</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Locale whose conventions are used to parse the string: a String or a java.util.Locale.</description>
      <name>parseLocale</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Whether only the integer portion of the value is parsed.</description>
      <name>integerOnly</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>boolean</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the parsed result.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Formats dates and times in a locale-sensitive or customized manner.</description>
    <name>formatDate</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.FormatDateTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>Date and/or time to be formatted.</description>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.util.Date</type>
    </attribute>
    <attribute>
      <description>Whether the time, the date, or both are formatted.</description>
      <name>type</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Predefined formatting style for dates.</description>
      <name>dateStyle</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Predefined formatting style for times.</description>
      <name>timeStyle</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Custom formatting pattern.</description>
      <name>pattern</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Time zone in which to represent the formatted time: a String time zone ID or a java.util.TimeZone.</description>
      <name>timeZone</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the formatted result.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Parses the string representation of a date and/or time.</description>
    <name>parseDate</name>
    <tag-class>io.vidocq.bodoni.core.tags.fmt.ParseDateTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Date string to be parsed.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Whether the string contains a time, a date, or both.</description>
      <name>type</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Predefined formatting style for dates.</description>
      <name>dateStyle</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Predefined formatting style for times.</description>
      <name>timeStyle</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Custom parsing pattern.</description>
      <name>pattern</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Time zone in which to interpret any time information in the date string: a String time zone ID or a java.util.TimeZone.</description>
      <name>timeZone</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Locale whose conventions are used to parse the date string: a String or a java.util.Locale.</description>
      <name>parseLocale</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable which stores the parsed result.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>
</taglib>
