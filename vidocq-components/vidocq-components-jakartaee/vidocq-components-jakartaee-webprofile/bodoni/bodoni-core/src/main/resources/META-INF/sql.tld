<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
  <description>Jakarta Standard Tag Library 3.0 - SQL library</description>
  <display-name>JSTL SQL</display-name>
  <tlib-version>3.0</tlib-version>
  <short-name>sql</short-name>
  <uri>jakarta.tags.sql</uri>

  <tag>
    <description>Groups nested query and update actions into one database transaction.</description>
    <name>transaction</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.TransactionTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Data source associated with the database to access: a DataSource, a JNDI relative path or JDBC parameters.</description>
      <name>dataSource</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Transaction isolation level: read_committed, read_uncommitted, repeatable_read or serializable.</description>
      <name>isolation</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Queries a database and saves the result in a scoped variable.</description>
    <name>query</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.QueryTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>SQL query statement.</description>
      <name>sql</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Data source associated with the database to query: a DataSource, a JNDI relative path or JDBC parameters.</description>
      <name>dataSource</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Maximum number of rows in the result; -1 means no limit.</description>
      <name>maxRows</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Index of the first row included in the result, starting at 0.</description>
      <name>startRow</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>int</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable for the query result (jakarta.servlet.jsp.jstl.sql.Result).</description>
      <name>var</name>
      <required>true</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Executes an SQL INSERT, UPDATE or DELETE statement, or a statement that returns nothing.</description>
    <name>update</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.UpdateTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>SQL update statement.</description>
      <name>sql</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Data source associated with the database to update: a DataSource, a JNDI relative path or JDBC parameters.</description>
      <name>dataSource</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable for the update count (java.lang.Integer).</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Sets the value of a parameter marker in the SQL statement of the enclosing action.</description>
    <name>param</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.ParamTag</tag-class>
    <body-content>JSP</body-content>
    <attribute>
      <description>Parameter value; the body content when absent.</description>
      <name>value</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
  </tag>

  <tag>
    <description>Sets the value of a parameter marker for a java.util.Date value.</description>
    <name>dateParam</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.DateParamTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>Parameter value for a DATE, TIME or TIMESTAMP column.</description>
      <name>value</name>
      <required>true</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.util.Date</type>
    </attribute>
    <attribute>
      <description>One of date, time or timestamp.</description>
      <name>type</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>

  <tag>
    <description>Exports a data source, as a scoped variable or as the default data source configuration variable.</description>
    <name>setDataSource</name>
    <tag-class>io.vidocq.bodoni.core.tags.sql.SetDataSourceTag</tag-class>
    <body-content>empty</body-content>
    <attribute>
      <description>Data source: a DataSource, a JNDI relative path or JDBC parameters.</description>
      <name>dataSource</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.Object</type>
    </attribute>
    <attribute>
      <description>JDBC parameter: driver class name.</description>
      <name>driver</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>JDBC parameter: URL associated with the database.</description>
      <name>url</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>JDBC parameter: database user.</description>
      <name>user</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>JDBC parameter: user password.</description>
      <name>password</name>
      <required>false</required>
      <rtexprvalue>true</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Name of the exported scoped variable for the data source.</description>
      <name>var</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
    <attribute>
      <description>Scope of var, or of the data source configuration variable when var is absent.</description>
      <name>scope</name>
      <required>false</required>
      <rtexprvalue>false</rtexprvalue>
      <type>java.lang.String</type>
    </attribute>
  </tag>
</taglib>
