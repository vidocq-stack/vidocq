<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.bodoni</groupId>
        <artifactId>bodoni-parent</artifactId>
        <version>0.4.0-RC2</version>
    </parent>

    <artifactId>bodoni-core</artifactId>
    <name>Bodoni :: Core</name>
    <description>Jakarta Standard Tag Library 3.0 implementation — tag handlers, functions and TLDs of the core, fmt, functions, xml and sql libraries (all five since B4; see PLAN.md)</description>

    <dependencies>
        <!-- The implemented spec: compile scope, reaches applications transitively. -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        </dependency>
        <!-- Platform APIs: provided (scope from dependencyManagement) — the Pages
             container brings them. Declared directly to pin the EE 11 levels. -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
        </dependency>
        <!-- Test only (scope from dependencyManagement): in-memory JDBC driver. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests run on the module path (patched module). The EL BeanELResolver
                         invokes public accessors of test beans reflectively: open the test
                         doubles package to jakarta.el for the test run only (never in the
                         main module-info). Test beans live in this package. java.naming
                         instantiates the test InitialContextFactory (TestNaming.Factory) by name. -->
                    <argLine>@{argLine} --add-opens io.vidocq.bodoni.core/io.vidocq.bodoni.core.testing=jakarta.el,java.naming</argLine>
                </configuration>
                <executions>
                    <execution>
                        <!-- DateParamZoneTest needs Europe/Paris as the JVM default zone (BUG.md
                             BOD-005). It gets its own JVM, started in that zone: switching the
                             default zone inside a shared JVM leaks into later tests, because H2
                             caches the zone it first sees. -->
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/DateParamZoneTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>europe-paris-zone</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/DateParamZoneTest.java</include>
                            </includes>
                            <argLine>@{argLine} --add-opens io.vidocq.bodoni.core/io.vidocq.bodoni.core.testing=jakarta.el,java.naming -Duser.timezone=Europe/Paris</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
