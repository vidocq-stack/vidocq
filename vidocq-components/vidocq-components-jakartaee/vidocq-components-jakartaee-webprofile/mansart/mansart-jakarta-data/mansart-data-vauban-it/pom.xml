<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-data</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-data-vauban-it</artifactId>
    <name>Mansart :: Data :: IT :: Vauban Processor</name>
    <description>Integration test: repositories compiled by Mansart's processor AND Vauban's, as in a Vidocq
        application, then injected in a Vauban container by their parameterized supertype
        (BasicRepository&lt;Book, Long&gt;).</description>

    <properties>
        <!-- Test vehicle: never released. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <!-- SonarQube: test vehicle, its main code only exists to be exercised by its test (Vidocq/vidocq#284). -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-cdi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The vehicle boots a container, and the code Vauban's processor generates refers to it. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>
        <!-- The data source the fixture produces. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Both processors, as the codegen bundles of a Vidocq application put them: Mansart's writes
                BooksImpl and AuthorsImpl, Vauban's then reads them as beans, with the bean types they
                inherit from BasicRepository<Book, Long> and BasicRepository<Author, Long>.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                        <!-- Mansart's build compatible extension, as the codegen bundle of the Vidocq extension
                             brings it: it adds the producer of the RepositoryRuntime the implementations inject. -->
                        <path>
                            <groupId>io.vidocq.mansart</groupId>
                            <artifactId>mansart-data-cdi</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <!-- The Jakarta API it reads is provided by the container at run time
                             (vidocq-workspace#17): the processor path names it. -->
                        <path>
                            <groupId>jakarta.enterprise</groupId>
                            <artifactId>jakarta.enterprise.cdi-api</artifactId>
                            <version>${jakarta.cdi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- A warning fails the compilation of the fixtures: Vauban's processor must resolve the two
                         parameterized injection points of Shelf at build, not print "Unsatisfied dependency ...
                         resolution deferred to the runtime" (Vauban BUG-20261117-03). -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <showWarnings>true</showWarnings>
                            <failOnWarning>true</failOnWarning>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
