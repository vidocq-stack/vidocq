    <profiles>
        <!--
          heisenberg-mp-ft-api has no source of its own beyond its module descriptor: Maven unpacks its classes from the
          MicroProfile Fault Tolerance jar, which ships no module descriptor.
          IntelliJ would import it as an empty module and turn every module that depends on it red, so the
          IntelliJ import leaves it out of the reactor and resolves its jar like any other dependency.
          Only that import sets idea.maven.embedder.version: a Maven build, from a terminal or started from
          the IDE, is unchanged.
        -->
        <profile>
            <id>repackaged-api</id>
            <activation>
                <property>
                    <name>!idea.maven.embedder.version</name>
                </property>
            </activation>
            <modules>
                <module>heisenberg-mp-ft-api</module>
            </modules>
        </profile>
        <!--
            TCK harmonisation (workspace-wide effort, dirac = pilot brick): the
            official MicroProfile Fault Tolerance 4.1 TCK runner joins the reactor
            only when this profile is active, exactly like the in-reactor
            vidocq-runtime-tck-* runners of the vidocq runtime.

                ./mvnw -Ptck -pl heisenberg-tck test                     # smoke
                ./mvnw -Ptck,tck-official -pl heisenberg-tck test        # full suite

            run-official-tck-mp-fault-tolerance-4.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>heisenberg-tck</module>
            </modules>
        </profile>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>heisenberg-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
