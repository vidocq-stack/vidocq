    <properties>
        <!-- MicroProfile Fault Tolerance 4.1 API. The upstream jar is not modular: heisenberg-mp-ft-api
             repackages it with a module-info (module microprofile.fault.tolerance.api). -->
        <microprofile.fault.tolerance.version>4.1</microprofile.fault.tolerance.version>

        <!-- Jakarta CDI 4.1 (Jakarta EE 11) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Jakarta Interceptors 2.2 (Jakarta EE 11) -->
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        <!--
            MicroProfile Config 3.1.1 — version with Automatic-Module-Name:
            "org.eclipse.microprofile.config" added to the manifest since 2026-04-22.
        -->
        <microprofile.config.version>3.1.1</microprofile.config.version>

        <!-- Upstream Vidocq implementations -->
        <vauban.version>${project.version}</vauban.version>
        <ravel.version>${project.version}</ravel.version>
        <dirac.version>${project.version}</dirac.version>

        <!-- JMH for heisenberg-bench -->
        <jmh.version>1.37</jmh.version>

        <!--
            What the TCK workflow of the monorepo (.forgejo/workflows/tck-nightly.yml) runs for this
            component, from its folder: once a day, on demand and for a release. A pull request runs
            no TCK.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds heisenberg-tck to the reactor, and inside heisenberg-tck
            the `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset
            while reporting success — the vacuous gate this campaign exists to remove.

            Measured on a clean local repository (empty ~/.m2, the state of a CI runner): the
            official MicroProfile Fault Tolerance 4.1 TCK runs 463 tests in 174 s, all green, every
            artefact resolved from Maven Central. That cost is deliberate and irreducible: fault
            tolerance IS durations (testTimeout, testRetryWithDelay, testBulkheadPressure), so the
            suite spends most of its time waiting on purpose. Three minutes a night buys the only
            automated proof that this implementation still conforms.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl heisenberg-tck test</ci.tck.command>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            heisenberg-coverage (quality profile), so the tests of heisenberg-it-weld and
            heisenberg-cdi-vauban-module-it count for the code they exercise in the other modules.
            heisenberg-examples stays analysed, out of the coverage figures, and may print to
            System.out (rule java:S106).
        -->
        <!-- The component's aggregate report, from a build at the monorepo root, then from a build in this folder
             (maven.multiModuleProjectDirectory is the nearest .mvn), then the module's own report. The scanner
             skips a path that does not exist. -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/vidocq-components/vidocq-components-microprofile/heisenberg/heisenberg-coverage/target/site/jacoco-aggregate/jacoco.xml,${maven.multiModuleProjectDirectory}/heisenberg-coverage/target/site/jacoco-aggregate/jacoco.xml,target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/heisenberg-examples/**</sonar.coverage.exclusions>
        <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/heisenberg-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
    </properties>

    <!--
        heisenberg-tck joins the reactor only under the `tck` profile (see <profiles>
        below), mirroring the vidocq-runtime-tck-* pattern: a plain `mvn install`
        neither downloads nor runs the TCK, and the release reactor never sees it.
        The historical out-of-reactor constraint (ShrinkWrap Maven Resolver 3.3
        vs Model 4.1.0 POMs) disappeared with the Maven 3.9.16 / Model 4.0.0
        migration; the MP Fault Tolerance TCK builds its deployments with
        addClass/addPackage and does not use the ShrinkWrap Maven resolver, so it
        runs safely in-reactor (same verification as vidocq-runtime-tck-heisenberg-faulttolerance).
    -->
    <modules>
        <module>heisenberg-api</module>
        <module>heisenberg-core</module>
        <module>heisenberg-processor</module>
        <module>heisenberg-cdi-vauban</module>
        <module>heisenberg-cdi-vauban-module-it</module>
        <module>heisenberg-it-other-containers</module>
        <module>heisenberg-bench</module>
        <module>heisenberg-examples</module>
        <module>heisenberg-architecture-tests</module>
    </modules>

