<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.heisenberg</groupId>
        <artifactId>heisenberg-parent</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>heisenberg-mp-ft-api</artifactId>
    <name>Heisenberg :: MicroProfile Fault Tolerance API (modular)</name>
    <description>
        org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-api repackaged with an
        explicit module-info.class (module microprofile.fault.tolerance.api). The official API ships no
        module-info.class, which keeps it out of a jlink image. This artifact is the only source of the
        MP Fault Tolerance 4.1 spec for the Heisenberg modules (heisenberg-api, heisenberg-core,
        heisenberg-cdi-vauban); the official TCK keeps the original API.
    </description>

    <dependencies>
        <!--
            The official spec is fetched as 'provided' only so that its .class files can be
            unpacked into target/classes; it is not exposed transitively to consumers, who
            receive instead the repackaged jar with its explicit module-info.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1) Unpacks the .class files of microprofile-fault-tolerance-api into target/classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-microprofile-ft-api</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
                                    <artifactId>microprofile-fault-tolerance-api</artifactId>
                                    <version>${microprofile.fault.tolerance.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <!--
                                        The original manifest and Maven metadata are excluded;
                                        maven-jar-plugin writes a clean manifest for our artifact
                                        (without Automatic-Module-Name, now redundant: the module
                                        is explicit).

                                        META-INF/LICENSE and META-INF/NOTICE are deliberately
                                        NOT excluded: the unpacked .class files stay under Apache-2.0,
                                        whose sections 4(a) and 4(d) require the upstream license
                                        and NOTICE to accompany any redistribution.
                                    -->
                                    <excludes>META-INF/MANIFEST.MF,META-INF/maven/**</excludes>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                2) Compiles only src/main/java/module-info.java, patching it into the module
                   'microprofile.fault.tolerance.api' (the .class files unpacked above provide
                   the exported packages that javac checks).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>--patch-module</arg>
                        <arg>microprofile.fault.tolerance.api=${project.build.outputDirectory}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
