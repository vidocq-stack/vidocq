<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of ravel-parent
    (TCK harmonisation — same pattern as the vidocq-runtime-tck-* runners and
    the dirac pilot): a plain `mvn install` neither downloads nor runs anything
    TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration.

    Execution goes through the script (thin wrapper over the reactor):
        ./run-official-tck-mp-config-3.1.sh                      (smoke test)
        ./run-official-tck-mp-config-3.1.sh all                  (full suite)
        ./run-official-tck-mp-config-3.1.sh -Dtest=SomeTests     (targeted class)

    Or directly:
        ./mvnw -Ptck -pl ravel-tck test                          (smoke)
        ./mvnw -Ptck,tck-official -pl ravel-tck test             (full suite)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.ravel</groupId>
        <artifactId>ravel-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>ravel-tck</artifactId>
    <packaging>jar</packaging>

    <name>Ravel :: TCK Runner</name>
    <description>MicroProfile Config 3.1 conformance harness, entry point of the official TCK</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <ravel.version>0.4.0-SNAPSHOT</ravel.version>
        <microprofile.config.version>3.1.1</microprofile.config.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
                Aligns weld-lite-extension-translator with weld-core-impl 6.0.2+.
                The transitive version 6.0.0.Alpha1 (brought by arquillian-weld-embedded)
                calls AfterBeanDiscoveryImpl.addBean(Class), which no longer exists in
                weld-core-impl 6.0.2 — this breaks the @Synthesis phase of the BCEs:

                    java.lang.NoSuchMethodError:
                      'WeldBeanConfigurator AfterBeanDiscoveryImpl.addBean(Class)'
                      at LiteExtensionTranslator.synthesis(...)
            -->
            <dependency>
                <groupId>org.jboss.weld</groupId>
                <artifactId>weld-lite-extension-translator</artifactId>
                <version>6.0.1.Final</version>
            </dependency>

            <!--
                The MP Config TCK pulls in cdi-api 4.1.0-M1 (Milestone) transitively,
                which does not contain InvokerFactory. weld-lite-extension-translator
                6.0.1.Final references that class when ExtensionMethodParameterType
                is statically loaded: NoClassDefFoundError during the
                @Registration phase. We force the final 4.1.0.
            -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.lang-model</artifactId>
                <version>4.1.0</version>
            </dependency>

            <!--
                arquillian-weld-embedded:4.0.0.Final pulls in, transitively,
                arquillian-container-spi:1.8.0.Final, in which the Container
                interface is NOT generic. Under JDK 23+, the strict validation of
                ParameterizedTypeImpl then triggers:

                    java.lang.reflect.MalformedParameterizedTypeException:
                      Mismatch of count of formal and actual type arguments in
                      constructor of org.jboss.arquillian.container.spi.Container

                From 1.10.1.Final on, Container is declared as
                Container<T extends ContainerConfiguration>; so we force the trio
                spi/impl-base/core-impl-base to 1.10.1.
            -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.core</groupId>
                <artifactId>arquillian-core-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <version>${ravel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-cdi-vauban</artifactId>
            <version>${ravel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${microprofile.config.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Default profile: smoke test without Arquillian — checks that the ServiceLoader
            does load RavelConfigProviderResolver, with no Weld/TestNG dependency.
        -->
        <profile>
            <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>

        <!--
            Official TCK profile: Arquillian TestNG + embedded Weld SE, dependencies
            scanned from the microprofile-config-tck JAR. Target: 100 % PASS (M5 contract).
        -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.config:microprofile-config-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                                <include>**/*IT.class</include>
                                <!-- Test classes of the official TCK whose names do not follow the
                                     *Test suffix convention (silently skipped before 2026-08-27,
                                     see BUG-20260827-01). Keep in sync with the vidocq runner. -->
                                <include>**/EmptyValuesTestProgrammaticLookup.class</include>
                                <include>**/TestCustomConfigProfile.class</include>
                            </includes>
                            <excludes>
                                <!-- The JUnit smoke test is reserved for the 'smoke' profile. -->
                                <exclude>**/RavelTckSmokeTest.class</exclude>
                            </excludes>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <systemPropertyVariables>
                                <arquillian.launch>weld-embedded</arquillian.launch>
                                <!-- DefaultConfigSourceOrdinalTest.checkSetup -->
                                <config_ordinal>120</config_ordinal>
                                <customer.hobby>Tennis</customer.hobby>
                                <!-- ConfigProviderTest.testPropertyConfigSource -->
                                <mp.tck.prop.dummy>dummy</mp.tck.prop.dummy>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <!-- DefaultConfigSourceOrdinalTest.checkSetup: env
                                     config_ordinal must be 45 to check
                                     the ordinal override of the env ConfigSource. -->
                                <config_ordinal>45</config_ordinal>
                                <customer_name>Bob</customer_name>
                                <!-- ConfigProviderTest.testEnvironmentConfigSource -->
                                <MP_TCK_ENV_DUMMY>dummy</MP_TCK_ENV_DUMMY>
                                <!-- CDIPropertyNameMatchingTest.checkSetup §7.6 -->
                                <my_int_property>45</my_int_property>
                                <MY_BOOLEAN_PROPERTY>true</MY_BOOLEAN_PROPERTY>
                                <my_string_property>haha</my_string_property>
                                <MY_STRING_PROPERTY>woohoo</MY_STRING_PROPERTY>
                            </environmentVariables>
                        </configuration>
                        <dependencies>
                            <!--
                                Forces Surefire to use the TestNG provider: the MP Config TCK
                                is TestNG-driven, and junit-platform-engine is also on the
                                classpath through the module's root dependency (smoke test).
                            -->
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>org.eclipse.microprofile.config</groupId>
                    <artifactId>microprofile-config-tck</artifactId>
                    <version>${microprofile.config.version}</version>
                    <scope>test</scope>
                </dependency>

                <!-- Arquillian TestNG container — explicit version; the BOM aligns the transitive ones -->
                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                    <version>1.10.1.Final</version>
                    <scope>test</scope>
                </dependency>

                <!-- CDI container: embedded Weld SE (CDI 4.1, BCE compatible with ravel-cdi-vauban) -->
                <dependency>
                    <groupId>org.jboss.arquillian.container</groupId>
                    <artifactId>arquillian-weld-embedded</artifactId>
                    <version>4.0.0.Final</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.weld</groupId>
                    <artifactId>weld-core-impl</artifactId>
                    <version>6.0.2.Final</version>
                    <scope>test</scope>
                </dependency>

                <!-- TestNG runtime -->
                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
