    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
        <relativePath>../../../vidocq-parent/pom.xml</relativePath>
    </parent>

    <groupId>io.vidocq.ravel</groupId>
    <artifactId>ravel-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ravel</name>
    <description>MicroProfile Config 3.1 implementation: no third-party library, virtual threads, strict Java Modules</description>
    <url>https://codefloe.com/Vidocq/vidocq/src/branch/main/vidocq-components/vidocq-components-microprofile/ravel</url>

