    <scm>
        <url>https://codefloe.com/Vidocq/vidocq/src/branch/main/vidocq-components/vidocq-components-microprofile/ravel</url>
        <connection>scm:git:https://codefloe.com/Vidocq/vidocq.git</connection>
        <developerConnection>scm:git:ssh://git@codefloe.com/Vidocq/vidocq.git</developerConnection>
    </scm>

    <properties>
        <!-- MicroProfile Config spec — 3.1.1 adds Automatic-Module-Name (released 2026-04-22) -->
        <microprofile.config.version>3.1.1</microprofile.config.version>

        <!-- Jakarta specs (used by ravel-cdi-vauban only) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Upstream Vidocq — used by ravel-cdi-vauban -->
        <vauban.version>${project.version}</vauban.version>

        <!-- JMH for ravel-bench -->
        <jmh.version>1.37</jmh.version>

        <!--
            What the TCK workflow of the monorepo (.forgejo/workflows/tck-nightly.yml) runs for this
            component, from its folder: once a day, on demand and for a release. A pull request runs
            no TCK.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds ravel-tck to the reactor, and inside ravel-tck the
            `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset while
            reporting success — the vacuous gate this campaign exists to remove.

            Measured on a clean local repository (empty ~/.m2, the state of a CI runner): the
            official MicroProfile Config 3.1 TCK runs 378 tests in 3 s, all green, every artefact
            resolved from Maven Central.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl ravel-tck test</ci.tck.command>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            ravel-coverage (quality profile), so the tests of ravel-it-weld count for the code
            they exercise in the other modules.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/ravel-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <!--
        ravel-tck joins the reactor only under the `tck` profile (see <profiles>
        below) — TCK harmonisation, same pattern as the vidocq-runtime-tck-*
        runners and the dirac pilot: a plain `mvn install` neither downloads nor
        runs anything TCK-related. The historical out-of-reactor constraint
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0 POMs) disappeared with the
        Maven 3.9.16 / Model 4.0.0 migration.
    -->
    <modules>
        <module>ravel-api</module>
        <module>ravel-core</module>
        <module>ravel-cdi-vauban</module>
        <module>ravel-processor</module>
        <module>ravel-it-other-containers</module>
        <module>ravel-bench</module>
        <module>ravel-architecture-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--
                MicroProfile Config API — official Eclipse spec. Referenced
                directly only by 'ravel-mp-config-api', which repackages it with an
                explicit module-info (jlink compatibility). The other Ravel modules
                must depend on 'ravel-mp-config-api' instead.
            -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>

            <!-- MicroProfile Config API repackaged with an explicit module-info (jlink-ready) -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jakarta APIs (used by ravel-cdi-vauban only) -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Ravel internal modules -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <!--
          ravel-mp-config-api has no source of its own beyond its module descriptor: Maven unpacks its classes from the
          MicroProfile Config jar, which ships no module descriptor.
          IntelliJ would import it as an empty module and turn every module that depends on it red, so the
          IntelliJ import leaves it out of the reactor and resolves its jar like any other dependency.
          Only that import sets idea.maven.embedder.version: a Maven build, from a terminal or started from
          the IDE, is unchanged.
        -->
        <profile>
            <id>repackaged-api</id>
            <activation>
                <property>
                    <name>!idea.maven.embedder.version</name>
                </property>
            </activation>
            <modules>
                <module>ravel-mp-config-api</module>
            </modules>
        </profile>
        <!--
            TCK harmonisation: the official MicroProfile Config 3.1 TCK runner
            joins the reactor only when this profile is active.

                ./mvnw -Ptck -pl ravel-tck test                     # smoke
                ./mvnw -Ptck,tck-official -pl ravel-tck test        # full suite

            run-official-tck-mp-config-3.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>ravel-tck</module>
            </modules>
        </profile>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>ravel-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
