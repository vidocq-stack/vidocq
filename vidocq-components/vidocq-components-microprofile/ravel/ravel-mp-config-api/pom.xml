<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.ravel</groupId>
        <artifactId>ravel-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>ravel-mp-config-api</artifactId>
    <name>Ravel :: MicroProfile Config API (modular)</name>
    <description>
        org.eclipse.microprofile.config:microprofile-config-api repackaged with an explicit
        module-info.class (module org.eclipse.microprofile.config). The official API ships only an
        Automatic-Module-Name, which keeps it out of a jlink image. This artifact is the only source
        of the MP Config spec for the Ravel modules (ravel-api, ravel-core, ravel-bench); the
        official TCK keeps the original API.
    </description>

    <dependencies>
        <!--
            The official spec is fetched as 'provided' only so that its .class files
            can be unpacked into target/classes; it is not exposed
            transitively to consumers, who receive instead the repackaged jar
            with its explicit module-info.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1) Unpacks the .class files of microprofile-config-api into target/classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-microprofile-config-api</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.microprofile.config</groupId>
                                    <artifactId>microprofile-config-api</artifactId>
                                    <version>${microprofile.config.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <!--
                                        The original manifest and Maven metadata are excluded;
                                        maven-jar-plugin writes a clean manifest for
                                        our artifact (without Automatic-Module-Name, now
                                        redundant: the module is explicit).

                                        META-INF/LICENSE and META-INF/NOTICE are
                                        deliberately NOT excluded: the unpacked .class files
                                        stay under Apache-2.0, whose sections 4(a) and
                                        4(d) require the upstream license and NOTICE
                                        to accompany any redistribution.
                                    -->
                                    <excludes>META-INF/MANIFEST.MF,META-INF/maven/**</excludes>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                2) Compiles only our src/main/java/module-info.java, patching it
                   into the module 'org.eclipse.microprofile.config' (the .class files
                   unpacked above provide the exported packages).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>--patch-module</arg>
                        <arg>org.eclipse.microprofile.config=${project.build.outputDirectory}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

