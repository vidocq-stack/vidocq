    <properties>
        <!--
            MicroProfile Health API 4.0.1 - Vidocq fork with module-info
            for Java Modules/jlink. The upstream version is kept for reference.
        -->
        <microprofile.health.api.version>${project.version}</microprofile.health.api.version>
        <microprofile.health.upstream.version>4.0.1</microprofile.health.upstream.version>

        <!-- Jakarta JSON-P - implementation provided by champollion -->
        <jakarta.json.version>2.1.3</jakarta.json.version>

        <!-- Jakarta REST - implementation provided by Cassini -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- CDI -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Vidocq upstreams (referenced via properties to allow cross-repo PR overrides) -->
        <vauban.version>${project.version}</vauban.version>
        <champollion.version>${project.version}</champollion.version>
        <cassini.version>${project.version}</cassini.version>

        <!--
            What the TCK workflow of the monorepo (.forgejo/workflows/tck-nightly.yml) runs for this
            component, from its folder: once a day, on demand and for a release. A pull request runs
            no TCK.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds knock-tck to the reactor, and inside knock-tck the
            `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset while
            reporting success — the vacuous gate this campaign exists to remove.

            This became possible only once knock-tck stopped depending on io.vidocq.cassini:
            cassini-tck, which is published nowhere, and took the harness from the published
            cassini-testing instead (Vidocq/cassini#36). Measured against a clean local repository,
            the state of a CI runner, the suite previously failed in one second on an unresolvable
            artefact — it had never run outside a developer machine.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl knock-tck test</ci.tck.command>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            knock-coverage (quality profile), so the tests of knock-it-weld count for the code
            they exercise in the other modules.
        -->
        <!-- The component's aggregate report, from a build at the monorepo root, then from a build in this folder
             (maven.multiModuleProjectDirectory is the nearest .mvn), then the module's own report. The scanner
             skips a path that does not exist. -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/vidocq-components/vidocq-components-microprofile/knock/knock-coverage/target/site/jacoco-aggregate/jacoco.xml,${maven.multiModuleProjectDirectory}/knock-coverage/target/site/jacoco-aggregate/jacoco.xml,target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <!--
        Main reactor modules. knock-tck joins the reactor only under the `tck`
        Maven profile (see <profiles> below) — TCK harmonisation, same pattern
        as the vidocq-runtime-tck-* runners: a regular `mvn install` neither
        builds nor downloads the TCK harness. The historical reason for keeping
        TCK runners out of the reactor (ShrinkWrap Maven Resolver 3.3 unable to
        parse Model 4.1.0 POMs) is obsolete since the Maven 3.9.16 /
        Model 4.0.0 migration.
        Activation: ./mvnw -Ptck,tck-official -pl knock-tck test
        (or through run-official-tck-mp-health-4.0.sh).
    -->
    <modules>
        <module>knock-api</module>
        <module>knock-core</module>
        <module>knock-cdi-vauban</module>
        <module>knock-jaxrs</module>
        <module>knock-it-other-containers</module>
        <module>knock-architecture-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Health API (Vidocq fork with module-info) -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-mp-health-api</artifactId>
                <version>${microprofile.health.api.version}</version>
            </dependency>

            <!-- Jakarta JSON-P (implementation: champollion) -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>

            <!-- Jakarta REST (implementation: Cassini) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Runtime implementations (Vidocq) - versions via properties so
                 the cross-repo PR mechanism can override them. -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Internal Knock modules -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <profiles>
        <!--
          knock-mp-health-api has no source of its own beyond its module descriptor: Maven unpacks its classes from the
          MicroProfile Health jar, which ships no module descriptor.
          IntelliJ would import it as an empty module and turn every module that depends on it red, so the
          IntelliJ import leaves it out of the reactor and resolves its jar like any other dependency.
          Only that import sets idea.maven.embedder.version: a Maven build, from a terminal or started from
          the IDE, is unchanged.
        -->
        <profile>
            <id>repackaged-api</id>
            <activation>
                <property>
                    <name>!idea.maven.embedder.version</name>
                </property>
            </activation>
            <modules>
                <module>knock-mp-health-api</module>
            </modules>
        </profile>
        <!--
            TCK profile: pulls the knock-tck runner into the reactor.
            Kept behind a profile so a regular build never downloads nor runs
            the official MicroProfile Health 4.0 TCK harness.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>knock-tck</module>
            </modules>
        </profile>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>knock-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
