<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.kerckhoffs</groupId>
        <artifactId>kerckhoffs-parent</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>kerckhoffs-core</artifactId>
    <name>Kerckhoffs :: Core</name>
    <description>Jakarta Security 4.0 implementation — identity stores, HTTP authentication mechanisms and SecurityContext (see PLAN.md)</description>

    <dependencies>
        <!-- The implemented spec: compile scope, reaches applications transitively. -->
        <dependency>
            <groupId>jakarta.security.enterprise</groupId>
            <artifactId>jakarta.security.enterprise-api</artifactId>
        </dependency>
        <!-- Platform APIs: provided (scope from dependencyManagement) — the container brings them. -->
        <dependency>
            <groupId>jakarta.authentication</groupId>
            <artifactId>jakarta.authentication-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.peano</groupId>
            <artifactId>peano-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Test-only: the test bean an expression calls lives in this module; in an application it lives
                         in the module of the application, which the expression engine reads. -->
                    <argLine>
                        @{argLine}
                        --add-exports io.vidocq.kerckhoffs.core/io.vidocq.kerckhoffs.core.internal.expression=jakarta.el
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
