<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-dirac-metrics-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Metrics (Dirac)</name>
    <description>Maven/Java Modules wrapper activating Dirac (MicroProfile Metrics 5.1) in a vidocq deployment.
        No own Java class — the integration relies on dirac-cdi-vauban's BuildCompatibleExtension
        (discovery of @Counted/@Timed/@Gauge + @ApplicationScoped MetricRegistry producers) and the
        JAX-RS @Path scanning of CassiniExtension, which auto-mounts MetricsResource (@Path("/metrics")).
        Mirrors vidocq-runtime-knock-health-extension (ADR-002 in the knock repo).</description>

    <!--
        Like knock-extension, this is intentionally a *wrapper*, not a VidocqExtension. Dirac is
        zero-config and integrates 100% via standard SPIs (CDI 4.1 BCE + JAX-RS @Path scanning).
        Any vidocq-specific logic must live in a separate module to keep Dirac portable.
    -->

    <dependencies>
        <!--
            Dirac — MicroProfile Metrics 5.1 implementation (zero third-party lib).
            dirac-cdi-vauban ships the BCE that discovers @Counted/@Timed/@Gauge and produces the
            @ApplicationScoped MetricRegistry beans (APPLICATION/BASE/VENDOR). dirac-rest ships the
            JAX-RS MetricsResource (@Path("/metrics")) + its Vauban index so it is discoverable.
        -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-rest</artifactId>
            <version>${dirac.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-cdi-vauban</artifactId>
            <version>${dirac.version}</version>
        </dependency>

        <!--
            champollion-jsonp : runtime jakarta.json (JSON-P) implementation used by dirac-core's
            JsonMetricsFormatter when a client requests application/json from /metrics.
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            The Cassini REST extension is required so MetricsResource (@Path("/metrics")) is mounted
            on the HTTP engine — it queries VaubanBeanProvider.getResourceClasses() at startup.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is brought transitively by dirac-rest -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Both release and snapshot profiles (declared in vidocq-parent) call
            maven-javadoc-plugin:jar. This module has no src/main/java — only
            src/main/module-info/module-info.java. Override the sourcepath in both
            profiles so javadoc processes the module declaration and produces a
            non-empty javadoc jar (required by Maven Central validation).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>snapshot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                Java Modules workaround identical to knock-extension. dirac.api requires transitive
                microprofile.metrics.api (a named module via dirac-mp-metrics-api); to let the
                wrapper's module-info resolve the full dirac graph, copy all compile deps to
                target/javamodules/ and pass an explicit module-path to javac.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
