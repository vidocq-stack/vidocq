<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-dirac-metrics-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Metrics (Dirac)</name>
    <description>Maven/Java Modules wrapper activating Dirac (MicroProfile Metrics 5.1) in a vidocq deployment.
        The integration relies on dirac-cdi-vauban's BuildCompatibleExtension (discovery of
        @Counted/@Timed/@Gauge + @ApplicationScoped MetricRegistry producers) and the JAX-RS @Path
        scanning of CassiniExtension, which auto-mounts MetricsResource (@Path("/metrics")). Its one
        Java class, DiracMetricsExtension, only reads the registries for the startup report and the
        metrics panel of the dev console.</description>

    <!--
        Like knock-extension, the integration itself needs no Vidocq code: Dirac is zero-config and
        integrates 100% via standard SPIs (CDI 4.1 BCE + JAX-RS @Path scanning). The one VidocqExtension
        of this module, DiracMetricsExtension (Vidocq/vidocq#115), only reads what Dirac publishes, for the
        startup report and the dev console: Vidocq-specific code lives here, so that Dirac stays portable.
    -->

    <dependencies>
        <!--
            Dirac — MicroProfile Metrics 5.1 implementation (zero third-party lib).
            dirac-cdi-vauban ships the BCE that discovers @Counted/@Timed/@Gauge and produces the
            @ApplicationScoped MetricRegistry beans (APPLICATION/BASE/VENDOR). dirac-rest ships the
            JAX-RS MetricsResource (@Path("/metrics")) + its Vauban index so it is discoverable.
        -->
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-rest</artifactId>
            <version>${dirac.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-cdi-vauban</artifactId>
            <version>${dirac.version}</version>
        </dependency>

        <!--
            champollion-jsonp : runtime jakarta.json (JSON-P) implementation used by dirac-core's
            JsonMetricsFormatter when a client requests application/json from /metrics.
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            The Cassini REST extension is required so MetricsResource (@Path("/metrics")) is mounted
            on the HTTP engine — it queries VaubanBeanProvider.getResourceClasses() at startup.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>

        <!--
            The metrics panel of the dev console (DiracMetricsExtension, Vidocq/vidocq#115): the extension SPI
            and the dev console SPI it implements.
        -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is brought transitively by dirac-rest -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java Modules workaround identical to knock-extension. dirac.api requires transitive
                microprofile.metrics.api (a named module via dirac-mp-metrics-api); to let the
                wrapper's module-info resolve the full dirac graph, copy all compile deps to
                target/javamodules/ and pass an explicit module-path to javac.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- copy-compile-deps-to-module-path: managed by vidocq-parent. -->
                    <execution>
                        <id>copy-test-deps-to-module-path</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Same pattern as cervantes-jwt-extension: the module-info lives in src/main/module-info and is
                compiled at prepare-package, so target/classes holds no module-info.class during test-compile
                and the tests run on the class path. Remove a stale one before test-compile.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/module-info.class" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
