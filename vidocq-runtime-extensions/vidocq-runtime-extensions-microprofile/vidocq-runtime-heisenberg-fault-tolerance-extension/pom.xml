<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-heisenberg-fault-tolerance-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Fault Tolerance (Heisenberg)</name>
    <description>Maven/JPMS wrapper activating Heisenberg (MicroProfile Fault Tolerance 4.1) in a
        vidocq deployment. No own Java class — the integration relies entirely on
        heisenberg-cdi-vauban's BuildCompatibleExtension (discovery of @Retry/@Timeout/
        @CircuitBreaker/@Bulkhead/@Fallback/@Asynchronous and registration of the fault-tolerance
        interceptors). Mirrors vidocq-runtime-dirac-metrics-extension / knock-health-extension.</description>

    <!--
        Like the dirac/knock wrappers, this is intentionally a *wrapper*, not a VidocqExtension.
        Heisenberg is zero-config and integrates 100% via standard SPIs (CDI 4.1 BCE). Fault
        Tolerance is enforced by CDI interceptors only — there is no JAX-RS endpoint to mount, so
        (unlike dirac/knock) this wrapper does NOT depend on the Cassini REST extension.

        §9 metrics (Dirac) and §10 telemetry (Humboldt) integration inside heisenberg-cdi-vauban is
        wired through OPTIONAL `requires static` module edges: the FaultTolerance metrics/telemetry
        recorders only activate when those extensions are ALSO present on the module path. This
        wrapper therefore stays minimal and does not force metrics/telemetry onto FT-only apps.
    -->

    <dependencies>
        <!--
            Heisenberg — MicroProfile Fault Tolerance 4.1 implementation.
            heisenberg-cdi-vauban ships the BuildCompatibleExtension (HeisenbergExtension) that
            discovers the fault-tolerance annotations and registers FaultToleranceInterceptor +
            FaultTolerancePriority3850Interceptor + the state registries. It brings heisenberg-core,
            heisenberg-api and the repackaged microprofile-fault-tolerance-api spec module
            transitively.
        -->
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-cdi-vauban</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Both release and snapshot profiles (declared in vidocq-parent) call
            maven-javadoc-plugin:jar. This module has no src/main/java — only
            src/main/module-info/module-info.java. Override the sourcepath in both
            profiles so javadoc processes the module declaration and produces a
            non-empty javadoc jar (required by Maven Central validation).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>snapshot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                JPMS workaround identical to dirac-extension. heisenberg.api requires transitive
                microprofile.fault.tolerance.api (a named module); to let the wrapper's module-info
                resolve the full Heisenberg graph, copy all compile deps to target/javamodules/
                (inherited copy-dependencies execution from vidocq-parent) and pass an explicit
                module-path to javac.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
