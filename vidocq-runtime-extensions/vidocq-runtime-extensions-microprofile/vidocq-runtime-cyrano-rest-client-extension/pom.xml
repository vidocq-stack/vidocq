<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>vidocq-runtime-cyrano-rest-client-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Rest Client (Cyrano)</name>
    <description>Wrapper Maven/Java Modules qui active Cyrano (MicroProfile Rest Client 4.0) dans un deploiement vidocq.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-cdi-vauban</artifactId>
        </dependency>

        <!--
            The MP Rest Client spec types come from cyrano's JPMS repackage
            (cyrano-mp-rest-client-api, transitive through cyrano-core) — the
            sole modular source of the spec (workspace jlink-ready rule). The
            plain spec jar must NOT be declared here: both jars carry the same
            packages, a JPMS split that stayed latent until an automatic module
            (org.reactivestreams, cyrano SSE) joined the module path and
            started reading every observable module.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- copy-compile-deps-to-module-path: managed by vidocq-parent. -->
                    <execution>
                        <id>copy-test-deps-to-module-path</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Le pattern `src/main/module-info` separe maintient `target/classes`
                sans `module-info.class` pendant `test-compile`, ce qui evite que
                maven-compiler-plugin 4.x ne bascule en mode patch-module et n'exige
                la resolution Java Modules de `microprofile.rest.client.api` (jar sans
                Automatic-Module-Name place sur classpath, donc introuvable cote
                module-path). `compile-module-info` (phase prepare-package) ecrit
                ensuite `module-info.class` dans `target/classes` pour le packaging,
                ce qui pollue la sortie pour un eventuel second `mvn` sans `clean`
                (ex : CI Forgejo qui chaine `mvn verify` puis `mvn deploy`).
                On supprime donc cet artefact avant chaque `test-compile`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/module-info.class" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

