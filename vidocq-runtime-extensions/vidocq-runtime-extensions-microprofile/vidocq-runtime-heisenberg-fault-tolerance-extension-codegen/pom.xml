<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-heisenberg-fault-tolerance-extension-codegen</artifactId>
    <packaging>jar</packaging>
    <name>Vidocq :: MicroProfile Extensions :: Fault Tolerance (Heisenberg) :: Codegen Bundle</name>
    <description>
        Companion codegen bundle for vidocq-runtime-heisenberg-fault-tolerance-extension.
        Declare this artifact in &lt;annotationProcessorPaths&gt; whenever the
        application depends on the Fault Tolerance extension; Maven resolves the
        transitive APT dependencies below automatically.
        Runs Heisenberg's processor on the application's classes: each bean whose methods
        carry @Retry, @Timeout, @CircuitBreaker, @Bulkhead, @Fallback or @Asynchronous
        gets a $$HeisenbergPolicies companion holding them, so the runtime reads them
        without reflection (vidocq-workspace#38).
    </description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-processor</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>
        <!-- HeisenbergExtension, the Build Compatible Extension that binds the Fault Tolerance interceptor: on the
             processor path, vauban-processor runs it at build time, as the Ravel bundle does with ravel-cdi-vauban.
             Without it Vauban warns that the extension is on the module path only and will not run at build time. -->
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-cdi-vauban</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>
        <!-- heisenberg-cdi-vauban leaves the CDI API to the runtime (excluded, BUG-006 of Heisenberg): on the
             processor path nothing else brings it, and HeisenbergExtension could not be loaded. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Only the empty module-info to compile: no processor, not even the
                         inherited core-codegen path, which for core-codegen is this artifact. -->
                    <proc>none</proc>
                    <annotationProcessorPaths combine.self="override" />
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
