<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-knock-health-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Health (Knock)</name>
    <description>Maven/Java Modules wrapper activating Knock (MicroProfile Health 4.0) in a vidocq deployment.
        The integration relies on knock-cdi-vauban's CDI integration (discovery of
        @Liveness/@Readiness/@Startup) and the JAX-RS @Path scanning of CassiniExtension, which auto-mounts
        KnockHealthResource (@Path("/health")). Its one Java class, KnockHealthExtension, only reads the
        registry for the startup report and the health panel of the dev console. See docs/adr/ADR-002 in the
        knock repo.</description>

    <!--
        ADR-002 (knock repo): the integration itself needs no Vidocq code. Knock is zero-config and integrates
        100% via standard SPIs (CDI 4.1 BCE + JAX-RS @Path scanning). The one VidocqExtension of this module,
        KnockHealthExtension (Vidocq/vidocq#114), only reads what Knock keeps in memory, for the startup report
        and the dev console: Vidocq-specific code lives here, so that Knock stays portable.
    -->

    <dependencies>
        <!--
            Knock — MicroProfile Health 4.0 implementation (no third-party library).
            knock-cassini transitively pulls knock-core and knock-api.
            knock-cdi-vauban contains the BCE that auto-discovers @Liveness/@Readiness/@Startup.
        -->
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-jaxrs</artifactId>
            <version>${knock.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-cdi-vauban</artifactId>
            <version>${knock.version}</version>
        </dependency>

        <!--
            champollion-jsonp: runtime implementation of jakarta.json (JSON-P)
            used by knock-core to serialize HealthCheckResponse.
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            The Cassini REST extension is required for KnockHealthResource
            (@Path("/health")) to be mounted on the HTTP engine — it is the one that
            queries VaubanBeanProvider.getResourceClasses() at startup.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>

        <!--
            KnockHealthExtension (Vidocq/vidocq#114): the extension SPI it implements. Its live panel of the
            dev console moved to the vidocq-runtime-knock-health-extension-dev companion (Vidocq/vidocq#143),
            so this module no longer depends on the dev console SPI.
        -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is pulled transitively by knock-cassini -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Test only (Vidocq/vidocq#143): CheckKeysTest checks that CheckKeys.allocate produces a key the dev
            console accepts, via PanelSample.requireKey. A dev-only dependency outside test scope would get a
            checkpom warning; here it is test scope, which the tool accepts.
        -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java Modules workaround identical to knock-core / knock-parent (ADR-001 of the knock repo).

                microprofile-health-api:4.0.1 has no Automatic-Module-Name. For the
                module-info of this wrapper to `requires transitive io.vidocq.knock.api`
                (which itself `requires transitive microprofile.health.api`), javac must
                resolve `microprofile.health.api` by deriving it from the file name. We
                therefore copy all compile deps into target/javamodules/ and pass the
                module path explicitly to javac through a compilerArg.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Same pattern as cervantes-jwt-extension: the module-info lives in src/main/module-info and is
                compiled at prepare-package, so target/classes holds no module-info.class during test-compile
                and the tests run on the class path. Remove a stale one before test-compile.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/module-info.class" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

