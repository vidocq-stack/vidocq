<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-knock-health-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Health (Knock)</name>
    <description>Maven/Java Modules wrapper activating Knock (MicroProfile Health 4.0) in a vidocq deployment.
        The integration relies on knock-cdi-vauban's CDI integration (discovery of
        @Liveness/@Readiness/@Startup) and the JAX-RS @Path scanning of CassiniExtension, which auto-mounts
        KnockHealthResource (@Path("/health")). Its one Java class, KnockHealthExtension, only reads the
        registry for the startup report and the health panel of the dev console. See docs/adr/ADR-002 in the
        knock repo.</description>

    <!--
        ADR-002 (knock repo): the integration itself needs no Vidocq code. Knock is zero-config and integrates
        100% via standard SPIs (CDI 4.1 BCE + JAX-RS @Path scanning). The one VidocqExtension of this module,
        KnockHealthExtension (Vidocq/vidocq#114), only reads what Knock keeps in memory, for the startup report
        and the dev console: Vidocq-specific code lives here, so that Knock stays portable.
    -->

    <dependencies>
        <!--
            Knock — implémentation MicroProfile Health 4.0 (zéro lib tierce).
            knock-cassini tire transitivement knock-core et knock-api.
            knock-cdi-vauban contient la BCE qui auto-découvre @Liveness/@Readiness/@Startup.
        -->
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-jaxrs</artifactId>
            <version>${knock.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-cdi-vauban</artifactId>
            <version>${knock.version}</version>
        </dependency>

        <!--
            champollion-jsonp : implémentation runtime de jakarta.json (JSON-P)
            utilisée par knock-core pour sérialiser HealthCheckResponse.
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            L'extension REST Cassini est requise pour que KnockHealthResource
            (@Path("/health")) soit montée sur le moteur HTTP — c'est elle qui
            interroge VaubanBeanProvider.getResourceClasses() au démarrage.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>

        <!--
            The health panel of the dev console (KnockHealthExtension, Vidocq/vidocq#114): the extension SPI
            and the dev console SPI it implements.
        -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api est tiré transitivement par knock-cassini -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Workaround Java Modules identique à knock-core / knock-parent (ADR-001 du repo knock).

                microprofile-health-api:4.0.1 n'a pas d'Automatic-Module-Name. Pour que le
                module-info de ce wrapper puisse `requires transitive io.vidocq.knock.api`
                (qui lui-même `requires transitive microprofile.health.api`), javac doit
                résoudre `microprofile.health.api` par dérivation du nom de fichier. On
                copie donc toutes les deps compile dans target/javamodules/ et on passe
                explicitement le module-path à javac via un compilerArg.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- copy-compile-deps-to-module-path: managed by vidocq-parent. -->
                    <execution>
                        <id>copy-test-deps-to-module-path</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Same pattern as cervantes-jwt-extension: the module-info lives in src/main/module-info and is
                compiled at prepare-package, so target/classes holds no module-info.class during test-compile
                and the tests run on the class path. Remove a stale one before test-compile.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/module-info.class" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

