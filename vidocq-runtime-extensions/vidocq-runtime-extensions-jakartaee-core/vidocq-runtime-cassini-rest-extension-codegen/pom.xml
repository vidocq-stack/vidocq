<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-core</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
    <packaging>jar</packaging>
    <name>Vidocq :: Core Extensions :: REST (Cassini) :: Codegen Bundle</name>
    <description>
        Companion codegen bundle for vidocq-runtime-cassini-rest-extension.
        Declare this artifact in &lt;annotationProcessorPaths&gt; whenever the
        application depends on the REST extension; Maven resolves the transitive
        APT dependencies below automatically.

        Pre-generates &lt;Resource&gt;$$CassiniAdapter + $$CassiniRoutes at compile
        time (no runtime reflection, AOT-safe). Without this APT, AdapterRegistry
        falls back to RuntimeAdapterGenerator at the first request (JVM-only path
        with a Java Modules warning); functionally OK, but off the nominal codegen path
        documented in cassini/CLAUDE.md (M4).
    </description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-processor</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <!-- Cassini's build-compatible extension (CassiniScopeExtension): Vauban's processor runs it at
             compile time, and the runtime skips extensions the processor already ran. Without it here,
             @Path and @Provider classes without a scope get no default scope and are no beans. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi</artifactId>
            <version>${cassini.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Only the empty module-info to compile: no processor, not even the
                         inherited core-codegen path, which for core-codegen is this artifact. -->
                    <proc>none</proc>
                    <annotationProcessorPaths combine.self="override" />
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
