<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-core</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
    <name>Vidocq :: Core Extensions :: REST (Cassini)</name>
    <description>Extension Vidocq Runtime qui branche Cassini (Jakarta REST 4.0 standalone) sur le moteur HTTP Chappe via le SPI io.vidocq.cassini.spi.http</description>

    <dependencies>
        <!-- Cassini standalone — extrait avril 2026 vers io.vidocq.cassini.
             Le bootstrap passe par cassini-api (CassiniStack.builder), cassini-chappe
             (ChappeHttpAdapter) et cassini-cdi-vauban (BeanProvider).
             cassini-core est runtime-only : il fournit le BuilderFactory découvert
             par ServiceLoader, mais ses paquets internal/ ne sont exportés qu'au TCK. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <!-- compile scope: onStop() calls the CassiniMaintenance API (hot reload) -->
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
        </dependency>

        <!-- Vidocq Runtime SPI + Chappe extension. The live rest panel of the dev console moved to the
             vidocq-runtime-cassini-rest-extension-dev companion (Vidocq/vidocq#143), so this module no longer
             depends on the dev console SPI. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-chappe-webserver-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
