<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-core</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
    <name>Vidocq :: Core Extensions :: REST (Cassini)</name>
    <description>Vidocq Runtime extension that plugs Cassini (standalone Jakarta REST 4.0) into the Chappe HTTP engine through the io.vidocq.cassini.spi.http SPI</description>

    <dependencies>
        <!-- Cassini standalone — extracted in April 2026 to io.vidocq.cassini.
             Le bootstrap passe par cassini-api (CassiniStack.builder), cassini-chappe
             (ChappeHttpAdapter) et cassini-cdi-vauban (BeanProvider).
             cassini-core is runtime-only: it provides the BuilderFactory discovered
             by ServiceLoader, but its internal/ packages are exported only to the TCK. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <!-- compile scope: onStop() calls the CassiniMaintenance API (hot reload) -->
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
        </dependency>

        <!-- Vidocq Runtime SPI + Chappe extension. The live rest panel of the dev console moved to the
             vidocq-runtime-cassini-rest-extension-dev companion (Vidocq/vidocq#143), so this module no longer
             depends on the dev console SPI. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-chappe-webserver-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- Cassini reads and writes JSON through the JSON-B and JSON-P APIs only
             (vidocq-workspace#17). The extension assembles the runtime, so it picks the
             implementation: Champollion (champollion-jsonb brings champollion-jsonp). Compile scope, and
             read transitively by the application: the JSON-B bindings champollion-codegen-apt generates in it
             implement io.vidocq.champollion.jsonb.spi.JsonbBinding. -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <version>${champollion.version}</version>
        </dependency>
        <!-- The CDI side of JSON-B: the registry that hands the generated bindings and the runtime the container's
             adapters, serializers and deserializers (one per container, destroyed when it stops), and the build
             compatible extension that validates them. -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb-cdi</artifactId>
            <version>${champollion.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
