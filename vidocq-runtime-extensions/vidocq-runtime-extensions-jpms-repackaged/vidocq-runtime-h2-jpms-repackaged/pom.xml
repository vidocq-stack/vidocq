<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jpms.repackaged</groupId>
        <artifactId>vidocq-runtime-extensions-jpms-repackaged</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <!-- Inherits groupId io.vidocq.runtime.extensions.jpms.repackaged from the parent aggregator:
         the ".jpms.repackaged" namespace already signals that this artifact bundles third-party
         (H2) bytecode rather than Vidocq-authored code. Only module-info.java is contributed by
         Vidocq; every other class is H2's, under its own license (see below). -->
    <artifactId>vidocq-runtime-h2-jpms-repackaged</artifactId>
    <name>Vidocq :: Third-party :: H2 (JPMS repackaged)</name>
    <description>
        Verbatim repackage of com.h2database:h2 with an added explicit module-info.class (module
        name: com.h2database, generated with `jdeps --generate-module-info`). The official artifact
        only declares Automatic-Module-Name, which jlink rejects — this turns it into an explicit
        JPMS module WITHOUT modifying any H2 class, so runtimes/examples embedding H2 can be
        jlink'd / jpackage'd. The H2 class files retain their original license (MPL 2.0 / EPL 1.0);
        only the added module-info.java is Vidocq's, under the project license.
    </description>

    <!--
        License of the BUNDLED H2 class files. H2 is dual-licensed; we redistribute under these
        terms unchanged. The added module-info.java is separately licensed under the Vidocq
        project license (EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later) — see META-INF/NOTICE.txt.
    -->
    <licenses>
        <license>
            <name>MPL 2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
            <distribution>repo</distribution>
            <comments>Mozilla Public License 2.0 — license of the bundled H2 Database Engine.</comments>
        </license>
        <license>
            <name>EPL 1.0</name>
            <url>https://www.eclipse.org/legal/epl-v10.html</url>
            <distribution>repo</distribution>
            <comments>Eclipse Public License 1.0 — alternative license of the bundled H2 Database Engine.</comments>
        </license>
    </licenses>

    <properties>
        <h2.version>2.3.232</h2.version>
        <!-- This module ships third-party bytecode, not Vidocq source: no source/javadoc jars.
             Central refuses artifacts without sources/javadoc, so publishing is skipped too —
             the whole bundle would be rejected otherwise (seen on mansart-data-external-it).
             To release it later: attach stub sources/javadoc jars, then drop these skips. -->
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <!--
            The official jar is pulled in 'provided' only so its .class files can be unpacked
            into target/classes. It is NOT exposed transitively: consumers depend on this module
            instead and receive the repackaged jar carrying the explicit module-info.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1) Unpack the H2 .class files (base release) into target/classes. The
                 META-INF/versions/** overrides are dropped so a single root module-info governs;
                 the base classes are a complete, runnable set on Java 25. The original
                 META-INF/services/java.sql.Driver is preserved. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- Neutralize the copy-compile-deps-to-module-path execution managed by
                         vidocq-parent: this module uses the dependency plugin to unpack h2,
                         it does not need a javamodules copy. -->
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>unpack-h2</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.h2database</groupId>
                                    <artifactId>h2</artifactId>
                                    <version>${h2.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <!-- Drop the original manifest (Automatic-Module-Name is now
                                         superfluous), the Maven metadata, and the multi-release
                                         overrides. maven-jar-plugin rewrites a clean manifest. Our
                                         own LICENSE/NOTICE under src/main/resources/META-INF are
                                         copied afterwards by maven-resources. -->
                                    <excludes>META-INF/MANIFEST.MF,META-INF/maven/**,META-INF/versions/**</excludes>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2) Compile only our module-info.java, patched into the 'com.h2database' module
                 (the unpacked .class files above supply every exported package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs combine.children="append">
                        <arg>--patch-module</arg>
                        <arg>com.h2database=${project.build.outputDirectory}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
                    <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
