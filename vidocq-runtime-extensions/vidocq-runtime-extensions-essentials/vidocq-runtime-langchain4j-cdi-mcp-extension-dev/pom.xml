<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.essentials</groupId>
        <artifactId>vidocq-runtime-extensions-essentials</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension-dev</artifactId>
    <name>Vidocq :: Extensions :: Essentials :: langchain4j-cdi MCP server :: dev console panel</name>
    <description>The live mcp panel of the dev console, and its MCP inspector. Only vidocq:dev adds it; no binary
        contains it (Vidocq/vidocq#143).</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
        </dependency>
        <!-- The MCP inspector reads and writes JSON-RPC with JSON-P, which the runtime extension already brings. -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Vidocq/vidocq#143: a dev tool; vidocq:dev adds it, no binary ever contains it. -->
                            <Vidocq-Dev-Only>true</Vidocq-Dev-Only>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
                module-info.java lives in the standard src/main/java, so it compiles normally. Surefire still
                must not fork on the module path: with no module descriptor of its own, the test sources would
                need every dependency module explicitly, which the reactor does not resolve here. Same pattern
                as every other -dev module of Vidocq/vidocq#143 (Tasks 7-11).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <!--
                StubMcp (Vidocq/vidocq#143, Task 7) opens a com.sun.net.httpserver.HttpServer to stand in for the
                application's /mcp. Because src/main/java carries a module-info.java, the compiler plugin patches
                the test sources into that module for testCompile, so the module itself - not the unnamed module -
                needs a readability edge to the JDK's own jdk.httpserver module; this is test-only, so it is added
                here rather than as a module-info.java requires.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <!-- jdk.httpserver is not on any module's requires graph here, so it must also be
                                     added as a root module before an add-reads edge to it resolves. -->
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.runtime.extensions.essentials.langchain4jcdi.mcp.dev=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
