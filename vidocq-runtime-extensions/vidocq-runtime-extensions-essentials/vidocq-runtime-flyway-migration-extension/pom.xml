<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.runtime.extensions.essentials</groupId>
        <artifactId>vidocq-runtime-extensions-essentials</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>vidocq-runtime-flyway-migration-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Flyway Schema Migration Backend</name>
    <description>Flyway-backed SchemaMigrator — opt-in extension for vidocq-runtime-migration-extension.
        Bring this module onto the module path to activate Flyway migrations at boot.</description>
    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-migration-extension</artifactId>
        </dependency>
        <!-- For the tests only: MigrationPanelH2Test drives the -dev module's live panel and actions, since
             the runtime extension itself no longer implements them (Vidocq/vidocq#143). -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-migration-extension-dev</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Bundled (NOT optional): module-info requires flyway.database.postgresql, so consumers must
             get it transitively, otherwise the flyway extension fails module-path resolution at boot
             (FindException). Tiny Flyway plugin jar; harmless for H2-only apps. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- For the tests only: the child JVM of LayeredMigrationProcessTest installs the application
             layer and publishes it as Vidocq does (VidocqAppLayer, InstalledApplicationLayer). -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JDBC driver needed at test runtime for the Postgres IT (Flyway's
             flyway-database-postgresql plugin only contains the strategy, not the driver). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.10</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Flyway scans classpath: locations and resolves the H2 driver more predictably
                 off the module path in tests — keep useModulePath=false for the test phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- Also pick up *IT.java so the Docker-gated Postgres IT runs
                         under the test phase (it self-skips when Docker is absent). -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
