<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.runtime.extensions.essentials</groupId>
        <artifactId>vidocq-runtime-extensions-essentials</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>vidocq-runtime-crac-extension</artifactId>
    <name>Vidocq :: Core Extensions :: CRaC</name>
    <description>Suspends the Suspendable bricks before a CRaC checkpoint and resumes them after a restore. The only
        module that requires jdk.crac: built with a CRaC JDK, in the crac profile of the essentials aggregator.</description>
    <properties>
        <!-- jdk.crac is not in the release 25 API signature: compile against the JDK itself. -->
        <maven.compiler.release/>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Its release defaults to ${maven.compiler.release}, empty here, which maven-javadoc-plugin
                         3.11.2 cannot parse ("Index 0 out of bounds"): no release, javadoc takes the source level. -->
                    <release combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
