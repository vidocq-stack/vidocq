<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-mansart-pool-datasources-codegen</artifactId>
    <name>Vidocq :: Core Extensions :: Mansart Pool :: Named Datasources Codegen</name>
    <description>
        APT processor generating a @Named @Singleton DataSource holder per named datasource, from
        @VidocqDataSources and from vidocq.pool.&lt;name&gt;.url keys in vidocq.properties /
        application.properties. OPTIONAL: declare this artifact in &lt;annotationProcessorPaths&gt;
        only when an application actually uses named datasources (multi-datasource) with the Mansart
        pool extension. Deliberately NOT named "*-extension-codegen": unlike the cassini / mansart-data
        codegens it is not a mandatory companion of the extension, so the checkpom must not force every
        pool consumer to declare it. Requires only java.compiler — emits plain Java sources.
    </description>

    <dependencies>
        <!-- The processor itself has no runtime dependency (it reads the annotation via mirrors and
             emits text). The extension is needed only by the tests to compile sample sources that
             reference @VidocqDataSources and AbstractNamedDataSourceHolder. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <!-- The processor test runs an in-process javac and collects the build classpath
                     from java.class.path. Force the test onto the classpath (not the module path)
                     so java.class.path is complete and the sample can resolve @VidocqDataSources and
                     AbstractNamedDataSourceHolder deterministically (regardless of -am vs M2). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
