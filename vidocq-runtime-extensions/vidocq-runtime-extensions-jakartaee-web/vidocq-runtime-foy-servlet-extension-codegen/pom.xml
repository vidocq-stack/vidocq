<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <artifactId>vidocq-runtime-foy-servlet-extension-codegen</artifactId>
    <packaging>jar</packaging>
    <name>Vidocq :: Web Extensions :: Servlet (Foy) :: Codegen Bundle</name>
    <description>
        Companion codegen bundle for vidocq-runtime-foy-servlet-extension.
        Declare this artifact in &lt;annotationProcessorPaths&gt; whenever the
        application depends on the Servlet extension. foy-processor generates the
        web component factories ($$FoyComponent); foy-cdi-vauban carries the
        build-compatible extensions that Vauban's processor must run at compile
        time: FoyWebExtension (web components as beans) and, through
        vauban-webcontexts, the session context.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-cdi-vauban</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Only the empty module-info to compile: no processor, not even the
                         inherited core-codegen path, which for core-codegen is this artifact. -->
                    <proc>none</proc>
                    <annotationProcessorPaths combine.self="override" />
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- The module is empty and does not read foy-processor: compile the test on the classpath. -->
                            <useModulePath>false</useModulePath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The module is empty and does not read foy-processor: run the test on the classpath. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
