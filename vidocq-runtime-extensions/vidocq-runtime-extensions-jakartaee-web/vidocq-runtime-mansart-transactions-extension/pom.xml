<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Mansart Transactions</name>
    <description>Wires Jakarta Transactions 2.0 (mansart-transactions) into the Vidocq lifecycle. The mansart-transactions-cdi BuildCompatibleExtension is auto-discovered by Vauban; this extension fails fast on boot if the TransactionManager bean is missing.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Mansart Transactions stack — pulled transitively so the application only needs to
             declare ONE dep (this extension) to get @Transactional + @TransactionScoped wired. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-cdi</artifactId>
            <version>${mansart.version}</version>
        </dependency>

        <!-- #97: mansart-data-cdi's JDBC-to-JTA bridge (ConnectionXAResource) only turns on when
             this jar can be loaded, and mansart-data-cdi declares it optional. Without it, every
             repository call takes its own autocommit connection: @Transactional still begins and
             rolls back a JTA transaction, but no connection was ever enlisted in it, so a write
             made before a thrown exception stays committed. Brought here, transitively, so that
             an application using @Transactional gets the bridge without knowing this jar exists. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-jdbc</artifactId>
            <version>${mansart.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
