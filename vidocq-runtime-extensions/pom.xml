<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <groupId>io.vidocq.runtime.extensions</groupId>
    <artifactId>vidocq-runtime-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Extensions</name>
    <description>Vidocq runtime extensions, grouped by domain</description>

    <modules>
        <module>vidocq-runtime-extensions-essentials</module>
        <module>vidocq-runtime-extensions-jakartaee-core</module>
        <module>vidocq-runtime-extensions-jakartaee-web</module>
        <module>vidocq-runtime-extensions-microprofile</module>
        <module>vidocq-runtime-extensions-jpms-repackaged</module>
    </modules>

    <build>
        <plugins>
            <!-- Inherits the execution from vidocq-runtime-parent/pluginManagement.
                 Re-declaring the <plugin> here (without restating <executions>) is
                 enough to *activate* the bound checkpom execution on every child. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        vidocq-runtime-cassini-rest-extension (Jersey 4 + Jetty 12) est décommissionné,
        remplacé par vidocq-runtime-cassini-rest-extension (runtime JAX-RS 4.0 natif
        sur Chappe).

        L'implémentation Servlet 6.1 a été extraite en avril 2026 vers le
        projet standalone Foy : https://forge.vidocq.dev/vidocq/foy
        (groupId io.vidocq.foy ; modules foy-api, foy-core, foy-cdi-vauban,
        foy-chappe, foy-tck).

        Le module TCK runner Cassini est volontairement EN DEHORS du reactor
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0). Lancement :
          ./run-official-tck-restful-4.0.sh
    -->
</project>
