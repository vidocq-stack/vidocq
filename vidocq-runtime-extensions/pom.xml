<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <groupId>io.vidocq.runtime.extensions</groupId>
    <artifactId>vidocq-runtime-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Extensions</name>
    <description>Vidocq runtime extensions, grouped by domain</description>

    <modules>
        <module>vidocq-runtime-extensions-essentials</module>
        <module>vidocq-runtime-extensions-jakartaee-core</module>
        <module>vidocq-runtime-extensions-jakartaee-web</module>
        <module>vidocq-runtime-extensions-microprofile</module>
        <module>vidocq-runtime-extensions-module-repackaged</module>
    </modules>

    <build>
        <plugins>
            <!-- Inherits the execution from vidocq-runtime-parent/pluginManagement.
                 Re-declaring the <plugin> here (without restating <executions>) is
                 enough to *activate* the bound checkpom execution on every child. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        The former Jersey 4 + Jetty 12 REST extension is gone: vidocq-runtime-cassini-rest-extension
        now wraps Cassini, the native Jakarta REST 4.0 runtime on top of Chappe.

        The Jakarta Servlet 6.1 implementation was extracted in April 2026 into the standalone
        Foy project: https://codefloe.com/Vidocq/foy (groupId io.vidocq.foy; modules foy-api,
        foy-core, foy-cdi-vauban, foy-chappe, foy-tck).

        The Cassini TCK runner (cassini-tck) lives in the Cassini repository, not here. It joins
        the Cassini reactor only under the `tck` Maven profile. From the Cassini root:
          ./run-official-tck-restful-4.0.sh
        or ./mvnw -Ptck,tck-official -pl cassini-tck verify
    -->
</project>
