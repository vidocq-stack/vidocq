<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.runtime</groupId>
    <artifactId>vidocq-runtime-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Vidocq Runtime</name>
    <description>MicroProfile runtime built on Vauban CDI 4.1</description>
    <url>https://codeberg.org/Vidocq/vidocq</url>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/vidocq.git</connection>
        <developerConnection>scm:git:ssh://git@codeberg.org/Vidocq/vidocq.git</developerConnection>
        <url>https://codeberg.org/Vidocq/vidocq</url>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <properties>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <chappe.version>0.1.0-SNAPSHOT</chappe.version>
        <cassini.version>0.1.0-SNAPSHOT</cassini.version>
        <ravel.version>0.1.0-SNAPSHOT</ravel.version>
        <mansart.version>0.1.0-SNAPSHOT</mansart.version>
        <knock.version>0.1.0-SNAPSHOT</knock.version>
        <cyrano.version>0.1.0-SNAPSHOT</cyrano.version>
        <cervantes.version>0.1.0-SNAPSHOT</cervantes.version>
        <humboldt.version>0.1.0-SNAPSHOT</humboldt.version>
        <champollion.version>0.1.0-SNAPSHOT</champollion.version>
        <microprofile.config.version>3.1.1</microprofile.config.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <arquillian.version>1.8.0.Final</arquillian.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta CDI API -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>

            <!-- Jakarta Annotations -->
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Vauban -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-indexer</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Chappe HTTP server -->
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-api</artifactId>
                <version>${chappe.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-core</artifactId>
                <version>${chappe.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-http</artifactId>
                <version>${chappe.version}</version>
            </dependency>

            <!-- Ravel — MicroProfile Config 3.1 implementation -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-cdi-vauban</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- Cassini -->
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-api</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-cdi-vauban</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-chappe</artifactId>
                <version>${cassini.version}</version>
            </dependency>

            <!-- Cyrano — MicroProfile Rest Client 4.0 implementation -->
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-api</artifactId>
                <version>${cyrano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-core</artifactId>
                <version>${cyrano.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-cdi-vauban</artifactId>
                <version>${cyrano.version}</version>
            </dependency>

            <!-- Cervantes — MicroProfile JWT 2.1 implementation -->
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-mp-jwt-api</artifactId>
                <version>${cervantes.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-api</artifactId>
                <version>${cervantes.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-core</artifactId>
                <version>${cervantes.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-cdi-vauban</artifactId>
                <version>${cervantes.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-cassini</artifactId>
                <version>${cervantes.version}</version>
            </dependency>

            <!-- Humboldt — MicroProfile Telemetry 2.1 (tracing, metrics, logs) -->
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-runtime</artifactId>
                <version>${humboldt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-cdi</artifactId>
                <version>${humboldt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-rest</artifactId>
                <version>${humboldt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-trace</artifactId>
                <version>${humboldt.version}</version>
            </dependency>

            <!-- Vidocq modules -->
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-chappe-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-knock-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-cyrano-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-cervantes-jwt-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-humboldt-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-arquillian</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Arquillian BOM -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
