<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
    </parent>

    <artifactId>vidocq-runtime-examples</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Examples</name>
    <description>Example applications for Vidocq</description>

    <subprojects>
        <subproject>vidocq-runtime-external-rest-lib</subproject>
        <subproject>vidocq-runtime-cassini-rest-example</subproject>
        <subproject>vidocq-runtime-mansart-h2-example</subproject>
    </subprojects>

    <build>
        <plugins>
            <!-- Inherits the checkpom execution from vidocq-runtime-parent/pluginManagement. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
