<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-build</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-examples</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Examples</name>
    <description>Example applications for Vidocq</description>

    <properties>
        <!-- Example aggregator: never deployed to Maven Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <modules>
        <module>vidocq-runtime-external-rest-lib</module>
        <module>vidocq-runtime-cassini-rest-example</module>
        <module>vidocq-runtime-cyrano-rest-client-example</module>
        <module>vidocq-runtime-cervantes-jwt-example</module>
        <module>vidocq-runtime-knock-health-example</module>
        <module>vidocq-runtime-mansart-h2-example</module>
        <module>vidocq-runtime-petstore-example</module>
        <module>vidocq-runtime-foy-servlet-example</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
            <!-- Inherits the checkpom execution from vidocq-runtime-build/pluginManagement. test-path, bound as
                 vidocq-runtime-parent binds it: @VidocqTest starts the example on the jars a real application runs,
                 the copies vidocq:generate enriched included, not the originals Surefire resolved. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>vidocq-test-path</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>test-path</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- No default value in <properties>: the expression must stay unresolved until vidocq:test-path sets
                 it, as in vidocq-runtime-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <vidocq.test.runtimePath>${vidocq.test.runtimePath}</vidocq.test.runtimePath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
