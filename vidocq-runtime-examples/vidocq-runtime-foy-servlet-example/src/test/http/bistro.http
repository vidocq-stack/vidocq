// Vidocq Bistro — start BistroApp, then run these requests from IntelliJ.

### The menu
GET http://localhost:8080/

> {%
    client.test("menu answers 200 with a request id", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.headers.valueOf("X-Request-Id") !== null, "No X-Request-Id");
    });
%}

### Add a dish to the basket (the session cookie is kept between requests)
POST http://localhost:8080/basket
Content-Type: application/x-www-form-urlencoded

add=bourguignon

### The basket
GET http://localhost:8080/basket

> {%
    client.test("the basket holds the dish", function () {
        client.assert(response.body.indexOf("Beef bourguignon") >= 0, "Dish missing");
    });
%}

### Send the order to the kitchen
POST http://localhost:8080/basket
Content-Type: application/x-www-form-urlencoded

order=1

### The kitchen without signing in
GET http://localhost:8080/kitchen

> {%
    client.test("the kitchen shows the login form", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.indexOf("j_security_check") >= 0, "Expected the login form");
    });
%}

### Sign in as the chef (the client keeps the session cookie)
# @no-redirect
POST http://localhost:8080/j_security_check
Content-Type: application/x-www-form-urlencoded

j_username=chef&j_password=chef

> {%
    client.test("the login sends back to the kitchen", function () {
        client.assert(response.status === 302, "Expected 302, got " + response.status);
    });
%}

### The kitchen as the chef
GET http://localhost:8080/kitchen

> {%
    client.test("the chef sees the orders", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.indexOf("Signed in as <b>chef</b>") >= 0, "Expected the kitchen");
    });
%}

### Sign out
# @no-redirect
POST http://localhost:8080/logout

> {%
    client.test("the sign-out goes back to the menu", function () {
        client.assert(response.status === 303, "Expected 303, got " + response.status);
    });
%}
