<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-examples</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>vidocq-runtime-knock-health-example</artifactId>
    <name>Vidocq :: Examples :: Health (Knock)</name>
    <description>MicroProfile Health example — proves that knock-jaxrs works on the strict
        module path WITHOUT `opens … to io.vidocq.vauban.core`: KnockHealthResource is
        instantiated and field-injected in-module by a generated _VaubanComponents provider.
        A 200 on GET /api/health proves the @Inject HealthCheckRegistry field was written
        with zero reflection / zero opens.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>
        <!-- Health: pulls knock (api/core/cdi-vauban/jaxrs) transitively. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-knock-health-extension</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <version>3.0.1</version>
        </dependency>
        <!-- Yasson + Parsson at runtime for JSON-B (cassini may negotiate it). -->
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>3.0.4</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Brique D: weave the Cassini adapter into a SEALED copy of the impl-agnostic
                 knock-jaxrs wrapper (resource package closed, adapters published via
                 `provides ResourceAdapter/RouteProvider`). The jlink staging then prefers this
                 sealed copy, so the deployed JAX-RS wrapper needs no exports/opens. -->
            <plugin>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-maven-plugin</artifactId>
                <version>${cassini.version}</version>
                <executions>
                    <execution>
                        <id>seal-jaxrs-wrappers</id>
                        <phase>process-classes</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <scope>dependencies</scope>
                            <repackageModularDependencies>true</repackageModularDependencies>
                            <sealModules>true</sealModules>
                            <!-- Only seal the application's JAX-RS wrapper. cassini's own infra
                                 modules (e.g. cassini-cdi-vauban, which carries a BCE that vauban.core
                                 must read) must keep their exports. -->
                            <includeArtifacts>
                                <includeArtifact>io.vidocq.knock:knock-jaxrs</includeArtifact>
                            </includeArtifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Final packaging (jlink + jpackage + docker) — active by default. -->
        <profile>
            <id>dist</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.vidocq.runtime</groupId>
                        <artifactId>vidocq-runtime-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <mainModule>io.vidocq.runtime.examples.knock</mainModule>
                                    <mainClass>io.vidocq.runtime.examples.knock.KnockHealthExampleApp</mainClass>
                                    <launcher>knock-health-app</launcher>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage</id>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <mainModule>io.vidocq.runtime.examples.knock</mainModule>
                                    <mainClass>io.vidocq.runtime.examples.knock.KnockHealthExampleApp</mainClass>
                                    <appName>knock-health-app</appName>
                                    <appVersion>1.0.0</appVersion>
                                    <type>app-image</type>
                                </configuration>
                            </execution>
                            <execution>
                                <id>docker</id>
                                <goals>
                                    <goal>docker</goal>
                                </goals>
                                <configuration>
                                    <launcher>knock-health-app</launcher>
                                    <imageTag>vidocq/knock-health-app:0.3.0-SNAPSHOT</imageTag>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
