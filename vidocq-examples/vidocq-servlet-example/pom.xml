<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mpserver</groupId>
        <artifactId>vidocq-examples</artifactId>
    </parent>

    <artifactId>vidocq-servlet-example</artifactId>
    <name>Vidocq :: Examples :: Servlet (Chappe)</name>
    <description>Servlet 6.1 example on top of Chappe</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-chappe-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-servlet-chappe-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.vidocq.mpserver</groupId>
                <artifactId>vidocq-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
