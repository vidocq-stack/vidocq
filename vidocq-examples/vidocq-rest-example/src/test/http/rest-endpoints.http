// ### Vidocq REST Example — Tests des endpoints
// ### Lancer RestExampleApp puis executer ces requetes depuis IntelliJ
### HelloSimpleJaxRSResource (@Path sans scope CDI — enrichi par BCE)
GET http://localhost:8080/hello-simple-jaxrs
Accept: text/plain

> {%
    client.test("should return 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("should contain response text", function() {
        client.assert(response.body.length > 0, "Body should not be empty");
    });
%}

### GET /hello-simple-jaxrs/json — JSON
GET http://localhost:8080/hello-simple-jaxrs/json
Accept: application/json

> {%
    client.test("should return 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("should be valid JSON", function() {
        client.assert(response.body.hasOwnProperty("message"), "Should have 'message' field");
    });
%}

