<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>fr.vidocq.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
    </parent>

    <artifactId>vidocq-core-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Core Extensions</name>
    <description>MicroProfile 7.1 core extensions for Vidocq</description>

    <modules>
        <module>vidocq-chappe-extension</module>
        <module>vidocq-servlet-chappe-extension</module>
        <module>vidocq-rest-extension</module>
    </modules>

    <!--
        vidocq-servlet-chappe-tck-runner est volontairement EN DEHORS du reactor :
        ShrinkWrap Maven Resolver 3.3 (dép. transitive du TCK officiel Jakarta)
        s'appuie sur maven-resolver 1.9 / maven-model 3.9 qui ne savent pas parser
        le Model 4.1.0 des POMs du reactor Vidocq (version implicite via parent).
        Son ClasspathWorkspaceReader crash avec "Bad artifact coordinates ... jar:".

        Profil tck-official activé via :
          ./run-official-tck.sh                       : smoke test
          ./run-official-tck.sh all                   : suite complète (option double-tiret all)
          ./run-official-tck.sh -Dtest=ServletTests   : classe ciblée

        Le module compile et teste indépendamment, ses artefacts restent
        disponibles en SNAPSHOT local après un mvn install du reactor.
    -->
</project>
