<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-dirac-metrics</artifactId>
    <name>Vidocq :: TCK :: MicroProfile Metrics 5.1 (Dirac)</name>
    <description>
        Runs the official MicroProfile Metrics 5.1.1 TCK
        (org.eclipse.microprofile.metrics:microprofile-metrics-api-tck) against Dirac, the Metrics
        implementation Vidocq activates through vidocq-runtime-dirac-metrics-extension.

        The MP Metrics 5.1 api-tck is a CDI test suite (JUnit 4 + @RunWith(Arquillian.class)): each
        @Deployment is a ShrinkWrap archive of @Counted/@Timed/@Gauge beans and the test methods run
        IN-CONTAINER against the deployed CDI graph — there is no HTTP endpoint under test (the REST
        /metrics scrape format is not part of this api-tck). So the harness (ported from Dirac's own
        dirac-tck) uses Arquillian's "Local" protocol and boots a Vauban CDI container per deployment:

          * DiracDeployableContainer  — a Local, no-op container; per @Deployment VaubanDiracTckBootstrap
            starts a Vauban CDI container with Dirac's DiracExtension BCE + Counted/Timed interceptors +
            MetricRegistry producer + gauge registration bean + all archive classes.
          * DiracTestEnricher          — a TestEnricher that satisfies @Inject MetricRegistry /
            Counter/Timer/Histogram/Gauge on the TCK test instances directly from the Dirac registry
            (the CDI producers require an InjectionPoint unavailable outside the container).
          * VaubanDiracTckBootstrap    — exports each archive's microprofile-config.properties as system
            properties so Dirac's histogram/timer config (mp.metrics.*) resolves per deployment.

        The api-tck builds deployments with addClass/addPackage — it does NOT use the ShrinkWrap Maven
        resolver — so it runs safely in-reactor (verified: no resolver references in the tck jar). No
        exclusions: Dirac passes the full suite.
    </description>

    <properties>
        <!-- MicroProfile 7.x pins Metrics 5.1 -->
        <microprofile.metrics.tck.version>5.1.1</microprofile.metrics.tck.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25 (see dirac-tck). -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
    </properties>

    <!--
        No module-info.java (unnamed module): the TCK archive classes carry no JPMS
        descriptor and must stay readable by Vauban/Dirac — same approach as the
        other vidocq-runtime-tck-* modules.
    -->

    <dependencyManagement>
        <dependencies>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only. It overrides the
                root pom's inherited arquillian-bom (1.8.0), whose EventTestRunnerAdaptor
                throws MalformedParameterizedTypeException under JDK 25. Importing the whole
                bom keeps every arquillian artifact (core/test/container) on one version.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Force CDI API 4.1.0 final (the TCK drags CDI 4.1.0-M1 transitively). -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Dirac = MicroProfile Metrics 5.1 implementation, as wired into the Vidocq
            runtime. The extension wrapper pulls dirac-cdi-vauban, whose internal
            DiracExtension / Counted+Timed interceptors / MetricRegistryProducerBean /
            GaugeRegistrationBean the harness boots per deployment.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-dirac-metrics-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Vauban CDI Lite container: VaubanDiracTckBootstrap boots one per TCK archive. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <!-- MicroProfile Metrics 5.1 API — types the harness/TCK reference directly. -->
        <dependency>
            <groupId>org.eclipse.microprofile.metrics</groupId>
            <artifactId>microprofile-metrics-api</artifactId>
            <version>${microprofile.metrics.tck.version}</version>
        </dependency>

        <!--
            Official MicroProfile Metrics 5.1.1 TCK (CDI/api module). The @Test classes
            live in this jar and are scanned via dependenciesToScan.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.metrics</groupId>
            <artifactId>microprofile-metrics-api-tck</artifactId>
            <version>${microprofile.metrics.tck.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            Arquillian container SPI + test SPI + JUnit 4 container. This module ships its
            OWN Local DeployableContainer (DiracDeployableContainer), so it depends on the
            raw SPI rather than vidocq-runtime-arquillian (which would register a second
            DeployableContainer and clash). The MP Metrics TCK uses JUnit 4
            (@RunWith(Arquillian.class)), so the JUnit container is used (not TestNG).
        -->
        <dependency>
            <groupId>org.jboss.arquillian.container</groupId>
            <artifactId>arquillian-container-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.test</groupId>
            <artifactId>arquillian-test-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.junit</groupId>
            <artifactId>arquillian-junit-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Hamcrest — assertions used in the TCK tests. -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-all</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
        <!-- CDI / interceptor / annotation APIs the TCK beans and harness reference. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>2.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!--
                        The TCK @Test classes live in the microprofile-metrics-api-tck jar,
                        not in this module's src/test/java. Tell Surefire to scan that
                        dependency; the JUnit 4 provider (below) runs @RunWith(Arquillian.class).
                    -->
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.metrics:microprofile-metrics-api-tck</dependency>
                    </dependenciesToScan>
                    <trimStackTrace>false</trimStackTrace>
                    <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                    <systemPropertyVariables>
                        <arquillian.launch>dirac</arquillian.launch>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit4</artifactId>
                        <version>3.5.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
