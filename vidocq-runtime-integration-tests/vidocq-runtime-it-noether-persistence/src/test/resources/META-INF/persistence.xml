<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="noether-it" transaction-type="JTA">
        <provider>io.vidocq.noether.jpa.core.NoetherPersistenceProvider</provider>
        <jta-data-source>vidocq-it</jta-data-source>
        <class>io.vidocq.runtime.it.noether.PersistenceRecord</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:vidocq-noether-it;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
