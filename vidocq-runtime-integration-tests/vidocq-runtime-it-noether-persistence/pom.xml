<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-it-noether-persistence</artifactId>
    <name>Vidocq :: IT :: Noether Persistence</name>
    <description>The assembled runtime with the Noether Persistence extension, on the module path: a JTA persistence
        unit takes the default Mansart pool, @Transactional commits and rolls back its persistence context, and the
        container owns the factory; a second unit takes a named pool and its own entity only</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <!-- SonarQube: test vehicle, its main code only exists for its own tests (Vidocq/vidocq#284). -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension</artifactId>
        </dependency>
        <!-- What the extension's descriptor requires (requires-extensions): `vidocq extension add` adds both. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>runtime</scope>
        </dependency>
        <!-- The dev console's panel of the extension, which only vidocq:dev adds to an application: its test runs
             each tab on the units of a booted application. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension-dev</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-noether-persistence-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-mansart-transactions-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <!-- The @Named("notes") DataSource of vidocq.pool.notes.url in vidocq.properties. -->
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-mansart-pool-datasources-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- A test reads the startup report the boot logs. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.runtime.it.noether=java.logging</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} keeps the JaCoCo agent of the quality profile (vidocq-parent). The application
                         module does not require the dev console's panel, so Surefire puts it on the class path:
                         the add-exports gives it the package of live units that the extension exports to the
                         panel's module, which is how vidocq:dev runs it. The core names the dev console SPI
                         (requires static), so Surefire puts the SPI on the module path, where the test module
                         reads it only when told to. -->
                    <argLine>
                        @{argLine}
                        --add-reads io.vidocq.runtime.it.noether=java.logging
                        --add-reads io.vidocq.runtime.it.noether=io.vidocq.runtime.spi.devconsole
                        --add-exports io.vidocq.runtime.extensions.jakartaee.web.noether.persistence/io.vidocq.runtime.extensions.jakartaee.web.noether.persistence.live=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
