<?xml version="1.0" encoding="UTF-8"?>
<!--
    Vidocq/vidocq#94, I1 to I3: an MCP server application that depends on the langchain4j-cdi MCP extension alone,
    launched as a separate JVM in the three launch shapes (flat trampoline, vidocq.app.path, IDE without
    ALL-MODULE-PATH), then called over HTTP on a loopback port of 18090-18099.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-it-langchain4j-cdi-mcp</artifactId>
    <name>Vidocq Runtime :: IT :: langchain4j-cdi MCP server in every launch shape</name>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!-- The only MCP dependency, as an application declares it. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            I4 reads the mcp panel from the console's /api/snapshot. Vidocq/vidocq#143: the console is dev-only, so
            checkpom only stays quiet about it at test scope; it never runs through this module's own compiled or
            packaged code, it just has to be on the module path of the launched JVM, which is what the it-lib
            directory below is (copy-launch-lib now copies test scope too, see the surefire it.lib property).
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-devconsole-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Vidocq/vidocq#143: the mcp panel of the dev console moved to this -dev companion module, which only
            vidocq:dev normally adds. I4 needs it on the launched JVM's module path too, exactly like the console
            above: without it, the mcp section is written but no longer shown live. Test scope, same reason.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension-dev</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            McpDevConsolePanelTest.restRequests() reads the rest panel live: the mcp panel is served through
            Cassini's own REST routing (McpEndpoint is a JAX-RS resource), which this application gets transitively
            from the mcp extension, but its -dev companion is a separate artifact that nothing brings in on its
            own. Added here, test scope, for the same reason as the two dependencies above.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension-dev</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Inherited from vidocq-parent: not wanted here. -->
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>none</phase>
                    </execution>
                    <!-- The lib/ directory of the launched JVMs: what the application needs at run time, no test
                         jar. -->
                    <execution>
                        <id>copy-launch-lib</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/it-lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                    <!-- Vidocq/vidocq#143: the console and the two -dev companions I4 needs are test-scope
                         dependencies now (checkpom stays quiet only at that scope). A second, narrower copy adds
                         just those four artifacts (the companions' own devconsole-spi included) to the same it-lib
                         — not a blanket `includeScope=test`, which would also copy junit-jupiter and its own
                         transitive closure onto the launched JVM's module path and break I1's "only the
                         application module moves" assertion. Every other transitive dependency of these four
                         (chappe, cassini-rest, the mcp extension, vidocq-runtime-core) is already copied above,
                         at runtime scope, as a direct or transitive dependency of the application itself. -->
                    <execution>
                        <id>copy-launch-lib-dev</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/it-lib</outputDirectory>
                            <includeScope>test</includeScope>
                            <includeArtifactIds>
                                vidocq-runtime-devconsole-spi,
                                vidocq-runtime-devconsole-extension,
                                vidocq-runtime-langchain4j-cdi-mcp-extension-dev,
                                vidocq-runtime-cassini-rest-extension-dev
                            </includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Vidocq/vidocq#186: as an application builds, vidocq:generate scans the langchain4j-cdi jars the
                 extension declares and writes their enriched copies (generated code inside, providers declared)
                 into target/vidocq-enriched/. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-dependency-code</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- ...and the launched JVMs run those copies, as vidocq:dev, run and package do: they overwrite the
                 originals copied above, under the same file names. Declared after maven-dependency-plugin, so it
                 runs after the copies in the same phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-enriched-jars</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/it-lib</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/vidocq-enriched</directory>
                                    <includes>
                                        <include>*.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <it.lib>${project.build.directory}/it-lib</it.lib>
                        <it.app>${project.build.outputDirectory}</it.app>
                        <it.logs>${project.build.directory}/it-logs</it.logs>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
