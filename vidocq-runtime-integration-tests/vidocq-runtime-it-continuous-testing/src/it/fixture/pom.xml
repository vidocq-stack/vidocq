<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The runtime's own parent: its dependencyManagement and its Vauban indexer APT, as an example has. -->
    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.it</groupId>
    <artifactId>continuous-testing-fixture</artifactId>
    <!-- No version of its own: the parent's dependencyManagement pins the runtime's modules to ${project.version}. -->

    <properties>
        <vidocq.mainModule>io.vidocq.it.ct</vidocq.mainModule>
        <vidocq.mainClass>io.vidocq.it.ct.FixtureApp</vidocq.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!-- Vidocq/vidocq#143: no more declared console — vidocq:dev adds it by itself, so the ITs that use this
             fixture (ContinuousTestingDevGoalIT) now prove that. It needs an HTTP server extension to do so
             (Ruling 5): the fixture used to get Chappe only transitively through the console it declared, so it is
             now declared explicitly (ledger Ruling R1), otherwise the fixture is not the case the spec's console
             rule is about. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.essentials</groupId>
            <artifactId>vidocq-runtime-chappe-webserver-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>@project.version@</version>
            </plugin>
        </plugins>
    </build>
</project>
