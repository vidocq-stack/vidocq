<?xml version="1.0" encoding="UTF-8"?>
<!--
    One persistence.xml per Maven module, so per Java module: a library module declares its unit next to its
    entities, the application declares its own, and under vidocq:run each unit manages the entities of its own module
    only. Two units of one name fail (Noether BUG-20261113-06).

    The harness is vidocq-runtime-it-dependency-codegen's. The fixture resolves this build's artifacts from
    target/it-repo, which maven-invoker-plugin:install stages at pre-integration-test; anything else comes from the
    outer local repository through it-settings.xml, which Fixture writes from src/it/it-settings.xml with the outer
    repository's URL. That settings file mirrors every repository to the outer local repository, so the fixture
    never reaches the network (Vidocq/vidocq#285).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-it-noether-units-per-module</artifactId>
    <name>Vidocq Runtime :: IT :: Noether persistence units per module</name>

    <properties>
        <it.repo>${project.build.directory}/it-repo</it.repo>
        <it.settings>${project.build.directory}/it-settings.xml</it.settings>
        <!-- maven-invoker-plugin reads invoker.skip only; -DskipTests skips the staging too. -->
        <invoker.skip>${skipTests}</invoker.skip>
        <!-- The extensions below are staging dependencies for the fixture, which declares their codegen bundles
             itself; this module compiles no persistence code. -->
        <vidocq.checkpom.skip>true</vidocq.checkpom.skip>
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencies>
        <!-- What the fixture uses from this build: invoker:install stages them, and every reactor module, parent POM
             and dependency they need, in target/it-repo. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-maven-plugin</artifactId>
            <version>${project.version}</version>
            <type>maven-plugin</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jars, as the fixture's annotationProcessorPaths entries: a pom-typed dependency stages the pom only. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Brings noether-jpa-processor too, which the library compiles with. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <!-- The fixture project, its pom.xml and .mvn/ filtered with @…@ only. -->
                    <execution>
                        <id>fixture</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/fixture</outputDirectory>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>src/it/fixture</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>*/pom.xml</include>
                                        <include>.mvn/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/it/fixture</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>pom.xml</exclude>
                                        <exclude>*/pom.xml</exclude>
                                        <exclude>.mvn/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <localRepositoryPath>${it.repo}</localRepositoryPath>
                    <!-- The fixture's artifacts are test-scope dependencies here. -->
                    <scope>test</scope>
                    <!-- What the fixture needs beyond the plugins this module runs, as it never reaches Central:
                         maven-install-plugin, which this build runs only when it installs, and
                         git-commit-id-maven-plugin, whose version ranges need the maven-metadata-local.xml an
                         installation writes (see vidocq-runtime-it-dependency-codegen). -->
                    <extraArtifacts>
                        <extraArtifact>org.apache.maven.plugins:maven-install-plugin:${maven.install.plugin.version}:maven-plugin</extraArtifact>
                        <extraArtifact>io.github.git-commit-id:git-commit-id-maven-plugin:${git-commit-id.plugin.version}:maven-plugin</extraArtifact>
                    </extraArtifacts>
                </configuration>
                <executions>
                    <execution>
                        <id>stage</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <systemPropertyVariables>
                        <it.fixture>${project.build.directory}/fixture</it.fixture>
                        <it.logs>${project.build.directory}/it-logs</it.logs>
                        <!-- vidocq.generate.cacheDir of the fixture's builds: never the user's cache. -->
                        <it.caches>${project.build.directory}/it-caches</it.caches>
                        <it.settings>${it.settings}</it.settings>
                        <it.settings.template>${project.basedir}/src/it/it-settings.xml</it.settings.template>
                        <it.outerRepository>${settings.localRepository}</it.outerRepository>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
