<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-integration-tests</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Integration Tests</name>
    <description>Integration tests for Vidocq extensions (Arquillian)</description>

    <properties>
        <!-- Test vehicles: never released. Inherited by every child module (the ITs and the
             Arquillian harness — nothing outside this subtree consumes them). They were
             published up to 0.2.0 by omission. NOTE: central-publishing ignores
             maven.deploy.skip — the inherited skipPublishing configuration below is what
             actually keeps them off Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <modules>
        <module>vidocq-runtime-arquillian</module>
        <module>vidocq-runtime-it-cassini-rest</module>
        <module>vidocq-runtime-it-humboldt-cassini</module>
        <module>vidocq-runtime-it-cervantes-jwt</module>
        <module>vidocq-runtime-it-grimm-openapi</module>
        <module>vidocq-runtime-it-cyrano-jpms</module>
    </modules>

    <profiles>
        <!--
            Official MicroProfile TCK runners. Kept out of the default reactor so a
            normal `mvn install` does not download the TCK jars (TestNG, httpclient,
            json-schema-validator, ...) nor run the long TCK suites. Activate with
            `-Ptck`. Each runner drives an official TCK against Vidocq through the
            embedded Arquillian container.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>vidocq-runtime-tck-knock-health</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Inherits the checkpom execution from vidocq-runtime-parent/pluginManagement. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
