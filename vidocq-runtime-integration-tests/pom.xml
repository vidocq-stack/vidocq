<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-integration-tests</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Integration Tests</name>
    <description>Integration tests for Vidocq extensions (Arquillian)</description>

    <properties>
        <!-- Test vehicles: never released. Inherited by every child module (the ITs and the
             Arquillian harness — nothing outside this subtree consumes them). They were
             published up to 0.2.0 by omission. NOTE: central-publishing ignores
             maven.deploy.skip — the inherited skipPublishing configuration below is what
             actually keeps them off Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <modules>
        <module>vidocq-runtime-arquillian</module>
        <module>vidocq-runtime-it-cassini-rest</module>
        <module>vidocq-runtime-it-humboldt-cassini</module>
        <module>vidocq-runtime-it-cervantes-jwt</module>
        <module>vidocq-runtime-it-grimm-openapi</module>
        <module>vidocq-runtime-it-cyrano-jpms</module>
        <module>vidocq-runtime-it-langchain4j-cdi-mcp</module>
    </modules>

    <profiles>
        <!-- Continuous testing end to end (#122): real mvn subprocesses running vidocq:dev and vidocq:test on a
             fixture project. On any CI runner (Forgejo sets CI=true) and with -Pit, like the plugin's invoker
             tests: it stages the fresh plugin with maven-invoker-plugin, which a plain offline build may lack. -->
        <profile>
            <id>it</id>
            <activation>
                <property>
                    <name>env.CI</name>
                </property>
            </activation>
            <modules>
                <module>vidocq-runtime-it-continuous-testing</module>
            </modules>
        </profile>
        <!--
            Vidocq/vidocq#123: the dev services end-to-end IT needs a real Docker daemon (Testcontainers).
            Kept out of the default reactor so a plain `mvn install`/`verify` never needs Docker. Activate
            with `-Pdocker`.
        -->
        <profile>
            <id>docker</id>
            <modules>
                <module>vidocq-runtime-it-devservices</module>
            </modules>
        </profile>

        <!--
            Official MicroProfile TCK runners. Kept out of the default reactor so a
            normal `mvn install` does not download the TCK jars (TestNG, httpclient,
            json-schema-validator, ...) nor run the long TCK suites. Activate with
            `-Ptck`. Each runner drives an official TCK against Vidocq through the
            embedded Arquillian container.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>vidocq-runtime-tck-knock-health</module>
                <module>vidocq-runtime-tck-grimm-openapi</module>
                <module>vidocq-runtime-tck-cyrano-restclient</module>
                <module>vidocq-runtime-tck-cervantes-jwt</module>
                <module>vidocq-runtime-tck-ravel-config</module>
                <module>vidocq-runtime-tck-humboldt-telemetry</module>
                <module>vidocq-runtime-tck-dirac-metrics</module>
                <module>vidocq-runtime-tck-heisenberg-faulttolerance</module>
                <module>vidocq-runtime-tck-coreprofile</module>
                <module>vidocq-runtime-tck-annotations</module>
            </modules>

            <build>
                <plugins>
                    <!--
                        Drop previously compiled test classes before every TCK run.

                        These runners only join the reactor under `-Ptck`, so a plain
                        `mvn clean install` never cleans them: their target/ survives across
                        builds untouched. A class compiled while one of its member types was
                        not yet resolvable stays on disk forever, because the incremental
                        compiler sees an up-to-date .class and never rebuilds it — and an
                        active annotation processor keeps javac from failing outright, so the
                        stale class carries a simple-name field descriptor (`LMetricRegistry;`)
                        that only blows up at deployment time.

                        That is Vidocq/vidocq#38: 93 Fault Tolerance TCK deployments aborted by
                        a single stale test class, while the standalone heisenberg runner was
                        green. Recompiling the (few) test sources costs seconds; a TCK run costs
                        minutes, so always start from freshly compiled bytecode.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>remove-stale-tck-test-classes</id>
                                <phase>process-resources</phase>
                                <goals><goal>clean</goal></goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.testOutputDirectory}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Inherits the checkpom execution from vidocq-runtime-parent/pluginManagement. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
