<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suite TestNG agrégant les 3 TCK MicroProfile Telemetry 2.1.
    Activée via le profile -Ptck-official.

    M7 SCAFFOLD : aucun de ces tests ne passe encore. L'adapter Arquillian
    Humboldt (Vauban+Cassini+Chappe) viendra en M7b.
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="microprofile-telemetry-tck-2.1" verbose="2" configfailurepolicy="continue">
    <test name="microprofile-telemetry-tracing-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.tracing.tck.*"/>
        </packages>
    </test>
    <test name="microprofile-telemetry-metrics-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.metrics.tck.*"/>
        </packages>
    </test>
    <test name="microprofile-telemetry-logs-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.logs.tck.*"/>
        </packages>
    </test>
</suite>
