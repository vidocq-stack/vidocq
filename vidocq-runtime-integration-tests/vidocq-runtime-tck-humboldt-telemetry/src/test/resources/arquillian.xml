<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <!--
        Container Arquillian Humboldt (M7b.4b.1 squelette).
        Enregistré via META-INF/services/org.jboss.arquillian.core.spi.LoadableExtension
        → HumboldtLoadableExtension → HumboldtDeployableContainer.
    -->
    <container qualifier="humboldt" default="true">
        <!-- M7b.4b.1 : aucune option de configuration exposée pour l'instant -->
    </container>

    <engine>
        <property name="deploymentExportPath">target/arquillian-deployments</property>
    </engine>

</arquillian>
