<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-humboldt-telemetry</artifactId>
    <name>Vidocq :: TCK :: MicroProfile Telemetry 2.1 (Humboldt)</name>
    <description>
        Runs the official MicroProfile Telemetry 2.1 TCK
        (org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck) against Humboldt,
        the Telemetry implementation Vidocq activates through
        vidocq-runtime-humboldt-telemetry-extension.

        The MP Telemetry tracing TCK is Arquillian + REST: it deploys WARs of JAX-RS endpoints and
        drives them over HTTP, then asserts on the spans Humboldt produces. The harness (ported
        from Humboldt's own humboldt-tck) is a HumboldtDeployableContainer that boots the full
        Humboldt + Cassini JAX-RS + Chappe HTTP stack per deployment on an ephemeral port, bridges
        Humboldt's SpanData into the OTel SDK InMemorySpanExporter the TCK inspects (via an
        AutoConfigurationCustomizer + withExtraSpanExporter), wires B3/Jaeger propagators and SPI
        samplers/exporters, and auto-instruments the MP Rest Client (Cyrano) so client spans
        propagate. A CDI enricher satisfies @Inject on the TCK test instances.

        The metrics and logs TCK jars (2.1) ship no runnable tests, so the effective suite is the
        tracing suite. Unlike the Config runner (Weld embedded), this boots the real Vidocq/Vauban
        stack, so it certifies the full runtime integration.

        Note: the tracing TCK builds its deployments with ShrinkWrap addClass/addPackage (no
        ShrinkWrap Maven resolver), so — unlike the standalone humboldt-tck — this runner does NOT
        depend on shrinkwrap-resolver-*-maven and is safe to build inside the reactor.
    </description>

    <properties>
        <!-- MicroProfile 7.1 pins Telemetry 2.1. -->
        <microprofile.telemetry.version>2.1</microprofile.telemetry.version>
        <microprofile.rest.client.version>4.0</microprofile.rest.client.version>
        <opentelemetry.version>1.39.0</opentelemetry.version>
        <opentelemetry.instrumentation.version>2.7.0</opentelemetry.instrumentation.version>
        <opentelemetry.semconv.version>1.27.0-alpha</opentelemetry.semconv.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25. -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
        <tck.testng.version>7.10.2</tck.testng.version>
        <jakarta.annotation.tck.version>3.0.0</jakarta.annotation.tck.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only, overriding the root's inherited
                1.8.0 bom, which throws MalformedParameterizedTypeException while reflecting the
                TestNG runner adaptor under JDK 25. Importing the whole bom keeps every arquillian
                artifact on one version.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Official MP Telemetry 2.1 TCKs. Only the tracing jar ships runnable tests. -->
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-tracing-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-metrics-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-logs-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Humboldt = MicroProfile Telemetry 2.1 implementation under test. -->
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-cdi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-rest</artifactId>
        </dependency>

        <!-- Vauban CDI Lite container: the harness boots one per TCK @Deployment. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <!-- Chappe HTTP + Cassini JAX-RS: assembled in-process for the REST TCK tests. -->
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
        </dependency>
        <!-- Cassini JAX-RS client (ClientBuilder) + a RuntimeDelegate provider. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-client</artifactId>
            <version>${cassini.version}</version>
        </dependency>

        <!-- Cyrano = MP Rest Client 4.0 impl, so RestClientBuilder resolves for the client-span tests. -->
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
        </dependency>

        <!-- Official @WithSpan annotation the TCK expects. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-annotations</artifactId>
            <version>${opentelemetry.instrumentation.version}</version>
        </dependency>

        <!-- Jakarta + MicroProfile specs the TCK and deployed resources use. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.tck.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>${microprofile.rest.client.version}</version>
        </dependency>

        <!-- OTel SDK — used by the TCK fixtures + the Humboldt→OTel span bridge. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-extension-trace-propagators</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.semconv</groupId>
            <artifactId>opentelemetry-semconv</artifactId>
            <version>${opentelemetry.semconv.version}</version>
        </dependency>

        <!-- Test infrastructure: TestNG + Arquillian + ShrinkWrap (no Maven resolver needed). -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${tck.testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.container</groupId>
            <artifactId>arquillian-container-spi</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck</dependency>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-metrics-tck</dependency>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-logs-tck</dependency>
                    </dependenciesToScan>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <arquillian.launch>humboldt</arquillian.launch>
                        <!-- MP Telemetry TCK porting SPI: JaxRsServerAsyncTestEndpoint calls
                             ConfigurationAccessor.get().getExecutor() in its constructor. -->
                        <telemetry.tck.executor>io.vidocq.humboldt.tck.HumboldtTckExecutor</telemetry.tck.executor>
                        <!-- Logs TCK (JulTest) reads this in a static{} block. -->
                        <mptelemetry.tck.log.file.path>${project.build.directory}/humboldt-tck-logs.txt</mptelemetry.tck.log.file.path>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <!-- The MP Telemetry TCK is TestNG-driven; force the TestNG surefire provider. -->
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.5.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
