<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-humboldt-telemetry</artifactId>
    <name>Vidocq :: TCK :: MicroProfile Telemetry 2.1 (Humboldt)</name>
    <description>
        Runs the official MicroProfile Telemetry 2.1 TCKs (tracing, metrics, logs) against the
        assembled Vidocq runtime: vidocq-runtime-core boots via VidocqBootstrap, discovers
        vidocq-runtime-humboldt-telemetry-extension (plus cassini-rest for the traced REST endpoints
        and cyrano-rest-client for the client propagation tests) through the ServiceLoader SPI, and
        the shared vidocq-runtime-arquillian embedded container deploys each TCK archive — the same
        path a real application uses.

        The TCK's in-memory exporters/samplers/propagators are OTel SDK autoconfigure SPI providers
        shipped inside each deployment (META-INF/services): humboldt-otel-interop discovers them on
        the deployment class loader at boot and adapts them to the Humboldt SDK — a real interop
        feature of the runtime, not TCK wiring. The only local glue is HumboldtTckExecutor, required
        by the TCK porting SPI (telemetry.tck.executor).
    </description>

    <properties>
        <!-- MicroProfile 7.1 pins Telemetry 2.1 -->
        <microprofile.telemetry.version>2.1</microprofile.telemetry.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25. -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
        <tck.testng.version>7.10.2</tck.testng.version>
        <opentelemetry.version>1.39.0</opentelemetry.version>
        <opentelemetry.instrumentation.version>2.7.0</opentelemetry.instrumentation.version>
        <opentelemetry.semconv.version>1.27.0-alpha</opentelemetry.semconv.version>
    </properties>

    <!--
        No module-info.java (unnamed module): the TCK archive classes carry no JPMS
        descriptor and must stay readable by Vauban/Humboldt — same approach as the
        other vidocq-runtime-tck-* modules.
    -->

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only. It overrides the
                root pom's inherited arquillian-bom (1.8.0), whose EventTestRunnerAdaptor
                throws MalformedParameterizedTypeException under JDK 25.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Vidocq runtime under test -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!--
            Humboldt = MicroProfile Telemetry 2.1 implementation, wired into the
            runtime the same way an application would; pulls humboldt-otel-interop
            (deployment-provided OTel SPI providers) and the OTel SDK it needs.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-humboldt-telemetry-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Ravel = MicroProfile Config: MP Telemetry reads every otel.* key
            through MP Config — the TCK deployments ship them in their
            microprofile-config.properties (otel.sdk.disabled, in-memory
            exporters), visible through the deployment class loader. A complete
            MP runtime always assembles Config alongside Telemetry.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Traced REST endpoints (tracing TCK) — server side. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MP Rest Client propagation tests (tracing TCK) — client side. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-cyrano-rest-client-extension</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            JAX-RS client implementation: several TCK tests call
            ClientBuilder.newClient() in-container; cassini-client provides the
            RuntimeDelegate/ClientBuilder SPI (same requirement as the cyrano
            runner).
        -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-client</artifactId>
            <version>${cassini.version}</version>
        </dependency>

        <!-- Test harness: shared embedded Vidocq Arquillian container -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Official MicroProfile Telemetry 2.1 TCKs (TestNG + Arquillian). -->
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-tracing-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-metrics-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-logs-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${tck.testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Types the TCK deployment/test classes reference directly. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-annotations</artifactId>
            <version>${opentelemetry.instrumentation.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.semconv</groupId>
            <artifactId>opentelemetry-semconv</artifactId>
            <version>${opentelemetry.semconv.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>4.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- One codegen bundle per declared extension (checkpom contract). -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck</dependency>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-metrics-tck</dependency>
                        <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-logs-tck</dependency>
                    </dependenciesToScan>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <!-- MP Telemetry TCK porting SPI: JaxRsServerAsyncTestEndpoint calls
                             ConfigurationAccessor.get().getExecutor() in its constructor. -->
                        <telemetry.tck.executor>io.vidocq.runtime.tck.telemetry.HumboldtTckExecutor</telemetry.tck.executor>
                        <!-- Logs TCK (JulTest) reads this in a static{} block. -->
                        <mptelemetry.tck.log.file.path>${project.build.directory}/humboldt-tck-logs.txt</mptelemetry.tck.log.file.path>
                    </systemPropertyVariables>
                </configuration>
                <dependencies>
                    <!-- The MP Telemetry TCK is TestNG-driven; force the TestNG surefire provider. -->
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.5.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
