<?xml version="1.0" encoding="UTF-8"?>
<!--
    Arquillian configuration for the MicroProfile OpenAPI 4.2 TCK suite.
    Single embedded Vidocq container (vidocq-runtime-arquillian). The port is
    pinned because the TCK's AppTestBase drives /openapi from the static
    `test.url` system property (mirrored in the surefire configuration).
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="vidocq" default="true">
        <configuration>
            <property name="host">127.0.0.1</property>
            <property name="port">18085</property>
        </configuration>
    </container>

</arquillian>
