<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-grimm-openapi</artifactId>
    <name>Vidocq :: TCK :: MicroProfile OpenAPI 4.2 (Grimm)</name>
    <description>
        Runs the official MicroProfile OpenAPI 4.2 TCK (org.eclipse.microprofile.openapi:microprofile-openapi-tck)
        against the assembled Vidocq runtime: vidocq-runtime-core boots via VidocqBootstrap, discovers
        vidocq-runtime-grimm-openapi-extension (and ravel-config for the mp.openapi.* deployment
        configuration) through the ServiceLoader SPI, and the shared vidocq-runtime-arquillian embedded
        container deploys each TCK archive — the same path a real application uses. The OpenAPI document
        under /openapi is produced by Grimm mounted through Cassini; deployment classes reach Grimm through
        the standard build-compatible-extension lifecycle, static META-INF/openapi.{yaml,yml,json} overrides
        through the deployment class loader, and mp.openapi.* configuration through the republished
        microprofile-config.properties.

        AppTestBase drives /openapi with REST-assured from the `test.url` system property, so this runner
        pins the container port in arquillian.xml and mirrors it in test.url below.
    </description>

    <properties>
        <!-- MicroProfile 7.2 pins OpenAPI 4.2 — 4.2-RC5 until the final reaches Maven Central (byte-identical). -->
        <microprofile.openapi.tck.version>4.2-RC5</microprofile.openapi.tck.version>
        <!-- Fixed port mirrored in the test.url system property (AppTestBase). -->
        <grimm.tck.port>18085</grimm.tck.port>
    </properties>

    <!--
        No module-info.java (unnamed module) so the TCK deployment classes, which
        carry no JPMS descriptor, stay readable by Vauban/Cassini/Grimm — same
        approach as the other vidocq-runtime-it-* modules.
    -->

    <dependencies>
        <!-- Vidocq runtime under test -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!--
            Grimm = MicroProfile OpenAPI implementation, wired into the runtime the
            same way an application would: the extension wrapper pulls grimm-cdi-vauban
            (BCE + producers, self-registered) and Cassini/Chappe for the /openapi endpoint.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-grimm-openapi-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Ravel = MicroProfile Config: Grimm reads the deployment's mp.openapi.*
            settings (filter, model.reader, scan.*, servers) through the MP Config API.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            The TCK deployment classes (run in the test JVM) reference
            jakarta.ws.rs.* and jakarta.validation.* types; those APIs must be on
            the test classpath (the runtime ships them as JPMS-repackaged jars
            that Maven does not expose under the spec coordinates).
        -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Test harness: shared embedded Vidocq Arquillian container -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Official MicroProfile OpenAPI TCK. The @Test classes live in this jar
            (scanned via dependenciesToScan); TestNG + REST-assured come transitively.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.openapi</groupId>
            <artifactId>microprofile-openapi-tck</artifactId>
            <version>${microprofile.openapi.tck.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- One codegen bundle per declared extension (checkpom contract). -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
                            <artifactId>vidocq-runtime-ravel-config-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!--
                        The TCK @Test classes live in the microprofile-openapi-tck jar,
                        not in this module's src/test/java. Tell Surefire to scan that
                        dependency; the TestNG provider is selected automatically
                        because TestNG (not JUnit) is on the test classpath.
                    -->
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.openapi:microprofile-openapi-tck</dependency>
                    </dependenciesToScan>
                    <systemPropertyVariables>
                        <!-- AppTestBase reads test.url; the container port is pinned in arquillian.xml. -->
                        <test.url>http://127.0.0.1:${grimm.tck.port}</test.url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
