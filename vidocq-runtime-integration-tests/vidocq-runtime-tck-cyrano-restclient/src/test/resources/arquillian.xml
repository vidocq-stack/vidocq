<?xml version="1.0" encoding="UTF-8"?>
<!--
    Arquillian configuration for the MicroProfile Rest Client 4.0 TCK suite.
    Single embedded Vidocq container (vidocq-runtime-arquillian), used by default.
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="vidocq" default="true">
        <!-- Embedded Vidocq: no container properties required (free port at deploy time). -->
    </container>

</arquillian>
