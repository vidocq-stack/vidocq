<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The root of the runtime's reactor, vidocq-runtime-build: its dependencyManagement and its Vauban indexer APT, as an example has. -->
    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-build</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.it</groupId>
    <artifactId>app-layer-app</artifactId>
    <!-- No version of its own: the parent's dependencyManagement pins the runtime's modules to ${project.version}. -->

    <properties>
        <vidocq.mainModule>acme.app</vidocq.mainModule>
        <vidocq.mainClass>acme.app.AppLayerApp</vidocq.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!-- The flat-classpath library of ../lib, which looks the application's resource up through its own loader. -->
        <dependency>
            <groupId>io.vidocq.it</groupId>
            <artifactId>app-layer-pages</artifactId>
            <version>1.0</version>
        </dependency>
        <!-- An explicit module that requires java.sql (vidocq#254). -->
        <dependency>
            <groupId>io.vidocq.it</groupId>
            <artifactId>app-layer-sql</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>@project.version@</version>
            </plugin>
        </plugins>
    </build>
</project>
