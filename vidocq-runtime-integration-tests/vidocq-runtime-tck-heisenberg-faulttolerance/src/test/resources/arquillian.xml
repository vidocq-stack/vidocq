<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration Arquillian pour la suite TCK MicroProfile Fault Tolerance 4.1.
    Le qualifier "heisenberg" est sélectionné par la propriété système
    arquillian.launch=heisenberg (voir heisenberg-tck/pom.xml profil tck-official).
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="heisenberg" default="true">
        <!-- Heisenberg embedded local : aucune propriété de container nécessaire. -->
    </container>
</arquillian>

