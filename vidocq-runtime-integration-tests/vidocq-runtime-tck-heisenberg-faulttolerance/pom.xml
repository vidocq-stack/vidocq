<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-heisenberg-faulttolerance</artifactId>
    <name>Vidocq :: TCK :: MicroProfile Fault Tolerance 4.1 (Heisenberg)</name>
    <description>
        Runs the official MicroProfile Fault Tolerance 4.1 TCK
        (org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck) against the
        assembled Vidocq runtime: vidocq-runtime-core boots via VidocqBootstrap, discovers
        vidocq-runtime-heisenberg-fault-tolerance-extension and
        vidocq-runtime-dirac-metrics-extension through the ServiceLoader SPI, and the shared
        vidocq-runtime-arquillian embedded container deploys each TCK archive — the same path a
        real application uses. The FT-to-metrics composition (TCK section 9) is the real one:
        heisenberg's DiracFtMetricsRecorder resolves Dirac's registry through CDI; the
        telemetryMetrics module (section 10) goes through heisenberg's OtelFtMetricsRecorder and
        GlobalOpenTelemetry.

        The MP Fault Tolerance TCK is a CDI suite (TestNG + Arquillian, Local protocol): each
        @Deployment is a ShrinkWrap archive of @Retry/@Timeout/... beans and the test methods run
        IN-CONTAINER against the deployed CDI graph. @Inject fields on the test classes are
        resolved by the generic VidocqCdiTestEnricher. Negative-deployment scenarios rely on the
        typed FaultToleranceDefinitionException surviving in the DeploymentException cause chain
        (vauban VAU-BCE-003). The only local harness is TelemetryBootstrapListener, which registers
        the TCK's InMemoryMetricReader on the global OpenTelemetry — TCK-mandated test
        infrastructure, not runtime wiring.

        The TCK builds deployments with addClass/addPackage — it does NOT use the ShrinkWrap Maven
        resolver — so it runs safely in-reactor. No exclusions: Heisenberg passes the full suite.
    </description>

    <properties>
        <!-- MicroProfile 7.x pins Fault Tolerance 4.1 -->
        <microprofile.fault.tolerance.tck.version>4.1</microprofile.fault.tolerance.tck.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25 (see heisenberg-tck). -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
        <tck.testng.version>7.10.2</tck.testng.version>
    </properties>

    <!--
        No module-info.java (unnamed module): the TCK archive classes carry no JPMS
        descriptor and must stay readable by Vauban/Heisenberg — same approach as the
        other vidocq-runtime-tck-* modules.
    -->

    <dependencyManagement>
        <dependencies>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only. It overrides the
                root pom's inherited arquillian-bom (1.8.0), whose EventTestRunnerAdaptor
                throws MalformedParameterizedTypeException under JDK 25. Importing the whole
                bom keeps every arquillian artifact (core/test/container) on one version.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Force CDI API 4.1.0 final (the TCK drags CDI 4.1.0-M1 transitively). -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Vidocq runtime under test -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!--
            Heisenberg = MicroProfile Fault Tolerance 4.1 implementation, wired into the
            runtime the same way an application would: the extension wrapper pulls
            heisenberg-cdi-vauban, whose BCE/interceptors/recorders self-register at boot.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-heisenberg-fault-tolerance-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Dirac = MicroProfile Metrics: the TCK metrics module (section 9) asserts FT
            metrics through @Inject MetricRegistry. With Dirac on the path, heisenberg's
            DiracFtMetricsRecorder resolves the registry through CDI — the real
            composition, no fake bean.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-dirac-metrics-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Ravel = MicroProfile Config: heisenberg reads every FT configuration
            override (spec section 11 — Retry/maxRetries, MP_Fault_Tolerance_*,
            enable/disable switches) through the MP Config API, and its
            HeisenbergAutoDiscovery resolver delegates to the real provider found
            via ServiceLoader. An application composing FT with config would ship
            the same extension.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MicroProfile FT API — types the TCK references directly. -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <version>${microprofile.fault.tolerance.tck.version}</version>
        </dependency>

        <!-- Test harness: shared embedded Vidocq Arquillian container -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Official MicroProfile Fault Tolerance 4.1 TCK. The @Test classes live in this
            jar (scanned via dependenciesToScan); it pulls the OpenTelemetry SDK its
            telemetryMetrics utils (InMemoryMetricReader) are built on.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-tck</artifactId>
            <version>${microprofile.fault.tolerance.tck.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The MP FT TCK uses TestNG + the Arquillian TestNG container. -->
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${tck.testng.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- CDI / interceptor / annotation APIs the TCK beans reference. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>2.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!--
                        The TCK @Test classes live in the microprofile-fault-tolerance-tck jar,
                        not in this module's src/test/java. Tell Surefire to scan that dependency;
                        the TestNG provider runs them through the Arquillian adaptor.
                    -->
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.fault-tolerance:microprofile-fault-tolerance-tck</dependency>
                    </dependenciesToScan>
                    <trimStackTrace>false</trimStackTrace>
                    <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                    <systemPropertyVariables>
                        <!-- Timeout multiplier: scale all TCK delays for slower CI environments. -->
                        <org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>1.0</org.eclipse.microprofile.fault.tolerance.tck.timeout.multiplier>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
