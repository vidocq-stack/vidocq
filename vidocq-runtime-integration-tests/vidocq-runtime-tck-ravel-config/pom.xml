<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-ravel-config</artifactId>
    <name>Vidocq :: TCK :: MicroProfile Config 3.1 (Ravel)</name>
    <description>
        Runs the official MicroProfile Config 3.1 TCK
        (org.eclipse.microprofile.config:microprofile-config-tck) against the assembled Vidocq
        runtime: vidocq-runtime-core boots via VidocqBootstrap, discovers
        vidocq-runtime-ravel-config-extension through the ServiceLoader SPI, and the shared
        vidocq-runtime-arquillian embedded container deploys each TCK archive — the same path
        a real application uses. Per-deployment META-INF/services files (custom ConfigSources,
        ConfigSourceProviders, Converters) are honored through the materialized deployment
        class loader.
    </description>

    <properties>
        <!-- MicroProfile 7.1 pins Config 3.1; TCK/API published as 3.1.1. -->
        <microprofile.config.tck.version>${microprofile.config.version}</microprofile.config.tck.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25. -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
        <tck.testng.version>7.10.2</tck.testng.version>
    </properties>

    <!--
        No module-info.java (unnamed module): the TCK archive classes carry no JPMS
        descriptor and must stay readable by Vauban/Ravel — same approach as the
        other vidocq-runtime-tck-* modules.
    -->

    <dependencyManagement>
        <dependencies>
            <!--
                The MP Config TCK pulls cdi-api 4.1.0-M1 transitively; force the final
                4.1.0 API + lang-model so the BCE lang-model types match Vauban's.
            -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.lang-model</artifactId>
                <version>4.1.0</version>
            </dependency>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only. It overrides the
                root pom's inherited arquillian-bom (1.8.0), whose EventTestRunnerAdaptor
                throws MalformedParameterizedTypeException under JDK 25.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Vidocq runtime under test -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!--
            Ravel = MicroProfile Config 3.1 implementation, wired into the runtime
            the same way an application would; pulls ravel-core and ravel-cdi-vauban
            (the ConfigCdiExtension Build Compatible Extension).
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <!-- Test harness: shared embedded Vidocq Arquillian container -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Official MP Config 3.1 TCK (TestNG-based). -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-tck</artifactId>
            <version>${microprofile.config.tck.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${tck.testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.config:microprofile-config-tck</dependency>
                    </dependenciesToScan>
                    <includes>
                        <include>**/*Test.class</include>
                        <include>**/*Tests.class</include>
                        <include>**/*IT.class</include>
                    </includes>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <arquillian.launch>vidocq</arquillian.launch>
                        <!-- DefaultConfigSourceOrdinalTest.checkSetup -->
                        <config_ordinal>120</config_ordinal>
                        <customer.hobby>Tennis</customer.hobby>
                        <!-- ConfigProviderTest.testPropertyConfigSource -->
                        <mp.tck.prop.dummy>dummy</mp.tck.prop.dummy>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <!-- DefaultConfigSourceOrdinalTest.checkSetup: env config_ordinal
                             must be 45 to verify the env ConfigSource ordinal override. -->
                        <config_ordinal>45</config_ordinal>
                        <customer_name>Bob</customer_name>
                        <!-- ConfigProviderTest.testEnvironmentConfigSource -->
                        <MP_TCK_ENV_DUMMY>dummy</MP_TCK_ENV_DUMMY>
                        <!-- CDIPropertyNameMatchingTest.checkSetup (spec 7.6) -->
                        <my_int_property>45</my_int_property>
                        <MY_BOOLEAN_PROPERTY>true</MY_BOOLEAN_PROPERTY>
                        <my_string_property>haha</my_string_property>
                        <MY_STRING_PROPERTY>woohoo</MY_STRING_PROPERTY>
                    </environmentVariables>
                </configuration>
                <dependencies>
                    <!-- The MP Config TCK is TestNG-driven; force the TestNG surefire provider. -->
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.5.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
