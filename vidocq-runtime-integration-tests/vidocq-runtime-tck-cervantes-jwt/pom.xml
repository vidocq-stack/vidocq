<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-cervantes-jwt</artifactId>
    <name>Vidocq :: TCK :: MicroProfile JWT 2.2 (Cervantes)</name>
    <description>
        Runs the official MicroProfile JWT 2.2 TCK (org.eclipse.microprofile.jwt:microprofile-jwt-auth-tck)
        against the assembled Vidocq runtime: vidocq-runtime-core boots via VidocqBootstrap, discovers
        vidocq-runtime-cervantes-jwt-extension (which pulls Cassini/Chappe for the HTTP endpoints and
        Ravel for MP Config) through the ServiceLoader SPI, and the shared vidocq-runtime-arquillian
        embedded container deploys each TCK archive — the same path a real application uses. Deployment
        keys (publicKey.pem) and mp.jwt.* configuration reach the runtime through the deployment class
        loader and the republished microprofile-config.properties.

        The only local harness is JwtTckArchiveProcessor: the TCK generates deployment configs with
        self-referential URLs hardcoded to http://localhost:8080/ (JWKS endpoints, key locations),
        rewritten to the pinned container port before deployment — vendor-side plumbing the TCK expects.

        Scope: the ee-security-optional group is excluded (Jakarta EE full-profile integration out of
        the MicroProfile runtime scope) — same documented subset as cervantes' own cervantes-tck. The
        ejb/jacc/servlet packages no longer exist in the 2.2 tests jar.
    </description>

    <properties>
        <!-- MicroProfile 7.2 pins JWT 2.2 -->
        <microprofile.jwt.tck.version>2.2</microprofile.jwt.tck.version>
        <!-- Arquillian 1.10.1 avoids MalformedParameterizedTypeException under JDK 25. -->
        <arquillian.tck.version>1.10.1.Final</arquillian.tck.version>
        <jose4j.version>0.9.4</jose4j.version>
        <jersey.version>4.0.2</jersey.version>
        <tck.testng.version>7.10.2</tck.testng.version>
    </properties>

    <!--
        No module-info.java (unnamed module): the TCK archive classes carry no JPMS
        descriptor and must stay readable by Vauban/Cervantes — same approach as the
        other vidocq-runtime-tck-* modules.
    -->

    <dependencyManagement>
        <dependencies>
            <!--
                Import arquillian-bom 1.10.1 for THIS module only. It overrides the
                root pom's inherited arquillian-bom (1.8.0), whose EventTestRunnerAdaptor
                throws MalformedParameterizedTypeException under JDK 25.
            -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.tck.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Vidocq runtime under test -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <!--
            Cervantes = MicroProfile JWT 2.2 implementation, wired into the runtime
            the same way an application would: the extension wrapper pulls
            cervantes-*, Cassini/Chappe (HTTP) and Ravel (MP Config) transitively;
            the CDI wiring self-registers at boot.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-cervantes-jwt-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Cassini = JAX-RS + the Chappe HTTP listener: the TCK deployments are
            REST endpoints protected by JWT. The cervantes wrapper does not pull
            the server extension itself (an application composes it), so the
            runner declares it exactly like an application would.
        -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MicroProfile JWT API — types the TCK references directly. -->
        <dependency>
            <groupId>org.eclipse.microprofile.jwt</groupId>
            <artifactId>microprofile-jwt-auth-api</artifactId>
            <version>${microprofile.jwt.tck.version}</version>
        </dependency>

        <!-- Test harness: shared embedded Vidocq Arquillian container -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Official MicroProfile JWT TCK: base jar + the tests classifier holding the @Test classes. -->
        <dependency>
            <groupId>org.eclipse.microprofile.jwt</groupId>
            <artifactId>microprofile-jwt-auth-tck</artifactId>
            <version>${microprofile.jwt.tck.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.jwt</groupId>
            <artifactId>microprofile-jwt-auth-tck</artifactId>
            <version>${microprofile.jwt.tck.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>

        <!-- The MP JWT TCK uses TestNG + the Arquillian TestNG container. -->
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${tck.testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Client-side TCK utilities: token generation and the JAX-RS client. -->
        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>${jose4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-client</artifactId>
            <version>${jersey.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>${jersey.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- One codegen bundle per declared extension (checkpom contract). -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!--
                        The TCK @Test classes live in the tests classifier of
                        microprofile-jwt-auth-tck. Scan it; the TestNG provider is
                        selected because TestNG is on the test classpath.
                    -->
                    <dependenciesToScan>
                        <dependency>org.eclipse.microprofile.jwt:microprofile-jwt-auth-tck</dependency>
                    </dependenciesToScan>
                    <includes>
                        <include>**/*Test.class</include>
                        <include>**/*Tests.class</include>
                    </includes>
                    <excludedGroups>ee-security-optional</excludedGroups>
                    <systemPropertyVariables>
                        <!--
                            Base URL some TCK tests use to build self-referential key
                            URLs client-side (default http://localhost:8080/) — must
                            match the pinned container port in arquillian.xml.
                        -->
                        <mp.jwt.tck.jwks.baseURL>http://127.0.0.1:18086/</mp.jwt.tck.jwks.baseURL>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
