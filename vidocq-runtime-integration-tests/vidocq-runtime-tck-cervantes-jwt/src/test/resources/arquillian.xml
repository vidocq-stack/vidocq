<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration Arquillian pour la suite TCK MicroProfile JWT 2.1.
    Le qualifier "cervantes-jwt" est sélectionné par la propriété système
    arquillian.launch=cervantes-jwt (voir cervantes-tck/pom.xml profil tck-official).
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="cervantes-jwt" default="true">
        <configuration>
            <property name="host">127.0.0.1</property>
        </configuration>
    </container>
</arquillian>
