<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-build</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <artifactId>vidocq-runtime-junit</artifactId>
    <name>Vidocq :: Runtime :: JUnit</name>
    <description>@VidocqTest: a JUnit Jupiter extension that starts the application under test in its own JVM, on the
        module path of the tests, and gives its URL (Vidocq/vidocq#350). An application declares it in test scope.</description>

    <dependencies>
        <!-- Provided: the application declares junit-jupiter for its tests, at the version vidocq-runtime-parent's
             JUnit BOM gives; this jar must not bring a second one. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- VidocqTestExtensionTest runs @VidocqTest classes through the JUnit Platform. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No Vidocq beans here: turn off the inherited Vauban indexer APT. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
            <!-- In an application this test-scope jar stays on the class path, next to JUnit: so do its tests. On
                 the module path, the module's requires would split JUnit from Surefire's launcher. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
