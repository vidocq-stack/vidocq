<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-core-extensions</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-knock-health-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Health (Knock)</name>
    <description>Wrapper Maven/JPMS qui active Knock (MicroProfile Health 4.0) dans un déploiement vidocq.
        Aucune classe Java propre — l'intégration repose sur la BCE de knock-cdi-vauban (découverte
        @Liveness/@Readiness/@Startup) et le scanning JAX-RS de CassiniExtension qui mount
        automatiquement KnockHealthResource (@Path("/health")). Voir docs/adr/ADR-002 dans le repo knock.</description>

    <!--
        ADR-002 (repo knock) : ce module est volontairement un *wrapper*, pas une
        VidocqExtension. Knock est zero-config et son intégration passe à 100 % par
        des SPI standards (CDI 4.1 BCE + JAX-RS @Path scanning). Toute logique
        spécifique vidocq doit aller dans un module séparé pour préserver la
        portabilité de Knock hors écosystème vidocq.
    -->

    <dependencies>
        <!--
            Knock — implémentation MicroProfile Health 4.0 (zéro lib tierce).
            knock-cassini tire transitivement knock-core et knock-api.
            knock-cdi-vauban contient la BCE qui auto-découvre @Liveness/@Readiness/@Startup.
        -->
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-jaxrs</artifactId>
            <version>${knock.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-cdi-vauban</artifactId>
            <version>${knock.version}</version>
        </dependency>

        <!--
            champollion-jsonp : implémentation runtime de jakarta.json (JSON-P)
            utilisée par knock-core pour sérialiser HealthCheckResponse.
        -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            L'extension REST Cassini est requise pour que KnockHealthResource
            (@Path("/health")) soit montée sur le moteur HTTP — c'est elle qui
            interroge VaubanBeanProvider.getResourceClasses() au démarrage.
        -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api est tiré transitivement par knock-cassini -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Both release and snapshot profiles (declared in vidocq-parent) call
            maven-javadoc-plugin:jar. This module has no src/main/java — only
            src/main/module-info/module-info.java. Override the sourcepath in both
            profiles so javadoc processes the module declaration and produces a
            non-empty javadoc jar (required by Maven Central validation).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>snapshot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/module-info</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                Workaround JPMS identique à knock-core / knock-parent (ADR-001 du repo knock).

                microprofile-health-api:4.0.1 n'a pas d'Automatic-Module-Name. Pour que le
                module-info de ce wrapper puisse `requires transitive io.vidocq.knock.api`
                (qui lui-même `requires transitive microprofile.health.api`), javac doit
                résoudre `microprofile.health.api` par dérivation du nom de fichier. On
                copie donc toutes les deps compile dans target/javamodules/ et on passe
                explicitement le module-path à javac via un compilerArg.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                            <type>pom</type>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

