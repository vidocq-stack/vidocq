<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-core-extensions</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-cervantes-jwt-extension</artifactId>
    <name>Vidocq :: Core Extensions :: JWT (Cervantes)</name>
    <description>Wrapper Maven/JPMS qui active Cervantes (MicroProfile JWT 2.1) dans un deploiement vidocq.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-cdi-vauban</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-jaxrs</artifactId>
        </dependency>

        <!-- Repackaged MicroProfile JWT 2.1 spec (module org.eclipse.microprofile.jwt). -->
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-mp-jwt-api</artifactId>
        </dependency>

        <!-- MP JWT 2.1 §6.1 mandates that the runtime exposes configuration via
             MicroProfile Config (mp.jwt.verify.publickey, mp.jwt.verify.issuer,
             mp.jwt.token.header, etc.). Cervantes-core reads them via
             @ConfigProperty, so we must opt-in to vidocq-runtime-ravel-extension
             which brings ravel-cdi-vauban (the BCE that wires @ConfigProperty)
             and routes the runtime config through Ravel. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-ravel-extension</artifactId>
        </dependency>

        <!-- Needed to compile cervantes-jaxrs's module-info requires (jakarta.ws.rs). -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-test-deps-to-module-path</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Le pattern `src/main/module-info` separe maintient `target/classes`
                sans `module-info.class` pendant `test-compile`, ce qui evite que
                maven-compiler-plugin 4.x ne bascule en mode patch-module et n'exige
                la resolution JPMS de specs sans Automatic-Module-Name. On supprime
                l'artefact `module-info.class` avant chaque `test-compile`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/module-info.class" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
