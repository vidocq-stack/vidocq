<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mpserver</groupId>
        <artifactId>vidocq-mps-parent</artifactId>
    </parent>

    <artifactId>vidocq-mps-core-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Core Extensions</name>
    <description>MicroProfile 7.1 core extensions for Vidocq</description>

    <modules>
        <module>vidocq-mps-chappe-extension</module>
        <module>vidocq-mps-rest-cassini-extension</module>
        <module>vidocq-mps-mansart-pool-extension</module>
        <module>vidocq-mps-mansart-data-extension</module>
        <module>vidocq-mps-mansart-transactions-extension</module>
    </modules>

    <!--
        vidocq-rest-extension (Jersey 4 + Jetty 12) est décommissionné,
        remplacé par vidocq-rest-cassini-extension (runtime JAX-RS 4.0 natif
        sur Chappe).

        L'implémentation Servlet 6.1 a été extraite en avril 2026 vers le
        projet standalone Foy : https://forge.vidocq.dev/vidocq/foy
        (groupId io.vidocq.foy ; modules foy-api, foy-core, foy-cdi-vauban,
        foy-chappe, foy-tck).

        Le module TCK runner Cassini est volontairement EN DEHORS du reactor
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0). Lancement :
          ./run-official-tck-restful-4.0.sh
    -->
</project>
