<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mpserver</groupId>
        <artifactId>vidocq-mps-parent</artifactId>
    </parent>

    <artifactId>vidocq-mps-core-extensions</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Core Extensions</name>
    <description>MicroProfile 7.1 core extensions for Vidocq</description>

    <modules>
        <module>vidocq-mps-chappe-extension</module>
        <module>vidocq-mps-servlet-chappe-extension</module>
        <module>vidocq-mps-rest-cassini-extension</module>
    </modules>

    <!--
        vidocq-rest-extension (Jersey 4 + Jetty 12) est décommissionné,
        remplacé par vidocq-rest-cassini-extension (runtime JAX-RS 4.0 natif
        sur Chappe).

        Deux modules TCK runners sont volontairement EN DEHORS du reactor
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0) :
        - vidocq-servlet-chappe-tck-runner   (Servlet 6.1 TCK, ~99 %)
        - vidocq-rest-cassini-tck-runner     (REST 4.0 TCK, scaffolding)

        Lancement via les scripts dédiés à la racine du projet :
          ./run-official-tck-servlet6.1.sh
          ./run-official-tck-restful-4.0.sh
    -->

    <!--
        vidocq-servlet-chappe-tck-runner est volontairement EN DEHORS du reactor :
        ShrinkWrap Maven Resolver 3.3 (dép. transitive du TCK officiel Jakarta)
        s'appuie sur maven-resolver 1.9 / maven-model 3.9 qui ne savent pas parser
        le Model 4.1.0 des POMs du reactor Vidocq (version implicite via parent).
        Son ClasspathWorkspaceReader crash avec "Bad artifact coordinates ... jar:".

        Profil tck-official activé via :
          ./run-official-tck-servlet6.1.sh                       : smoke test
          ./run-official-tck-servlet6.1.sh all                   : suite complète (option double-tiret all)
          ./run-official-tck-servlet6.1.sh -Dtest=ServletTests   : classe ciblée

        Le module compile et teste indépendamment, ses artefacts restent
        disponibles en SNAPSHOT local après un mvn install du reactor.
    -->
</project>
