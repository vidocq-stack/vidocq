<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mpserver</groupId>
        <artifactId>vidocq-mps-core-extensions</artifactId>
    </parent>

    <artifactId>vidocq-mps-rest-cassini-extension</artifactId>
    <name>Vidocq :: Core Extensions :: REST (Cassini)</name>
    <description>Extension Vidocq-MPS qui branche Cassini (Jakarta REST 4.0 standalone) sur le moteur HTTP Chappe via le SPI io.vidocq.cassini.spi.http</description>

    <dependencies>
        <!-- Cassini standalone — extrait avril 2026 vers io.vidocq.cassini.
             Le bootstrap passe par cassini-api (CassiniStack.builder), cassini-chappe
             (ChappeHttpAdapter) et cassini-cdi-vauban (BeanProvider).
             cassini-core est runtime-only : il fournit le BuilderFactory découvert
             par ServiceLoader, mais ses paquets internal/ ne sont exportés qu'au TCK. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
        </dependency>

        <!-- Vidocq-MPS SPI + Chappe extension -->
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-mps-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-mps-chappe-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
