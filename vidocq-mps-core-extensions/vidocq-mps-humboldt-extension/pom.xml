<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mpserver</groupId>
        <artifactId>vidocq-mps-core-extensions</artifactId>
    </parent>

    <artifactId>vidocq-mps-humboldt-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Telemetry (Humboldt)</name>
    <description>Extension Vidocq-MPS qui branche Humboldt (MicroProfile Telemetry 2.1 — tracing, metrics, logs) sur le cycle de vie Vidocq. Auto-config via env vars OTEL_*, install GlobalOpenTelemetry, shutdown propre.</description>

    <dependencies>
        <!-- Humboldt — implémentation MicroProfile Telemetry 2.1 standalone -->
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-cdi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-rest</artifactId>
        </dependency>

        <!-- Vidocq-MPS SPI + Vauban container -->
        <dependency>
            <groupId>io.vidocq.mpserver</groupId>
            <artifactId>vidocq-mps-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
    </dependencies>
</project>
