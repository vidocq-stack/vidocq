<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-build</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>vidocq-runtime-examples</artifactId>
    <packaging>pom</packaging>
    <name>Vidocq :: Examples</name>
    <description>Example applications for Vidocq</description>

    <properties>
        <!-- Example aggregator: never deployed to Maven Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <!-- SonarQube: no coverage gate on the examples, as vidocq-runtime/pom.xml intends with
             **/vidocq-runtime-examples/**. That pattern never matches an example's own files: the scanner reads it
             in each example module, against paths relative to the module (src/main/java/...). An example's tests
             mostly start it in another JVM (@VidocqTest), which JaCoCo does not measure. Issues are still reported. -->
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
    </properties>

    <modules>
        <module>vidocq-runtime-external-rest-lib</module>
        <module>vidocq-runtime-cassini-rest-example</module>
        <module>vidocq-runtime-cyrano-rest-client-example</module>
        <module>vidocq-runtime-cervantes-jwt-example</module>
        <module>vidocq-runtime-knock-health-example</module>
        <module>vidocq-runtime-mansart-h2-example</module>
        <module>vidocq-runtime-petstore-example</module>
        <module>vidocq-runtime-noether-persistence-example</module>
        <module>vidocq-runtime-foy-servlet-example</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
            <!-- This pom is installed and deploys its SNAPSHOT, and only this pom (not inherited): it is the parent
                 vidocq-runtime-external-rest-lib names, and Maven refuses a dependency whose parent it cannot read.
                 Without it the library is found, in the local repository or on maven.vidocq.dev, and still rejected
                 by a build that does not hold this pom: an example started from its own folder, a pull request build
                 that rebuilds vidocq-runtime-cassini-rest-example without the library (BUG-20261121-03). The two
                 properties above stay true: the example applications are neither installed nor deployed, and
                 release.sh leaves this pom out of a release. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <inherited>false</inherited>
                <configuration><skip>false</skip></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <inherited>false</inherited>
                <configuration><skip>false</skip></configuration>
            </plugin>
            <!-- Inherits the checkpom execution from vidocq-runtime-build/pluginManagement. test-path, bound as
                 vidocq-runtime-parent binds it: @VidocqTest starts the example on the jars a real application runs,
                 the copies vidocq:generate enriched included, not the originals Surefire resolved. -->
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>vidocq-test-path</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>test-path</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- No default value in <properties>: the expression must stay unresolved until vidocq:test-path sets
                 it, as in vidocq-runtime-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <vidocq.test.runtimePath>${vidocq.test.runtimePath}</vidocq.test.runtimePath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
