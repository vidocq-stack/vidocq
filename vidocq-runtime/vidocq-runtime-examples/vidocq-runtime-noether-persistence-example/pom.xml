<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-examples</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-noether-persistence-example</artifactId>
    <name>Vidocq :: Examples :: Noether Persistence + H2</name>
    <description>A reading notebook: Vidocq + Cassini REST + Jakarta Persistence 3.2 on Noether, over the default
        Mansart pool on H2 in memory.</description>

    <!--
        Vidocq main module, read by every Vidocq goal that launches the application (vidocq:dev, vidocq:jlink,
        vidocq:jpackage, vidocq:docker). No main class: the runtime's own main boots this module.

            ./mvnw vidocq:dev
    -->
    <properties>
        <vidocq.mainModule>io.vidocq.runtime.examples.noether</vidocq.mainModule>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>

        <!-- HTTP transport + Jakarta REST -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- Jakarta Persistence 3.2 on Noether, and what the extension's descriptor requires: the Mansart pool the
             unit takes and the transactions its @Transactional methods run in. `vidocq extension add
             noether-persistence` adds the three. The extension brings Noether's H2 and PostgreSQL dialects. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-pool-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-mansart-transactions-extension</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JDBC driver, at runtime only: the modular repackage of H2 (named module com.h2database), which jlink and
             jpackage accept, where the upstream jar is an automatic module. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.module.repackaged</groupId>
            <artifactId>vidocq-runtime-h2-module-repackaged</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- One -codegen bundle per extension that has one. Noether's carries its annotation processor,
                         which writes the entity accessors (_NoetherJpaAccess): Noether calls them instead of
                         reflecting, so the entity package needs no `opens`. vidocq-runtime-core-codegen (Vauban
                         indexer) comes from the parent; combine.children="append" keeps it. -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-noether-persistence-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-mansart-transactions-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Native packaging (jlink + jpackage + docker), on demand: `-Pdist`, or
             vidocq-runtime-examples/build-images.sh for every example. -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.vidocq.runtime</groupId>
                        <artifactId>vidocq-runtime-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <launcher>reading-notebook</launcher>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage</id>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <appName>reading-notebook</appName>
                                    <!-- macOS app-image rejects 0.x.y: pinned to 1.0.0. -->
                                    <appVersion>1.0.0</appVersion>
                                    <type>app-image</type>
                                </configuration>
                            </execution>
                            <execution>
                                <id>docker</id>
                                <goals>
                                    <goal>docker</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
