<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-examples</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>vidocq-runtime-external-rest-lib</artifactId>
    <name>Vidocq :: Examples :: External REST Library</name>
    <description>
        Simulates a third-party JAR with JAX-RS resources and CDI beans.
        No VaubanProcessor APT, no Maven plugin — plain Java compilation.
        The consuming application must handle bean discovery and proxy generation.
    </description>

    <!--
        Deliberately NO VaubanProcessor APT and no vidocq-runtime-maven-plugin.
        This module simulates an external dependency that was not pre-processed.
        No META-INF/vauban-beans.list, no vauban-bce-processed.
    -->

    <dependencies>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A SNAPSHOT, never a release: vidocq-runtime-cassini-rest-example depends on it, and a pull request
                 build that rebuilds it and not this module resolves it from maven.vidocq.dev. maven.deploy.skip stays
                 true (inherited), so release.sh leaves it out of a release. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration><skip>false</skip></configuration>
            </plugin>
            <!-- Installed too, against the examples' maven.install.skip=true: an example started from its own folder
                 (mvn vidocq:dev in vidocq-runtime-cassini-rest-example, an IDE launch on its pom) reads this library
                 from the local repository (BUG-20261121-03). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration><skip>false</skip></configuration>
            </plugin>
            <!-- Disable annotation processing explicitly -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
