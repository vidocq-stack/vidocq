<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
        <artifactId>vidocq-runtime-extensions-microprofile</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-cyrano-rest-client-extension</artifactId>
    <name>Vidocq :: Core Extensions :: Rest Client (Cyrano)</name>
    <description>Maven/Java Modules wrapper that activates Cyrano (MicroProfile Rest Client 4.0) in a vidocq deployment.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-cdi-vauban</artifactId>
        </dependency>

        <!--
            The MP Rest Client spec types come from cyrano's Java module repackage
            (cyrano-mp-rest-client-api, transitive through cyrano-core) — the
            sole modular source of the spec (workspace jlink-ready rule). The
            plain spec jar must NOT be declared here: both jars carry the same
            packages, a split package that stayed latent until an automatic module
            (org.reactivestreams, cyrano SSE) joined the module path and
            started reading every observable module.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- Cyrano leaves Jakarta REST to the runtime (`provided`, vidocq-workspace#17): the
             extension assembles the runtime, so it brings the API, even in an application with no
             REST endpoint. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Cyrano reads and writes bodies through the JSON-B and JSON-P APIs only. The extension
             picks the implementation: Champollion, as the Health extension does for JSON-P. Without
             it, an application with the Rest Client and no REST server has no JSON-B provider. -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <version>${champollion.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Every MicroProfile extension requires the Config extension (Vidocq/vidocq#829): without Ravel there is no
             MicroProfile Config implementation, and this extension's keys would be ignored without a word. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
            <artifactId>vidocq-runtime-ravel-config-extension</artifactId>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- One codegen bundle per declared extension (checkpom contract). -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.microprofile</groupId>
                            <artifactId>vidocq-runtime-ravel-config-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

