<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-vaadin-extension-dev</artifactId>
    <name>Vidocq :: Web Extensions :: Vaadin :: dev refresh</name>
    <description>Refreshes the open Vaadin pages that show a view vidocq:dev redefined in place. Only vidocq:dev adds
        it; no binary contains it (Vidocq/vidocq#143).</description>

    <properties>
        <!-- The Vaadin extension's version of flow-server. -->
        <vaadin.flow.version>25.3.4</vaadin.flow.version>
        <module.stubs>${project.basedir}/../vidocq-runtime-vaadin-extension/src/module-stubs</module.stubs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
        </dependency>
        <!-- Provided: the application brings Vaadin and the servlet API, as for the Vaadin extension. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>flow-server</artifactId>
            <version>${vaadin.flow.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The interface of the components foy-processor generates; Foy brings it at run time. -->
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- As the Vaadin extension: javadoc reads module-info.java with the stand-in of com.vaadin.flow.server. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <release combine.self="override"/>
                        <source>${maven.compiler.release}</source>
                        <additionalOptions combine.children="append">
                            <additionalOption>--upgrade-module-path '${project.build.directory}/module-stubs'</additionalOption>
                        </additionalOptions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Foy creates the event stream's servlet and its initializer through the components
                         foy-processor generates, not by reflection (a warning at every start otherwise). -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.foy</groupId>
                            <artifactId>foy-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- module-info.java requires flow-server under both of its names, static, as the Vaadin
                         extension does: the extension's empty stand-in, never packaged, is com.vaadin.flow.server. -->
                    <execution>
                        <id>module-stubs</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${module.stubs}/com.vaadin.flow.server</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/module-stubs/com.vaadin.flow.server</outputDirectory>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--upgrade-module-path</arg>
                                <arg>${project.build.directory}/module-stubs</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--upgrade-module-path</arg>
                                <arg>${project.build.directory}/module-stubs</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Vidocq/vidocq#143: a dev tool; vidocq:dev adds it, no binary ever contains it. -->
                            <Vidocq-Dev-Only>true</Vidocq-Dev-Only>
                            <!-- It reads Vaadin, which rides in the application layer: vidocq:dev puts it there
                                 too (hot swap design §5). -->
                            <Vidocq-Application-Layer>true</Vidocq-Application-Layer>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- Tests on the class path, as in the other -dev modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
