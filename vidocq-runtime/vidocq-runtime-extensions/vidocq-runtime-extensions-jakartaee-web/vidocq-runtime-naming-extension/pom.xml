<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-naming-extension</artifactId>
    <name>Vidocq :: Web Extensions :: Naming</name>
    <description>Vidocq Runtime extension that serves the JNDI java: namespace from the running CDI container,
        through Vauban Naming: java:comp/env/jdbc/orders is the @Named("orders") DataSource bean</description>

    <dependencies>
        <!-- The factory, its contexts and the CDI beans that resolve the names. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-naming</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-spi</artifactId>
        </dependency>
        <!--
            Optional (`requires static`): a pool answers its JNDI name through Mansart's JtaDataSource when the
            application has transactions (Vidocq/vidocq#676). The transactions extension brings both; an application
            without it has neither, and the names answer the pools themselves.
        -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-jdbc</artifactId>
            <version>${mansart.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>
        <!--
            PoolNamesContainerTest: the names of the pools in a running container (vauban-core, which the runtime
            SPI brings), with and without the transaction beans of Mansart.
        -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-cdi</artifactId>
            <version>${mansart.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        PoolNamesContainerTest starts a container with the transaction beans of Mansart, which this
                        module only reads when an application has them (`requires static`): the test adds the module
                        and reads it. @{argLine} keeps the JaCoCo agent of the quality profile (vidocq-parent).
                    -->
                    <argLine>@{argLine} --add-modules io.vidocq.mansart.transactions.cdi --add-reads io.vidocq.runtime.extensions.jakartaee.web.naming=io.vidocq.mansart.transactions.cdi</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
