<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
        <artifactId>vidocq-runtime-extensions-jakartaee-web</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>vidocq-runtime-noether-persistence-extension-dev</artifactId>
    <name>Vidocq :: Core Extensions :: Noether Persistence :: dev console panel</name>
    <description>The Noether Persistence panel of the dev console: one tab per persistence unit's model, JPQL, rows,
        indexes and DDL. Only vidocq:dev adds it; no binary contains it (Vidocq/vidocq#143).</description>
    <dependencies>
        <!-- Brings the Noether provider, whose io.vidocq.noether.jpa.core.spi describes a unit (noether#94). -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-noether-persistence-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-devconsole-spi</artifactId>
        </dependency>
        <!-- the Indexes tab's tests read the indexes of an H2 database through JDBC metadata -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Vidocq/vidocq#143: a dev tool; vidocq:dev adds it, no binary ever contains it. -->
                            <Vidocq-Dev-Only>true</Vidocq-Dev-Only>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
                module-info.java lives in the standard src/main/java, so it compiles normally. Surefire still
                must not fork on the module path: the reactor does not assemble a full module path for ad-hoc
                test forks. Same pattern as vidocq-runtime-mansart-pool-extension-dev.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
