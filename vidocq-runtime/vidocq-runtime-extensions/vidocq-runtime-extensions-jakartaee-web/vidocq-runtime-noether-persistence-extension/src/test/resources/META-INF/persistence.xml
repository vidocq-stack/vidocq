<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <!-- VidocqPersistenceUnitBootstrapTest: a JTA unit on the default pool, refused before any factory exists. -->
    <persistence-unit name="orders" transaction-type="JTA">
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
    <!-- VidocqPersistenceUnitBootstrapTest: a JTA unit on the default pool, whose schema generation opens a connection
         at start. -->
    <persistence-unit name="ledger" transaction-type="JTA">
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
