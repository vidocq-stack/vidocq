<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime.extensions.essentials</groupId>
        <artifactId>vidocq-runtime-extensions-essentials</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-langchain4j-cdi-mcp-extension-codegen</artifactId>
    <packaging>jar</packaging>
    <name>Vidocq :: Extensions :: Essentials :: langchain4j-cdi MCP server :: Codegen Bundle</name>
    <description>
        Companion codegen bundle for vidocq-runtime-langchain4j-cdi-mcp-extension.
        Declare this artifact in &lt;annotationProcessorPaths&gt; whenever the application depends on the MCP
        extension; Maven resolves the transitive APT dependencies below automatically.

        - vidocq-runtime-cassini-rest-extension-codegen: the MCP server is a Jakarta REST resource,
          McpEndpoint, of a langchain4j-cdi jar. vidocq:generate runs Cassini's processor over that jar and
          writes the adapter and the routes of the resource into the jar's enriched copy, so the application
          generates nothing when it starts (BUG-20261118-05, Vidocq/vidocq#662). The bundle also brings
          Champollion's processor for the types the resources exchange, as for any REST application.
    </description>

    <properties>
        <!--
            Same reason as vidocq-runtime-langchain4j-cdi-mcp-extension's own properties: not released while
            langchain4j-cdi is a SNAPSHOT (Vidocq/vidocq#94, decision 4). Remove all five with that module's.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <vidocq.checkpom.skip>true</vidocq.checkpom.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Only the empty module-info to compile: no processor, not even the
                         inherited core-codegen path. -->
                    <proc>none</proc>
                    <annotationProcessorPaths combine.self="override" />
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
