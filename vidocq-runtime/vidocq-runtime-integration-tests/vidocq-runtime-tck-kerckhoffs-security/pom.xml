<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-tck-kerckhoffs-security</artifactId>
    <name>Vidocq :: TCK :: Jakarta Security 4.0 (Kerckhoffs)</name>
    <description>
        Runs the official Jakarta Security 4.0 TCK against Kerckhoffs as the Vidocq runtime assembles it: each test
        WAR boots VidocqBootstrap, the Servlet extension serves it through Foy on the shared Chappe server under
        /&lt;war name&gt;, with CDI (Vauban), and the Security extension puts the application's authentication
        mechanism and identity stores in service. Kerckhoffs' own kerckhoffs-tck certifies the brick alone; this
        runner certifies the assembly. Gated behind the `tck` profile.

        The Security TCK is published as sources only: run-official-tck-security-4.0.sh builds it from the
        distribution (SHA-256 pinned) and runs its Arquillian tests with the class path this module resolves. This
        module holds that class path and the Arquillian configuration, no test of its own.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <sonar.skip>true</sonar.skip>
    </properties>

    <!-- No module-info.java (unnamed module): the TCK deployment classes carry no Java Modules descriptor, same
         approach as the other vidocq-runtime-tck-* modules. -->

    <dependencies>
        <!-- Vidocq runtime under test: Foy on Chappe with Vauban, and Kerckhoffs on top. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-foy-servlet-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-kerckhoffs-security-extension</artifactId>
        </dependency>
        <!-- app-jaxrs: the REST resources are served as a Servlet of Foy, so the Jakarta Security authentication
             and authorization apply to them (RestMode picks the servlet because both are there). -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-servlet</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!-- Test harness: the embedded Vidocq Arquillian container. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-arquillian</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- No source to process, but vidocq:checkpom asks for the extensions' bundles. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-foy-servlet-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
                            <artifactId>vidocq-runtime-kerckhoffs-security-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
