<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The root of the runtime's reactor, vidocq-runtime-build: its dependencyManagement and its Vauban indexer APT, as an example has. -->
    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-build</artifactId>
        <version>@project.version@</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.it</groupId>
    <artifactId>dependency-codegen-rest-app</artifactId>
    <!-- No version of its own: the parent's dependencyManagement pins the runtime's modules to ${project.version}. -->

    <properties>
        <vidocq.mainModule>acme.restapp</vidocq.mainModule>
        <vidocq.mainClass>acme.restapp.RestDependencyCodegenApp</vidocq.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
        </dependency>
        <!-- The library of ../lib, whose resource gets its Cassini adapter from vidocq:generate, or at each start. -->
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>dependency-codegen-restlib</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The REST codegen bundle, whose closure holds cassini-processor and its hints: vidocq:generate
                         runs the processor over the library's classes. The discrimination IT deletes this block. -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
                            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
                            <version>@project.version@</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
