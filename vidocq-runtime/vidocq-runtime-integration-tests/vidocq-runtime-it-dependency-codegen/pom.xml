<?xml version="1.0" encoding="UTF-8"?>
<!--
    Vidocq/vidocq#246: a @WebListener shipped in a plain dependency jar runs under vidocq:run with no workaround
    class, because vidocq:generate ran the Foy codegen bundle's processor over that jar. Vidocq/vidocq#662: a JAX-RS
    resource of a plain dependency jar gets its Cassini adapter at build, from the REST codegen bundle's closure
    (src/it/fixture-rest).

    The fixture resolves this build's artifacts from target/it-repo, which maven-invoker-plugin:install stages at
    pre-integration-test; anything else comes from the outer local repository through it-settings.xml, which
    Fixture writes from src/it/it-settings.xml with the outer repository's URL (resource filtering cannot
    read ${settings.localRepository}). Its .mvn/maven.config points the ITs' mvn at them. That settings file
    mirrors every repository to the outer local repository, so the fixture never reaches the network
    (Vidocq/vidocq#285): its POMs pin the plugins this build runs, and the staging resolves the rest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-integration-tests</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>vidocq-runtime-it-dependency-codegen</artifactId>
    <name>Vidocq Runtime :: IT :: Brick codegen on dependency jars</name>

    <properties>
        <it.repo>${project.build.directory}/it-repo</it.repo>
        <it.settings>${project.build.directory}/it-settings.xml</it.settings>
        <!-- maven-invoker-plugin reads invoker.skip only; -DskipTests skips the staging too. -->
        <invoker.skip>${skipTests}</invoker.skip>
        <!-- The Servlet and REST extensions below are staging dependencies for the fixtures, which declare their
             codegen bundles themselves; this module compiles no servlet nor REST code. -->
        <vidocq.checkpom.skip>true</vidocq.checkpom.skip>
        <!-- The API the REST fixture's library compiles against (provided there). -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>
    </properties>

    <dependencies>
        <!-- What the fixture uses from this build: invoker:install stages them, and every reactor module and
             parent POM they need, in target/it-repo. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-maven-plugin</artifactId>
            <version>${project.version}</version>
            <type>maven-plugin</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A jar, as the fixture's annotationProcessorPaths entry: a pom-typed dependency stages the pom only,
             and the fixture's compiler then misses the jar in a build that installs nothing. -->
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-foy-servlet-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-foy-servlet-extension-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.core</groupId>
            <artifactId>vidocq-runtime-cassini-rest-extension-codegen</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <!-- The fixture project, its pom.xml and .mvn/ filtered with @…@ only. -->
                    <execution>
                        <id>fixture</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/fixture</outputDirectory>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>src/it/fixture</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>*/pom.xml</include>
                                        <include>.mvn/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/it/fixture</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>pom.xml</exclude>
                                        <exclude>*/pom.xml</exclude>
                                        <exclude>.mvn/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- The REST fixture, filtered the same way. -->
                    <execution>
                        <id>fixture-rest</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/fixture-rest</outputDirectory>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>src/it/fixture-rest</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>*/pom.xml</include>
                                        <include>.mvn/**</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/it/fixture-rest</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>pom.xml</exclude>
                                        <exclude>*/pom.xml</exclude>
                                        <exclude>.mvn/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <localRepositoryPath>${it.repo}</localRepositoryPath>
                    <!-- The fixture's artifacts are test-scope dependencies here. -->
                    <scope>test</scope>
                    <!-- What the fixture needs beyond the plugins this module runs, as it never reaches Central
                         (src/it/it-settings.xml): maven-install-plugin, which this build runs only when it
                         installs, and git-commit-id-maven-plugin, whose version ranges (bcutil [1.81,1.82)) need
                         the maven-metadata-local.xml an installation writes: the outer repository only holds
                         maven-metadata-central.xml, which a file: repository does not read. -->
                    <extraArtifacts>
                        <extraArtifact>org.apache.maven.plugins:maven-install-plugin:${maven.install.plugin.version}:maven-plugin</extraArtifact>
                        <extraArtifact>io.github.git-commit-id:git-commit-id-maven-plugin:${git-commit-id.plugin.version}:maven-plugin</extraArtifact>
                    </extraArtifacts>
                </configuration>
                <executions>
                    <execution>
                        <id>stage</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <systemPropertyVariables>
                        <it.fixture>${project.build.directory}/fixture</it.fixture>
                        <it.fixture.rest>${project.build.directory}/fixture-rest</it.fixture.rest>
                        <it.logs>${project.build.directory}/it-logs</it.logs>
                        <!-- vidocq.generate.cacheDir of the fixture's builds: never the user's cache. -->
                        <it.caches>${project.build.directory}/it-caches</it.caches>
                        <it.settings>${it.settings}</it.settings>
                        <it.settings.template>${project.basedir}/src/it/it-settings.xml</it.settings.template>
                        <it.outerRepository>${settings.localRepository}</it.outerRepository>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
